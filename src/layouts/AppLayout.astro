---
import Layout from './Layout.astro';
import AppSidebar from '../components/app/AppSidebar.astro';
import AppHeader from '../components/app/AppHeader.astro';
import type { NavItem } from '../lib/navigation';

import '../styles/app/app-shell.css';
import '../styles/app/sidebar-redesign.css';
import '../styles/app/responsive.css';
import '../styles/app/glass-select.css';

interface Props {
  title?: string;
  pageTitle?: string;
  breadcrumb?: string;
  activeId?: string;
  navItems: NavItem[];
  bottomItems: NavItem[];
  displayName?: string;
  roleLabel?: string;
  branchName?: string;
  showBranchSwitcher?: boolean;
}

const {
  title = 'VGSync | Dashboard',
  pageTitle = 'Dashboard',
  breadcrumb = 'Overview /',
  activeId = 'overview',
  navItems,
  bottomItems,
  displayName = 'User',
  roleLabel = 'Role',
  branchName = 'Branch',
  showBranchSwitcher = false,
} = Astro.props;
---

<Layout title={title}>
  <!-- Nobody signed in: go to the login page before anything of the page is drawn. -->
  <style is:inline>html:not([data-authed]) .app-shell { visibility: hidden; }</style>
  <script is:inline>
    (function () {
      var has = false;
      try {
        var raw = window.sessionStorage.getItem('vgsync-auth') || window.localStorage.getItem('vgsync-auth');
        if (raw) {
          // A sign-in whose refresh token has run out is as good as none.
          var payload = JSON.parse(raw).refresh.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
          has = JSON.parse(window.atob(payload)).exp * 1000 > Date.now();
          if (!has) {
            window.sessionStorage.removeItem('vgsync-auth');
            window.localStorage.removeItem('vgsync-auth');
          }
        }
      } catch (e) {}
      if (has) document.documentElement.setAttribute('data-authed', '');
      else window.location.replace('/');
    })();
  </script>
  <div class="app-shell" id="app-shell">
    <AppSidebar
      items={navItems}
      bottomItems={bottomItems}
      activeId={activeId}
      displayName={displayName}
      roleLabel={roleLabel}
      branchName={branchName}
    />

    <div class="app-main">
      <AppHeader
        pageTitle={pageTitle}
        breadcrumb={breadcrumb}
        branchName={branchName}
        showBranchSwitcher={showBranchSwitcher}
      />

      <main class="app-content" id="app-content">
        <div class="app-content-inner">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <script>
    import '../scripts/app-shell.ts';
    import '../scripts/glass-select.ts';
    import '../scripts/soft-nav.ts';
  </script>
</Layout>
