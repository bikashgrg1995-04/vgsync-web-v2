---
import Layout from './Layout.astro';
import AppSidebar from '../components/app/AppSidebar.astro';
import AppHeader from '../components/app/AppHeader.astro';
import type { NavItem } from '../lib/navigation';

import '../styles/app/app-shell.css';
import '../styles/app/sidebar-redesign.css';
import '../styles/app/responsive.css';
import '../styles/app/glass-select.css';
import '../styles/app/branch-dropdown.css';
import '../styles/app/boot-loader.css';

interface Props {
  title?: string;
  pageTitle?: string;
  breadcrumb?: string;
  activeId?: string;
  navItems: NavItem[];
  bottomItems: NavItem[];
  displayName?: string;
  roleLabel?: string;
  branchName?: string;
  showBranchSwitcher?: boolean;
}

const {
  title = 'VGSync | Dashboard',
  pageTitle = 'Dashboard',
  breadcrumb = 'Overview /',
  activeId = 'overview',
  navItems,
  bottomItems,
  displayName = 'User',
  roleLabel = 'Role',
  branchName = 'Branch',
  showBranchSwitcher = false,
} = Astro.props;
---

<Layout title={title}>
  <!-- Nobody signed in: go to the login page before anything of the page is drawn. -->
  <style is:inline>html:not([data-authed]) .app-shell { visibility: hidden; }</style>
  <script is:inline>
    (function () {
      var has = false;
      try {
        var raw = window.sessionStorage.getItem('vgsync-auth') || window.localStorage.getItem('vgsync-auth');
        if (raw) {
          // A sign-in whose refresh token has run out is as good as none.
          var payload = JSON.parse(raw).refresh.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
          has = JSON.parse(window.atob(payload)).exp * 1000 > Date.now();
          if (!has) {
            window.sessionStorage.removeItem('vgsync-auth');
            window.localStorage.removeItem('vgsync-auth');
          }
        }
      } catch (e) {}
      if (has) document.documentElement.setAttribute('data-authed', '');
      else window.location.replace('/');
    })();
  </script>
  <!-- Loading popup after sign-in. The tiny script marks the page before it is painted
       so the popup is there from the first frame; boot-loader.ts then drives it. -->
  <script is:inline>
    try { if (sessionStorage.getItem('vg:welcome') === '1') document.documentElement.classList.add('vg-booting'); } catch (e) {}
  </script>
  <div class="boot-overlay" id="boot-overlay" role="status" aria-live="polite">
    <div class="boot-card">
      <div class="boot-spinner" aria-hidden="true"><span></span><span></span><span></span></div>
      <h2 class="boot-title">Setting things up</h2>
      <p class="boot-msg" id="boot-msg">Signing you in securely…</p>
      <div class="boot-track" aria-hidden="true"><i class="boot-fill" id="boot-fill"></i></div>
      <p class="boot-pct" id="boot-pct">0%</p>
    </div>
  </div>
  <div class="app-shell" id="app-shell">
    <AppSidebar
      items={navItems}
      bottomItems={bottomItems}
      activeId={activeId}
      displayName={displayName}
      roleLabel={roleLabel}
      branchName={branchName}
    />

    <div class="app-main">
      <AppHeader
        pageTitle={pageTitle}
        breadcrumb={breadcrumb}
        branchName={branchName}
        showBranchSwitcher={showBranchSwitcher}
      />

      <main class="app-content" id="app-content">
        <div class="app-content-inner">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <script>
    import '../scripts/app-shell.ts';
    import '../scripts/glass-select.ts';
    import '../scripts/soft-nav.ts';
  </script>
</Layout>
