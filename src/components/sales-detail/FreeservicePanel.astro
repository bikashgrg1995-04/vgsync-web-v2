<section class="invd-panel" data-panel="freeservice">
  <div class="inv-card">
    <div class="inv-card-head">
      <h3 class="inv-card-title">Free Servicing</h3>
      <span style="display:flex;gap:16px;flex-wrap:wrap">
        <button type="button" class="btn-link" id="sad-fs-count-btn" hidden>Change count / covers</button>
        <button type="button" class="btn-link" id="sad-fs-add-btn" hidden>+ Record service</button>
      </span>
    </div>
    <div class="invd-stats">
      <div class="invd-stat"><strong id="fs-total">—</strong><span>Included</span></div>
      <div class="invd-stat"><strong id="fs-used">—</strong><span>Done</span></div>
      <div class="invd-stat"><strong id="fs-left">—</strong><span>Remaining</span></div>
    </div>
    <p class="sad-emi-sum" id="fs-covers"></p>
    <p class="sad-emi-sum" id="fs-note" style="margin-top:10px"></p>
    <div class="inv-table-wrap">
      <table class="inv-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th class="num">Km</th>
            <th>Performance</th>
            <th>Work done</th>
            <th class="hide-sm">Technician</th>
            <th class="actions"></th>
          </tr>
        </thead>
        <tbody id="sad-fs"><tr><td colspan="7" class="inv-empty">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</section>
