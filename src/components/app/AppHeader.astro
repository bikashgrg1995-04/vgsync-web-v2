---
interface Props {
  pageTitle?: string;
  breadcrumb?: string;
  displayName?: string;
  roleLabel?: string;
  branchName?: string;
  showBranchSwitcher?: boolean;
}

const {
  pageTitle = 'Dashboard',
  breadcrumb = 'Overview /',
  displayName = 'User',
  roleLabel = 'Role',
  branchName = 'Branch',
  showBranchSwitcher = false,
} = Astro.props;
---

<header class="app-header" role="banner">
  <div class="header-left">
    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="18" x2="20" y2="18"/>
      </svg>
    </button>
    <div class="header-titles">
      <h1 class="header-title">{pageTitle}</h1>
      <p class="header-breadcrumb">{breadcrumb}</p>
    </div>
  </div>

  <div class="header-right">
    <div class="header-branch" id="header-branch">
      <span class="branch-label" id="branch-label">{branchName}</span>
      {showBranchSwitcher && (
        <select
          class="branch-select"
          id="branch-select"
          aria-label="Switch branch"
          title="Switch active branch"
        >
        </select>
      )}
    </div>

    <button type="button" class="header-icon-btn" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
    </button>

    <button type="button" class="header-icon-btn" aria-label="Notifications">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      </svg>
      <span class="header-badge" aria-hidden="true"></span>
    </button>

    {/* Profile + dropdown */}
    <div class="profile-wrap" id="profile-wrap">
      <button
        type="button"
        class="header-profile"
        id="header-profile"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="profile-menu"
      >
        <span class="profile-avatar" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </span>
        <span class="profile-meta">
          <span class="profile-name">{displayName}</span>
          <span class="profile-sub">{roleLabel} · {branchName}</span>
        </span>
        <svg class="profile-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <div class="profile-menu" id="profile-menu" role="menu" hidden>
        <div class="profile-menu-header">
          <span class="profile-menu-name" id="profile-menu-name">{displayName}</span>
          <span class="profile-menu-role" id="profile-menu-role">{roleLabel}</span>
          <span class="profile-menu-branch" id="profile-menu-branch">{branchName}</span>
        </div>

        <div class="profile-menu-divider" role="separator"></div>

        <a href="/dashboard/settings" class="profile-menu-item" role="menuitem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          </svg>
          Settings
        </a>

        <div class="profile-menu-section-label">Appearance</div>
        <div class="profile-theme-row" role="group" aria-label="Theme">
          <button type="button" class="profile-theme-btn" data-theme-value="light" role="menuitem">Light</button>
          <button type="button" class="profile-theme-btn" data-theme-value="dark" role="menuitem">Dark</button>
        </div>

        <div class="profile-menu-divider" role="separator"></div>

        <button type="button" class="profile-menu-item profile-menu-logout" id="profile-logout" role="menuitem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Logout
        </button>
      </div>
    </div>
  </div>
</header>
