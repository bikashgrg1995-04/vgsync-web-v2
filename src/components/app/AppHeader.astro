---
interface Props {
  pageTitle?: string;
  breadcrumb?: string;
  branchName?: string;
  showBranchSwitcher?: boolean;
}

const {
  pageTitle = 'Dashboard',
  breadcrumb = 'Overview /',
  branchName = 'Branch',
  showBranchSwitcher = false,
} = Astro.props;
---

<header class="app-header" role="banner">
  <div class="header-left">
    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="18" x2="20" y2="18"/>
      </svg>
    </button>
    <div class="header-titles">
      <h1 class="header-title">{pageTitle}</h1>
      <p class="header-breadcrumb">{breadcrumb}</p>
    </div>
  </div>

  <div class="header-center">
    <div class="header-search" role="search">
      <svg class="header-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        type="search"
        class="header-search-input"
        id="header-search"
        placeholder="Search…"
        autocomplete="off"
        aria-label="Search"
      />
    </div>
  </div>

  <div class="header-right">
    <div class="header-branch" id="header-branch">
      <span class="branch-prefix">Branch</span>
      <span class="branch-label" id="branch-label">{branchName}</span>
      {showBranchSwitcher && (
        <select
          class="branch-select"
          id="branch-select"
          aria-label="Switch branch"
          title="Switch active branch"
        >
        </select>
      )}
    </div>

    <button type="button" class="header-icon-btn" aria-label="Notifications">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
      </svg>
      <span class="header-badge" aria-hidden="true"></span>
    </button>

    {/* Theme next to notifications */}
    <div class="header-theme" id="header-theme-toggle" role="group" aria-label="Theme">
      <button type="button" class="theme-chip" data-theme-value="light" aria-label="Light mode">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.42 1.42"/><path d="m17.65 17.65 1.42 1.42"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.35 17.65-1.42 1.42"/><path d="m19.07 4.93-1.42 1.42"/>
        </svg>
      </button>
      <button type="button" class="theme-chip" data-theme-value="dark" aria-label="Dark mode">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.463.402.807a6.5 6.5 0 0 0 8.268 8.268c.344-.215.829-.003.803.397"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-dialog-title">
  <div class="logout-dialog-inner">
    <h2 class="logout-dialog-title" id="logout-dialog-title">Log out?</h2>
    <p class="logout-dialog-text">Are you sure you want to log out of VGSync?</p>
    <div class="logout-dialog-actions">
      <button type="button" class="logout-dialog-cancel" id="logout-cancel">Cancel</button>
      <button type="button" class="logout-dialog-confirm" id="logout-confirm">Logout</button>
    </div>
  </div>
</dialog>
