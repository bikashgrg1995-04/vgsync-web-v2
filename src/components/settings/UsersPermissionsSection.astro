<section class="se-panel" data-settings-panel="users">
  <div class="se-grid">
    <article class="se-card se-u-wide">
      <header class="se-card-head">
        <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm8 2c-2.7 0-8 1.3-8 4v2h16v-2c0-2.7-5.3-4-8-4zM8 13c-.3 0-.6 0-1 .1C5.4 13.4 2 14.5 2 17v2h5v-2c0-1.4.7-2.6 1.8-3.5A9 9 0 0 0 8 13z"></path></svg></span>
        <div><h3>Users &amp; Permissions</h3><p>Who can sign in, and what each position is allowed to do</p></div>
        <div class="se-u-actions">
          <a class="se-u-btn" href="/staff#positions">Manage positions</a>
          <a class="se-u-btn is-primary" href="/staff">Manage staff</a>
        </div>
      </header>
      <div class="se-u-kpis">
        <div><span id="u-active">—</span><small>Active staff</small></div>
        <div><span id="u-inactive">—</span><small>Inactive</small></div>
        <div><span id="u-positions">—</span><small>Positions</small></div>
        <div><span id="u-rules">—</span><small>Approval rules on</small></div>
      </div>
      <p class="se-error" id="u-error" hidden></p>
    </article>

    <article class="se-card se-u-wide">
      <header class="se-card-head">
        <div><h3>Positions</h3><p>A position is a set of allowed actions. Staff get their access from their position, and you can allow or deny single actions on a person.</p></div>
      </header>
      <div class="se-u-scroll">
        <table class="se-u-table">
          <thead><tr><th>Position</th><th class="num">People</th><th class="num">Allowed actions</th><th>Status</th></tr></thead>
          <tbody id="u-positions-body"><tr><td colspan="4" class="se-u-empty">Loading…</td></tr></tbody>
        </table>
      </div>
    </article>

    <article class="se-card">
      <header class="se-card-head">
        <div><h3>Only the owner can</h3><p>These can never be given to a position or a person.</p></div>
      </header>
      <ul class="se-u-list" id="u-reserved"><li class="se-u-empty">Loading…</li></ul>
    </article>

    <article class="se-card">
      <header class="se-card-head">
        <div><h3>Approval rules</h3><p>Amounts above the limit wait for an approver.</p></div>
        <div class="se-u-actions"><a class="se-u-btn" href="/approvals#rules">Edit rules</a></div>
      </header>
      <ul class="se-u-list" id="u-rules-list"><li class="se-u-empty">Loading…</li></ul>
    </article>

    <article class="se-card se-u-wide">
      <header class="se-card-head">
        <div><h3>Recent access changes</h3><p>Positions, per-person overrides and approval rules.</p></div>
      </header>
      <div class="se-u-scroll">
        <table class="se-u-table">
          <thead><tr><th>When</th><th>By</th><th>Change</th></tr></thead>
          <tbody id="u-audit-body"><tr><td colspan="3" class="se-u-empty">Loading…</td></tr></tbody>
        </table>
      </div>
    </article>
  </div>
</section>
