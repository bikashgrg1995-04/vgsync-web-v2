<div class="inv-card">
  <div class="inv-card-head">
    <h3 class="inv-card-title">Stock List</h3>

    <div class="inv-filters">
      <div class="inv-search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input type="search" id="inv-search" placeholder="Search stock…" autocomplete="off" />
      </div>

      <select id="inv-category" aria-label="Category">
        <option value="">All Categories</option>
      </select>

      <select id="inv-status" aria-label="Status">
        <option value="">All Status</option>
        <option value="in_stock">In Stock</option>
        <option value="low">Low Stock</option>
        <option value="out">Out of Stock</option>
      </select>
    </div>
  </div>

  <div class="inv-table-wrap">
    <table class="inv-table">
      <thead>
        <tr>
          <th>Stock ID</th>
          <th class="thumb-col"><span class="sr-only">Image</span></th>
          <th>Stock Name</th>
          <th class="num">Current Stock</th>
          <th class="num hide-sm">Selling Price</th>
          <th>Status</th>
          <th class="actions">Actions</th>
        </tr>
      </thead>
      <tbody id="inv-tbody">
        <tr>
          <td colspan="7" class="inv-empty">Loading…</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="inv-table-foot">
    <p class="inv-footnote" id="inv-count"></p>
    <nav class="inv-pages" id="inv-pages" aria-label="Stock list pages"></nav>
  </div>
</div>
