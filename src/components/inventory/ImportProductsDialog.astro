<dialog class="inv-dialog" id="inv-import-dialog">
  <form method="dialog" class="inv-dialog-inner" id="imp-form">
    <h2 class="inv-dialog-title" id="imp-title">Import products</h2>
    <p class="inv-dialog-sub" id="imp-help"></p>
    <p class="inv-dialog-sub"><button type="button" class="btn-ghost-sm" id="imp-template">Download template</button></p>

    <label class="inv-field">
      <span>Excel (.xlsx) or CSV file</span>
      <input type="file" id="imp-file" accept=".xlsx,.csv" required />
    </label>

    <div id="imp-result" class="inv-dialog-sub" hidden></div>
    <p class="inv-dialog-error" id="imp-error" hidden></p>

    <div class="inv-dialog-actions">
      <button type="button" class="btn-ghost-sm" id="imp-cancel">Close</button>
      <button type="button" class="btn-ghost-sm" id="imp-check">Check file</button>
      <button type="submit" class="btn-primary-sm" id="imp-apply" disabled>Save</button>
    </div>
  </form>
</dialog>
