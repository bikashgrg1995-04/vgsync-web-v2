---
import '../../styles/login/login-form.css';

interface Props {
    heading: string;
    subtitle?: string;
}

const { heading, subtitle } = Astro.props;
---

<section class="form-panel" aria-label={heading}>
    <div class="form-content">
        <header class="form-header">
            <div class="form-brand" aria-hidden="true">
                <span class="form-brand-mark">
                    <svg viewBox="0 0 48 20" fill="none" aria-hidden="true">
                        <path
                            d="M2 14C8 6 14 4 20 6C26 8 30 12 36 10C40 9 44 6 46 4"
                            stroke="url(#shell-logo-grad)"
                            stroke-width="3.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <defs>
                            <linearGradient id="shell-logo-grad" x1="2" y1="10" x2="46" y2="10">
                                <stop stop-color="#ff2d4a" />
                                <stop offset="1" stop-color="#c80d31" />
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
                <span class="form-brand-name">
                    <span class="form-brand-vg">VG</span>
                    <span class="form-brand-rest">Automobiles</span>
                </span>
            </div>

            <h2 class="form-heading">{heading}</h2>
            {subtitle && <p class="form-subtitle" id="auth-description">{subtitle}</p>}
        </header>

        <slot />

        <p class="auth-back">
            <a href="/">Back to sign in</a>
        </p>
    </div>
</section>

<style>
    .auth-back {
        margin: 18px 0 0;
        text-align: center;
        font-size: 12.5px;
    }
    .auth-back a {
        color: #ff526b;
        font-weight: 700;
        text-decoration: none;
    }
    .auth-back a:hover {
        text-decoration: underline;
    }
</style>
