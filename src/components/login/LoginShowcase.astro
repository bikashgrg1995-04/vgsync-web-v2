
---
import '../../styles/login/login-showcase.css';
---

<section class="showcase-panel">
    <div class="showcase-content">
        <!-- VG Automobiles Branding -->
        <a href="/" class="showcase-logo" aria-label="VG Automobiles Home">
            <span class="showcase-logo-mark">
                <svg
                    width="25"
                    height="25"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M4 7.5L9 17L13 9L16 14L20 7"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M4 7.5H8"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                    />
                </svg>
            </span>

            <span class="showcase-logo-name">
                VG
                <strong>AUTOMOBILES</strong>
            </span>
        </a>

        <!-- Introduction -->
        <div class="showcase-intro">
            <span class="showcase-eyebrow">
                <span class="showcase-status-dot"></span>
                DEALER MANAGEMENT SYSTEM
            </span>

            <h1 class="showcase-title">
                Your dealership.
                <span>One connected platform.</span>
            </h1>

            <p class="showcase-description">
                From inventory and sales to workshop operations and business
                insights, manage your entire automotive business through
                one connected workspace.
            </p>
        </div>

        <!-- Features -->
        <div class="feature-section">
            <div class="feature-section-heading">
                <span>YOUR BUSINESS. UNDER CONTROL.</span>
                <span class="feature-heading-line"></span>
            </div>

            <div class="feature-grid">
                <!-- Inventory -->
                <article class="feature-card">
                    <div class="feature-icon">
                        <svg
                            width="21"
                            height="21"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m12 3 9 5-9 5-9-5 9-5Z" />
                            <path d="m3 8 9 5 9-5" />
                            <path d="M3 8v9l9 5 9-5V8" />
                            <path d="M12 13v9" />
                        </svg>
                    </div>

                    <div>
                        <h3 class="feature-title">Inventory</h3>
                        <p class="feature-description">
                            Manage vehicles, spare parts and stock.
                        </p>
                    </div>
                </article>

                <!-- Sales and Purchase -->
                <article class="feature-card">
                    <div class="feature-icon">
                        <svg
                            width="21"
                            height="21"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 8H6" />
                            <circle cx="10" cy="21" r="1" />
                            <circle cx="18" cy="21" r="1" />
                        </svg>
                    </div>

                    <div>
                        <h3 class="feature-title">Sales & Purchase</h3>
                        <p class="feature-description">
                            Track vehicle sales and purchases.
                        </p>
                    </div>
                </article>

                <!-- Service and Workshop -->
                <article class="feature-card">
                    <div class="feature-icon">
                        <svg
                            width="21"
                            height="21"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M14.7 6.3a5 5 0 0 0-6.9 6.9L3 18l3 3 4.8-4.8a5 5 0 0 0 6.9-6.9L14 13l-3-3 3.7-3.7Z" />
                            <path d="m15 5 4-4 4 4-4 4" />
                        </svg>
                    </div>

                    <div>
                        <h3 class="feature-title">Service & Workshop</h3>
                        <p class="feature-description">
                            Keep service and maintenance organized.
                        </p>
                    </div>
                </article>

                <!-- Reports and Analytics -->
                <article class="feature-card">
                    <div class="feature-icon">
                        <svg
                            width="21"
                            height="21"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M3 3v18h18" />
                            <path d="m19 9-5 5-4-4-5 5" />
                        </svg>
                    </div>

                    <div>
                        <h3 class="feature-title">Reports & Analytics</h3>
                        <p class="feature-description">
                            Monitor performance and business insights.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="showcase-footer">
        <span>DRIVE. MANAGE. GROW.</span>
        <span>VG Automobiles · Dealer Management</span>
    </footer>
</section>
