---
import '../../styles/login/login-showcase.css';
---

<section class="showcase-panel" aria-label="VG Automobiles overview">
    <div class="showcase-content">

        <a href="/" class="showcase-logo" aria-label="VG Automobiles Home">
            <span class="showcase-logo-mark showcase-logo-swoosh">
                <svg viewBox="0 0 48 20" fill="none" aria-hidden="true">
                    <path
                        d="M2 14C8 6 14 4 20 6C26 8 30 12 36 10C40 9 44 6 46 4"
                        stroke="url(#showcase-logo-grad)"
                        stroke-width="3.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                    <defs>
                        <linearGradient id="showcase-logo-grad" x1="2" y1="10" x2="46" y2="10">
                            <stop stop-color="#ff2d4a" />
                            <stop offset="1" stop-color="#c80d31" />
                        </linearGradient>
                    </defs>
                </svg>
            </span>

            <span class="showcase-logo-name">
                <span class="showcase-logo-vg">VG</span>
                <span class="showcase-logo-rest">Automobiles</span>
            </span>
        </a>

        <div class="showcase-intro">
            <h1 class="showcase-title">
                Everything Your
                <br />
                <span>Automotive</span> Business Needs.
            </h1>

            <p class="showcase-description">
                Manage inventory, streamline operations,
                <br class="desktop-break" />
                and grow your business with VG Automobiles.
            </p>

            <div class="showcase-title-accent"></div>
        </div>

        <div class="feature-section">
            <div class="feature-grid">

                <article class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round"
                            aria-hidden="true">
                            <path d="m12 3 9 5-9 5-9-5 9-5Z" />
                            <path d="m3 8 9 5 9-5" />
                            <path d="M3 8v9l9 5 9-5V8" />
                            <path d="M12 13v9" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="feature-title">Inventory Management</h3>
                        <p class="feature-description">Vehicles, parts & stock</p>
                    </div>
                </article>

                <article class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round"
                            aria-hidden="true">
                            <path d="M3 3v18h18" />
                            <path d="m7 14 4-4 3 3 5-7" />
                            <path d="M17 6h2v2" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="feature-title">Sales & Billing</h3>
                        <p class="feature-description">Orders, invoices & payments</p>
                    </div>
                </article>

                <article class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round"
                            aria-hidden="true">
                            <path d="M14.7 6.3a5 5 0 0 0-6.9 6.9L3 18l3 3 4.8-4.8a5 5 0 0 0 6.9-6.9L14 13l-3-3 3.7-3.7Z" />
                            <path d="m15 5 4-4 4 4-4 4" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="feature-title">Service Management</h3>
                        <p class="feature-description">Workshop & service operations</p>
                    </div>
                </article>

                <article class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round"
                            aria-hidden="true">
                            <path d="M3 3v18h18" />
                            <path d="M7 14h3v4H7z" />
                            <path d="M14 9h3v9h-3z" />
                            <path d="M18 5h3v13h-3z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="feature-title">Business Analytics</h3>
                        <p class="feature-description">Reports & insights</p>
                    </div>
                </article>

            </div>
        </div>
    </div>

    
</section>