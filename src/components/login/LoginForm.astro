
---
import '../../styles/login/login-form.css';
---

<section class="form-panel">
    <div class="form-content">
        <!-- Mobile branding -->
        <a href="/" class="mobile-brand" aria-label="VG Automobiles Home">
            <span class="mobile-brand-mark">
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <path
                        d="M4 7.5L9 17L13 9L16 14L20 7"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M4 7.5H8"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                    />
                </svg>
            </span>

            <span class="mobile-brand-name">
                VG <strong>AUTOMOBILES</strong>
            </span>
        </a>

        <!-- Heading -->
        <div class="form-header">
            <span class="form-eyebrow">DEALER MANAGEMENT PORTAL</span>

            <h2 class="form-heading">Welcome back.</h2>

            <p class="form-subtitle">
                Sign in to access your branch dashboard and manage your
                automotive business.
            </p>
        </div>

        <!-- Login form -->
        <form class="login-form" id="login-form">
            <!-- Branch Code -->
            <div class="form-group">
                <label class="form-label" for="branch-code">
                    Branch Code
                </label>

                <div class="input-wrapper">
                    <input
                        class="form-input"
                        type="text"
                        id="branch-code"
                        name="branch_code"
                        placeholder="Enter your branch code"
                        autocomplete="organization"
                        required
                    />
                </div>
            </div>

            <!-- Username -->
            <div class="form-group">
                <label class="form-label" for="username">
                    Username
                </label>

                <div class="input-wrapper">
                    <input
                        class="form-input"
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Enter your username"
                        autocomplete="username"
                        required
                    />
                </div>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label class="form-label" for="password">
                    Password
                </label>

                <div class="input-wrapper">
                    <input
                        class="form-input password-input"
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    />

                    <button
                        class="password-toggle"
                        type="button"
                        id="password-toggle"
                        aria-label="Show password"
                        aria-pressed="false"
                    >
                        <svg
                            id="password-eye-icon"
                            width="19"
                            height="19"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Forgot password -->
            <div class="form-options">
                <button
                    type="button"
                    class="forgot-password"
                    id="forgot-password"
                >
                    Forgot password?
                </button>
            </div>

            <!-- Feedback message -->
            <div
                class="form-message"
                id="form-message"
                role="status"
                aria-live="polite"
            ></div>

            <!-- Sign in -->
            <button class="login-button" type="submit" id="login-submit">
                <span>Sign In</span>

                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </button>
        </form>

        <!-- Security note -->
        <div class="security-note">
            <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>

            <span>Secure access to your dealership workspace</span>
        </div>

        <!-- Copyright -->
        <p class="form-copyright">
            © {new Date().getFullYear()} VG Automobiles. All rights reserved.
        </p>
    </div>
</section>
