---
import '../../styles/login/login-form.css';
---

<section class="form-panel" aria-label="Dealer login">
    <div class="form-content">

        <header class="form-header">
            <div class="form-brand" aria-hidden="true">
                <span class="form-brand-mark">
                    <svg viewBox="0 0 48 20" fill="none" aria-hidden="true">
                        <path
                            d="M2 14C8 6 14 4 20 6C26 8 30 12 36 10C40 9 44 6 46 4"
                            stroke="url(#form-logo-grad)"
                            stroke-width="3.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <defs>
                            <linearGradient id="form-logo-grad" x1="2" y1="10" x2="46" y2="10">
                                <stop stop-color="#ff2d4a" />
                                <stop offset="1" stop-color="#c80d31" />
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
                <span class="form-brand-name">
                    <span class="form-brand-vg">VG</span>
                    <span class="form-brand-rest">Automobiles</span>
                </span>
            </div>

            <h2 class="form-heading">Welcome Back</h2>
            <p class="form-subtitle" id="login-description">
                Sign in to continue
            </p>
        </header>

        <form class="login-form" id="login-form" aria-describedby="login-description">

            <div class="form-group">
                <label class="form-label visually-hidden" for="branch-code">Branch Code</label>
                <div class="input-wrapper has-leading-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18" />
                            <path d="M5 21V7l7-4 7 4v14" />
                            <path d="M9 21v-6h6v6" />
                            <path d="M9 9h.01" />
                            <path d="M15 9h.01" />
                            <path d="M9 13h.01" />
                            <path d="M15 13h.01" />
                        </svg>
                    </span>
                    <input
                        class="form-input"
                        type="text"
                        id="branch-code"
                        name="branch_code"
                        placeholder="Branch Code"
                        autocomplete="organization"
                        autocapitalize="characters"
                        spellcheck="false"
                        required
                    />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label visually-hidden" for="username">Username</label>
                <div class="input-wrapper has-leading-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <input
                        class="form-input"
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Username"
                        autocomplete="username"
                        autocapitalize="none"
                        spellcheck="false"
                        required
                    />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label visually-hidden" for="password">Password</label>
                <div class="input-wrapper has-leading-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input
                        class="form-input password-input"
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Password"
                        autocomplete="current-password"
                        required
                    />

                    <button
                        class="password-toggle"
                        type="button"
                        id="password-toggle"
                        aria-label="Show password"
                        aria-pressed="false"
                        aria-controls="password"
                    >
                        <svg
                            id="password-eye-icon"
                            width="19"
                            height="19"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input
                        type="checkbox"
                        id="remember-me"
                        name="remember_me"
                        class="remember-checkbox"
                    />
                    <span class="remember-label">Remember me</span>
                </label>

                <button
                    type="button"
                    class="forgot-password"
                    id="forgot-password"
                >
                    Forgot password?
                </button>
            </div>

            <div
                class="form-message"
                id="form-message"
                role="status"
                aria-live="polite"
                aria-atomic="true"
            ></div>

            <button
                class="login-button"
                type="submit"
                id="login-submit"
            >
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
                <span>Sign In</span>
            </button>
        </form>

        <div class="demo-credentials" id="demo-credentials">
            <p class="demo-title">Demo credentials</p>
            <ul class="demo-list">
                <li><strong>System Owner</strong> — HO / owner / owner123</li>
                <li><strong>BHP Branch Owner</strong> — BHP / owner / owner123</li>
                <li><strong>PKR Branch Owner</strong> — PKR / owner / owner123</li>
                <li><strong>BTL Branch Owner</strong> — BTL / owner / owner123</li>
                <li><strong>HO Admin</strong> — HO / admin / admin123</li>
            </ul>
            <p class="demo-note">Owners: first login requires password update.</p>
        </div>

        <div class="form-footer-tagline">
            <span class="form-footer-line" aria-hidden="true"></span>
            <span class="form-footer-text">Powering Automotive Excellence</span>
            <span class="form-footer-line" aria-hidden="true"></span>
        </div>

    </div>
</section>
