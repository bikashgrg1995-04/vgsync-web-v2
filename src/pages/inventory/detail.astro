---
import AppLayout from "../../layouts/AppLayout.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../lib/navigation";
import { PAGE_META } from "../../lib/page-meta";
import type { UserRole } from "../../lib/auth";
import ProductDialog from "../../components/inventory/ProductDialog.astro";
import "../../styles/widgets/inventory-page.css";
import "../../styles/widgets/inventory-detail.css";
import Loading from '../../components/inventory-detail/Loading.astro';
import InvdTabs from '../../components/inventory-detail/InvdTabs.astro';
import DetailsPanel from '../../components/inventory-detail/DetailsPanel.astro';
import MovementsPanel from '../../components/inventory-detail/MovementsPanel.astro';
import ActivitiesPanel from '../../components/inventory-detail/ActivitiesPanel.astro';
import AdjustStockDialog from '../../components/inventory-detail/AdjustStockDialog.astro';

const meta = PAGE_META.inventory;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Inventory Detail"
  pageTitle={meta.title}
  breadcrumb="Inventory / Detail"
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page invd-page" id="invd-page">
    <a class="invd-back" href="/inventory">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
      Back to Inventory
    </a>

    <p class="inv-notice" id="invd-notice" hidden></p>

    <!-- PRODUCT HEADER -->
    <Loading />

    <!-- TABS -->
    <InvdTabs />

    <!-- TAB: STOCK DETAILS -->
    <DetailsPanel />

    <!-- TAB: STOCK MOVEMENTS -->
    <MovementsPanel />

    <!-- TAB: ACTIVITIES -->
    <ActivitiesPanel />

    <!-- TAB: RELATED INFO -->
    <section class="invd-panel" data-panel="related">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Product Details</h3>
        </div>
        <dl class="invd-related" id="invd-related"></dl>
      </div>
    </section>
  </div>

  <!-- STOCK ADJUSTMENT DIALOG -->
  <AdjustStockDialog />
  <ProductDialog />
</AppLayout>

<script>
  import "../../scripts/pages/inventory-detail.ts";
</script>
