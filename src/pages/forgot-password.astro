---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import LoginShowcase from '../components/login/LoginShowcase.astro';
import AuthFormShell from '../components/login/AuthFormShell.astro';

import '../styles/login/login.css';
---

<Layout title="Forgot password | VG Automobiles">
    <main class="login-page">
        <ThemeToggle />

        <div class="login-shell">
            <LoginShowcase />

            <AuthFormShell
                heading="Forgot password?"
                subtitle="Enter your business code and username. If your account has an email address, we will send a reset link to it."
            >
                <form class="login-form" id="forgot-form" aria-describedby="auth-description" novalidate>
                    <div class="form-group">
                        <label class="form-label visually-hidden" for="business-code">Business Code</label>
                        <div class="input-wrapper">
                            <input
                                class="form-input"
                                type="text"
                                id="business-code"
                                name="business_code"
                                placeholder="Business Code"
                                autocomplete="organization"
                                autocapitalize="characters"
                                spellcheck="false"
                                required
                            />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label visually-hidden" for="username">Username</label>
                        <div class="input-wrapper">
                            <input
                                class="form-input"
                                type="text"
                                id="username"
                                name="username"
                                placeholder="Username"
                                autocomplete="username"
                                autocapitalize="none"
                                spellcheck="false"
                                required
                            />
                        </div>
                    </div>

                    <div class="form-message" id="form-message" role="status" aria-live="polite" aria-atomic="true"></div>

                    <button class="login-button" type="submit" id="forgot-submit">
                        <span>Send reset link</span>
                    </button>
                </form>
            </AuthFormShell>
        </div>
    </main>
</Layout>

<script>
    import { forgotPassword, ApiError } from '../lib/auth';
    import { showMessage, clearMessage, setBusy } from '../scripts/auth-common';

    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const button = document.getElementById('forgot-submit') as HTMLButtonElement;
    const codeInput = document.getElementById('business-code') as HTMLInputElement;
    const userInput = document.getElementById('username') as HTMLInputElement;

    const params = new URLSearchParams(window.location.search);
    codeInput.value = params.get('business_code') ?? '';
    userInput.value = params.get('username') ?? '';

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearMessage();

        const code = codeInput.value.trim();
        const username = userInput.value.trim();
        if (!code || !username) {
            showMessage('Please enter your business code and username.', 'error');
            return;
        }

        setBusy(button, true, 'Sending…', 'Send reset link');
        try {
            const message = await forgotPassword(code, username);
            showMessage(message, 'success');
            // One request per click: keep the button disabled for a while so
            // the same person is not emailed repeatedly.
            setTimeout(() => setBusy(button, false, '', 'Send reset link'), 30000);
        } catch (error) {
            showMessage(error instanceof ApiError ? error.message : 'Something went wrong. Please try again.', 'error');
            setBusy(button, false, '', 'Send reset link');
        }
    });

    form.querySelectorAll('input').forEach((input) => input.addEventListener('input', clearMessage));
</script>

<script>
    import '../scripts/auth-common';
</script>
