---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import type { UserRole } from '../../lib/auth';
import '../../styles/pages/staff-detail.css';
import { I, ic } from '../../components/staff-detail/icons';
import StaffDetailBody from '../../components/staff-detail/StaffDetailBody.astro';

const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Staff Detail"
  pageTitle="Staff"
  breadcrumb="Staff / Detail"
  activeId="staff"
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Owner"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="sd-page" id="sd-page">
    <nav class="sd-crumb" aria-label="Breadcrumb">
      <a href="/staff" aria-label="Back to staff"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg></a>
      <a href="/staff">Staff</a><span>/</span><strong>Staff Detail</strong>
    </nav>

    <p class="sd-error" id="sd-error" role="alert" hidden></p>

    <StaffDetailBody />
  </div>
</AppLayout>

<script>
  import '../../scripts/pages/staff-detail.ts';
</script>
