---
import AppLayout from "../../layouts/AppLayout.astro";
import SalesDialogs from "../../components/sales/SalesDialogs.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../lib/navigation";
import { PAGE_META } from "../../lib/page-meta";
import type { UserRole } from "../../lib/auth";
import "../../styles/widgets/inventory-page.css";
import "../../styles/widgets/inventory-detail.css";
import "../../styles/widgets/sales-shared.css";
import "../../styles/widgets/purchase-page.css";
import "../../styles/widgets/purchase-detail.css";
import "../../styles/pages/sales-detail.css";
import Loading from '../../components/sales-detail/Loading.astro';
import InvdTabs from '../../components/sales-detail/InvdTabs.astro';
import DetailsPanel from '../../components/sales-detail/DetailsPanel.astro';
import PaymentsPanel from '../../components/sales-detail/PaymentsPanel.astro';
import EmiPanel from '../../components/sales-detail/EmiPanel.astro';
import JobPanel from '../../components/sales-detail/JobPanel.astro';
import FreeservicePanel from '../../components/sales-detail/FreeservicePanel.astro';
import DocumentsPanel from '../../components/sales-detail/DocumentsPanel.astro';
import RelatedPanel from '../../components/sales-detail/RelatedPanel.astro';

const meta = PAGE_META.sales;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Sale Detail"
  pageTitle={meta.title}
  breadcrumb="Sales / Detail"
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page invd-page pud-page sad-page" id="sad-page">
    <a class="invd-back" href="/sales">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
      Back to Sales
    </a>

    <p class="inv-notice" id="sad-notice" hidden></p>

    <!-- SALE HEADER -->
    <Loading />

    <!-- TABS -->
    <InvdTabs />

    <!-- TAB: SALE DETAILS -->
    <DetailsPanel />

    <!-- TAB: PAYMENTS -->
    <PaymentsPanel />

    <!-- TAB: EMI -->
    <EmiPanel />

    <!-- TAB: JOB (maintenance) -->
    <JobPanel />

    <!-- TAB: FREE SERVICING -->
    <FreeservicePanel />

    <!-- TAB: DOCUMENTS (accident case) -->
    <DocumentsPanel />

    <!-- TAB: ACTIVITIES -->
    <section class="invd-panel" data-panel="activities">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Activities</h3>
        </div>
        <ul class="inv-activity" id="sad-activity">
          <li class="inv-activity-empty">Loading…</li>
        </ul>
      </div>
    </section>

    <!-- TAB: RELATED INFO -->
    <RelatedPanel />
  </div>

  <SalesDialogs />
</AppLayout>

<script>
  import "../../scripts/pages/sales-detail.ts";
</script>
