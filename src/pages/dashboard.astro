---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';

const meta = PAGE_META.overview;
const defaultRole: UserRole = 'headoffice';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="ov-page">
    <section class="ov-hero" aria-label="Welcome">
      <div class="ov-hero-bg" aria-hidden="true"></div>
      <div class="ov-hero-shade" aria-hidden="true"></div>
      <div class="ov-hero-text">
        <h2 class="ov-hero-title"><span id="ov-title">Welcome back!</span> <span aria-hidden="true">👋</span></h2>
        <p class="ov-hero-sub" id="ov-sub">Here's what's happening with your business today.</p>
        <p class="ov-hero-date"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg><span id="ov-now"></span></p>
      </div>
      <button type="button" class="ov-refresh" id="ov-refresh">Refresh</button>
    </section>

    <div class="ov-kpis" id="ov-kpis"></div>

    <section class="ov-owner" id="ov-owner" hidden>
      <div class="ov-alerts" id="ov-alerts"></div>
      <div class="ov-due" id="ov-due"></div>

      <div class="ov-main">
        <section class="ov-card ov-overview">
          <header class="ov-card-head">
            <h3><span class="ov-ico" aria-hidden="true">▥</span> Overview</h3>
            <select id="ov-range" class="ov-select" aria-label="Period">
              <option value="7">Last 7 Days</option>
              <option value="30" selected>Last 30 Days</option>
              <option value="90">Last 90 Days</option>
            </select>
          </header>
          <div class="ov-tiles" id="ov-tiles"></div>
          <div id="ov-linechart"></div>
        </section>

        <div class="ov-side">
          <section class="ov-card">
            <h3><span class="ov-ico" aria-hidden="true">▦</span> Installments Overview <a href="/dashboard/sales#followups" class="ov-more">View All →</a></h3>
            <div id="ov-installments"></div>
          </section>
          <section class="ov-card">
            <h3><span class="ov-ico" aria-hidden="true">⚖</span> Credit Overview <a href="/dashboard/reports" class="ov-more">View All →</a></h3>
            <div id="ov-credit"></div>
          </section>
        </div>
      </div>

      <div class="ov-kpis" id="ov-owner-kpis"></div>

      <div class="ov-trio">
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">⬢</span> Stock Alerts <a href="/dashboard/inventory" class="ov-more">View Details →</a></h3>
          <div id="ov-low"></div>
        </section>
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">🔧</span> Servicing Follow-ups <a href="/dashboard/sales#followups" class="ov-more">View All →</a></h3>
          <div id="ov-servicing"></div>
        </section>
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">◷</span> Recent Activities</h3>
          <div id="ov-activity"></div>
        </section>
      </div>

      <section class="ov-card" id="ov-branches" hidden>
        <h3>Branch overview <span class="ov-hint">read-only · this month</span></h3>
        <div class="ov-table-wrap"><table class="ov-table">
          <thead><tr><th>Branch</th><th>Sales today</th><th>Sales (month)</th><th>Purchases (month)</th><th>Profit (month)</th><th>Owed by customers</th><th>Low stock</th></tr></thead>
          <tbody id="ov-branches-body"></tbody>
        </table></div>
      </section>
    </section>

    <div class="ov-grid" id="ov-legacy">
      <section class="ov-card" id="ov-mytasks-card">
        <h3>My tasks <a href="/dashboard/tasks" class="ov-more">Open</a></h3>
        <div id="ov-mytasks"></div>
      </section>
      <section class="ov-card">
        <h3>Sales, last 14 days <span class="ov-hint">confirmed sales</span></h3>
        <div id="ov-sales-chart"></div>
      </section>
    </div>
  </div>

<script>
  import { can, getSession } from '../lib/auth';
  import { listSales, type Sale } from '../lib/sales';
  import { listFollowups, type Followup } from '../lib/sales';
  import { listStock, getInventorySummary, type StockItem } from '../lib/inventory';
  import { listOrders, type OrderSummary } from '../lib/orders';
  import { listTasks, type Task } from '../lib/tasks';
  import { loadDashboard, formatNpr, type Dashboard } from '../lib/reports';

  const session = getSession();
  if (!session) window.location.replace('/');

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) =>
    String(s).replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>').replace(/"/g, '"');
  const iso = (d: Date) => d.toLocaleDateString('en-CA');
  const daysAgo = (n: number) => new Date(Date.now() - n * 864e5);
  const kpi = (label: string, value: string, sub = '', tone = '', href = '') =>
    `<${href ? 'a href="' + href + '"' : 'article'} class="ov-kpi ${tone}"><span>${esc(label)}</span><strong>${esc(value)}</strong>${sub ? `<em>${esc(sub)}</em>` : ''}</${href ? 'a' : 'article'}>`;
  const empty = (t: string) => `<p class="ov-empty">${esc(t)}</p>`;
  let run = 0;

  function chart(sales: Sale[]): string {
    const days: { key: string; label: string; total: number }[] = [];
    for (let i = 13; i >= 0; i -= 1) {
      const d = daysAgo(i);
      days.push({ key: iso(d), label: d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }), total: 0 });
    }
    for (const s of sales) {
      const d = days.find((x) => x.key === s.saleDate);
      if (d) d.total += s.netTotal;
    }
    const max = Math.max(...days.map((d) => d.total), 1);
    if (days.every((d) => d.total === 0)) return empty('No confirmed sales in the last 14 days.');
    return `<div class="ov-bars">${days
      .map((d) => `<div class="ov-bar" title="${esc(d.label)}: ${esc(formatNpr(d.total))}"><i style="height:${Math.max((d.total / max) * 100, d.total ? 3 : 0)}%"></i><span>${d.label.split(' ')[0]}</span></div>`)
      .join('')}</div>`;
  }

  function myTasksHtml(tasks: Task[]): string {
    if (tasks.length === 0) return empty('Nothing waiting for you.');
    const sorted = [...tasks].sort(
      (a, b) =>
        Number(b.isOverdue) - Number(a.isOverdue) ||
        (a.dueDate ?? '9999').localeCompare(b.dueDate ?? '9999'),
    );
    const rows = sorted.slice(0, 6).map((t) => {
      const due = t.dueDate ? `${t.isOverdue ? 'overdue · ' : 'due '}${esc(t.dueDate)}` : 'no due date';
      return `<li><span><a href="/dashboard/tasks?id=${t.id}">${esc(t.title)}</a><em>${due}${t.status === 'in_progress' ? ' · in progress' : ''}</em></span>${t.isOverdue ? '<b class="ov-tag">Overdue</b>' : t.priority === 'high' ? '<b class="ov-tag">High</b>' : ''}</li>`;
    });
    const more = sorted.length > 6 ? `<p class="ov-empty">+ ${sorted.length - 6} more</p>` : '';
    return `<ul class="ov-list">${rows.join('')}</ul>${more}`;
  }

  async function load(): Promise<void> {
    const mine = ++run;
    const s = getSession();
    if (!s) return;
    $('ov-title').textContent = `Welcome back, ${s.displayName.split(' ')[0]}!`;
    $('ov-sub').textContent = `Here's what's happening with ${s.activeBranchName} today.`;
    const nowEl = $('ov-now');
    if (nowEl) {
      const d = new Date();
      nowEl.textContent = d.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' · ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    }

    // Show owner section for head office / owners
    const isOwner = can(s, 'dashboard.view') || can(s, 'branches.view');
    $('ov-owner').hidden = !isOwner;
    $('ov-legacy').hidden = isOwner;

    if (isOwner) {
      await loadOwner(mine, s);
    } else {
      // Staff view - basic KPIs and tasks
      try {
        const tasks = await listTasks({ assignedToMe: true, status: 'open' });
        if (mine !== run) return;
        $('ov-mytasks').innerHTML = myTasksHtml(tasks);
      } catch {
        $('ov-mytasks').innerHTML = empty('Could not load tasks.');
      }
    }
  }

  function dueCard(cls: string, icon: string, title: string, value: string, sub: string, href: string) {
    return `<a class="ov-due-card ${cls}" href="${href}"><span class="ov-due-ico" aria-hidden="true">${icon}</span><span class="ov-due-body"><b>${esc(title)}</b><strong>${esc(value)}</strong><em>${esc(sub)}</em></span><span class="ov-due-view">View →</span></a>`;
  }

  async function loadOwner(mine: number, s: NonNullable<ReturnType<typeof getSession>>): Promise<void> {
    const full = can(s, 'dashboard.view');
    try {
      const data = await loadDashboard({ range: Number(($('ov-range') as HTMLSelectElement).value) || 30 });
      if (mine !== run) return;

      // Due cards
      const dueHtml = [
        dueCard('is-emi', '📅', 'Installment Due Soon', data.due?.installments?.count ? `${data.due.installments.count} bike sale installments` : 'None', data.due?.installments?.hint || 'are due within 3 days', '/dashboard/sales#followups'),
        dueCard('is-pay', '💳', 'Purchase Credit Due', data.due?.purchaseCredit ? formatNpr(data.due.purchaseCredit.amount) : 'Rs. 0', data.due?.purchaseCredit?.hint || 'due soon', '/dashboard/reports'),
        dueCard('is-recv', '💰', 'Sales Credit Due', data.due?.salesCredit ? formatNpr(data.due.salesCredit.amount) : 'Rs. 0', data.due?.salesCredit?.hint || 'due soon', '/dashboard/reports'),
        dueCard('is-serv', '🔧', 'Servicing Follow-ups', data.due?.servicing?.count ? `${data.due.servicing.count} customers` : 'None', data.due?.servicing?.hint || 'need follow-up', '/dashboard/sales#followups'),
      ].join('');
      $('ov-due').innerHTML = dueHtml;

      // Overview tiles + chart
      if (data.overview) {
        $('ov-tiles').innerHTML = tiles(data.overview);
        $('ov-linechart').innerHTML = lineChart(data.overview);
      }

      // Installments & Credit side panels
      if (data.installments) {
        $('ov-installments').innerHTML = data.installments.map((i: any) =>
          `<div class="ov-row"><span><b>${esc(i.ref)}</b><em>Installment · ${i.paid} of ${i.total} paid</em></span><span class="ov-badge">${esc(i.dueLabel)}</span></div>`
        ).join('') || empty('No upcoming installments');
      }
      if (data.credit) {
        $('ov-credit').innerHTML = `
          <div class="ov-row"><span>Purchase Credit (To Give)</span><strong>${formatNpr(data.credit.purchase || 0)}</strong></div>
          <div class="ov-row"><span>Sales Credit (To Receive)</span><strong>${formatNpr(data.credit.sales || 0)}</strong></div>`;
      }

      // Stock alerts
      if (data.lowStock) {
        $('ov-low').innerHTML = data.lowStock.map((item: any) =>
          `<div class="ov-row"><span>${esc(item.name)}</span><span>Stock: ${item.qty} <b class="ov-tag">Low Stock</b></span></div>`
        ).join('') || empty('All good');
      }

      // Servicing
      if (data.servicing) {
        $('ov-servicing').innerHTML = data.servicing.map((f: any) =>
          `<div class="ov-row"><span><b>${esc(f.customer)}</b><em>${esc(f.service)}</em></span><button class="ov-btn">Contact</button></div>`
        ).join('') || empty('No follow-ups');
      }

      // Recent activity
      if (data.activity) {
        $('ov-activity').innerHTML = `<ul class="ov-timeline">${data.activity.map((a: any) =>
          `<li class="k-${a.type}"><span>${esc(a.text)}</span><em>${esc(a.when)}</em></li>`
        ).join('')}</ul>`;
      }
    } catch (err) {
      console.error(err);
      $('ov-due').innerHTML = empty('Could not load dashboard data.');
    }
  }

  function tiles(o: Dashboard['overview']): string {
    if (!o) return '';
    return [
      `<div class="ov-tile"><span>Total Sales</span><strong>${formatNpr(o.sales || 0)}</strong><em>↑ ${o.salesPct || 0}%</em></div>`,
      `<div class="ov-tile"><span>Total Purchase</span><strong>${formatNpr(o.purchase || 0)}</strong><em>↑ ${o.purchasePct || 0}%</em></div>`,
      `<div class="ov-tile"><span>Income</span><strong>${formatNpr(o.income || 0)}</strong><em>↑ ${o.incomePct || 0}%</em></div>`,
      `<div class="ov-tile"><span>Expenses</span><strong>${formatNpr(o.expenses || 0)}</strong><em>↑ ${o.expensesPct || 0}%</em></div>`,
    ].join('');
  }

  function lineChart(o: Dashboard['overview']): string {
    // Simple placeholder chart area - real chart can be enhanced later
    return `<div class="ov-chart-placeholder" style="height:180px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:0.85rem;">Sales / Purchase / Expenses trend</div>`;
  }

  $('ov-refresh')?.addEventListener('click', () => load());
  $('ov-range')?.addEventListener('change', () => load());
  load();
</script>

<style>
  .ov-page { display: flex; flex-direction: column; gap: 16px; }
  .ov-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    min-height: 108px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    color: #0b1b33;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .ov-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-dashboard.jpg');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .ov-hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg,
        rgba(255, 255, 255, 0.92) 0%,
        rgba(255, 255, 255, 0.78) 38%,
        rgba(255, 255, 255, 0.28) 62%,
        rgba(255, 255, 255, 0.08) 100%);
  }
  .ov-hero-text, .ov-hero .ov-refresh { position: relative; z-index: 1; }
  .ov-hero .ov-refresh { flex-shrink: 0; }
  :root[data-theme="dark"] .ov-hero { color: #eef4ff; }
  :root[data-theme="dark"] .ov-hero-shade {
    background:
      linear-gradient(100deg,
        rgba(12, 22, 42, 0.92) 0%,
        rgba(15, 28, 52, 0.82) 40%,
        rgba(15, 28, 52, 0.35) 65%,
        rgba(15, 28, 52, 0.12) 100%);
  }
  @media (max-width: 700px) {
    .ov-hero { min-height: 96px; padding: 14px 16px; }
    .ov-hero-bg { background-position: 70% center; }
    .ov-hero-shade {
      background: linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.72) 55%, rgba(255,255,255,0.35) 100%);
    }
    :root[data-theme="dark"] .ov-hero-shade {
      background: linear-gradient(180deg, rgba(12,22,42,0.92) 0%, rgba(12,22,42,0.78) 60%, rgba(12,22,42,0.4) 100%);
    }
  }
  .ov-hero-title { margin: 0; font-size: 1.35rem; font-weight: 750; letter-spacing: -0.025em; line-height: 1.2; }
  .ov-hero-sub { margin: 3px 0 10px; font-size: 0.86rem; opacity: 0.88; line-height: 1.35; max-width: 36ch; }
  .ov-hero-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #0f1f3d;
    font-size: 0.75rem;
    font-weight: 650;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }
  :root[data-theme="dark"] .ov-hero-date {
    background: rgba(15, 23, 42, 0.55);
    color: #e8eefc;
    border-color: rgba(255, 255, 255, 0.1);
  }
  .ov-hero .ov-refresh {
    background: rgba(255, 255, 255, 0.72);
    color: #0f1f3d;
    border: 1px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  :root[data-theme="dark"] .ov-hero .ov-refresh {
    background: rgba(15, 23, 42, 0.55);
    color: #e8eefc;
    border-color: rgba(255, 255, 255, 0.12);
  }
  .ov-main { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 12px; }
  .ov-side { display: flex; flex-direction: column; gap: 12px; }
  .ov-trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 1100px) { .ov-main, .ov-trio { grid-template-columns: 1fr; } }
  .ov-card h3 { font-size: 0.95rem; }
  .ov-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .ov-card-head h3 { margin: 0; }
  .ov-ico { color: var(--accent); }
  .ov-select { height: 32px; padding: 0 10px; border: 1px solid var(--border); border-radius: 9px; background: var(--panel-bg); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; font-weight: 600; }
  .ov-due { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .ov-due:empty { display: none; }
  @media (max-width: 1100px) { .ov-due { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ov-due { grid-template-columns: 1fr; } }
  .ov-due-card { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 12px; border-radius: 14px; border: 1px solid var(--border); border-left-width: 4px; background: var(--panel-bg); color: inherit; text-decoration: none; position: relative; }
  .ov-due-card:hover { box-shadow: 0 6px 18px rgba(15, 31, 61, .08); }
  .ov-due-ico { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; font-size: 1.15rem; }
  .ov-due-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .ov-due-body b { font-size: 0.86rem; font-weight: 700; }
  .ov-due-body strong { font-size: 1.05rem; font-weight: 700; margin-top: 2px; }
  .ov-due-body em { font-style: normal; font-size: 0.74rem; color: var(--text-muted); }
  .ov-due-view { align-self: flex-end; font-size: 0.74rem; font-weight: 650; color: var(--accent); white-space: nowrap; }
  .ov-due-card.is-emi { border-left-color: #7c3aed; background: color-mix(in srgb, #7c3aed 6%, var(--panel-bg)); } .is-emi .ov-due-ico { background: rgba(124,58,237,.15); }
  .ov-due-card.is-pay { border-left-color: #16a34a; background: color-mix(in srgb, #16a34a 6%, var(--panel-bg)); } .is-pay .ov-due-ico { background: rgba(22,163,74,.15); }
  .ov-due-card.is-recv { border-left-color: #f59e0b; background: color-mix(in srgb, #f59e0b 7%, var(--panel-bg)); } .is-recv .ov-due-ico { background: rgba(245,158,11,.18); }
  .ov-due-card.is-serv { border-left-color: #ef334e; background: color-mix(in srgb, #ef334e 6%, var(--panel-bg)); } .is-serv .ov-due-ico { background: rgba(239,51,78,.14); }
  .ov-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
  @media (max-width: 700px) { .ov-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ov-tile { padding: 12px 12px 8px; border-radius: 12px; border: 1px solid var(--border); background: var(--panel-bg); min-width: 0; }
  .ov-tile span { display: block; font-size: 0.78rem; color: var(--text-muted); }
  .ov-tile strong { display: block; font-size: 1.15rem; font-weight: 750; margin-top: 4px; }
  .ov-tile em { font-style: normal; font-size: 0.75rem; color: #16a34a; }
  .ov-more { font-size: 0.78rem; font-weight: 650; color: var(--accent); text-decoration: none; }
  .ov-more:hover { text-decoration: underline; }
  .ov-hint { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; }
  .ov-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 800px) { .ov-grid { grid-template-columns: 1fr; } }
  .ov-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.86rem; }
  .ov-row:last-child { border-bottom: 0; }
  .ov-badge { font-size: 0.72rem; font-weight: 650; padding: 3px 8px; border-radius: 999px; background: #fef2f2; color: #b91c1c; }
  .ov-tag { font-size: 0.7rem; font-weight: 650; padding: 2px 7px; border-radius: 6px; background: #fef2f2; color: #b91c1c; }
  .ov-btn { font-size: 0.75rem; font-weight: 650; padding: 5px 10px; border-radius: 8px; border: 0; background: var(--accent); color: #fff; cursor: pointer; }
  .ov-empty { color: var(--text-muted); font-size: 0.85rem; margin: 8px 0; }
  .ov-timeline { list-style: none; margin: 0; padding: 0; }
  .ov-timeline li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0 8px 14px; border-left: 2px solid var(--border); position: relative; font-size: 0.84rem; }
  .ov-timeline li::before { content: ''; position: absolute; left: -5px; top: 12px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .ov-timeline em { font-style: normal; color: var(--text-muted); font-size: 0.72rem; white-space: nowrap; }
</style>
</AppLayout>
