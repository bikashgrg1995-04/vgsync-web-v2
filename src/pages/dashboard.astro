---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';

const meta = PAGE_META.overview;
const defaultRole: UserRole = 'headoffice';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomNav={BOTTOM_NAV}
>
  <div class="ov" id="ov-root">
    <section class="ov-hero" aria-label="Welcome">
      <div class="ov-hero-bg" aria-hidden="true"></div>
      <div class="ov-hero-shade" aria-hidden="true"></div>
      <div class="ov-hero-text">
        <h2 class="ov-hero-title"><span id="ov-title">Welcome back!</span> <span aria-hidden="true">👋</span></h2>
        <p class="ov-hero-sub" id="ov-sub">Here's what's happening with your business today.</p>
        <p class="ov-hero-date"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg><span id="ov-now"></span></p>
      </div>
      <button type="button" class="ov-refresh" id="ov-refresh">Refresh</button>
    </section>

    <div class="ov-kpis" id="ov-kpis"></div>

    <section class="ov-owner" id="ov-owner" hidden>
      <div class="ov-alerts" id="ov-alerts"></div>
      <div class="ov-due" id="ov-due"></div>

      <div class="ov-main">
        <section class="ov-card ov-overview">
          <header class="ov-card-head">
            <h3><span class="ov-ico" aria-hidden="true">▥</span> Overview</h3>
            <select id="ov-range" class="ov-select" aria-label="Period">
              <option value="7">Last 7 Days</option>
              <option value="30" selected>Last 30 Days</option>
              <option value="90">Last 90 Days</option>
            </select>
          </header>
          <div class="ov-tiles" id="ov-tiles"></div>
          <div id="ov-linechart"></div>
        </section>

        <div class="ov-side">
          <section class="ov-card">
            <h3><span class="ov-ico" aria-hidden="true">▦</span> Installments Overview <a href="/dashboard/sales#followups" class="ov-more">View All →</a></h3>
            <div id="ov-installments"></div>
          </section>
          <section class="ov-card">
            <h3><span class="ov-ico" aria-hidden="true">⚖</span> Credit Overview <a href="/dashboard/reports" class="ov-more">View All →</a></h3>
            <div id="ov-credit"></div>
          </section>
        </div>
      </div>

      <div class="ov-kpis" id="ov-owner-kpis"></div>

      <div class="ov-trio">
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">◎</span> Sales by Branch</h3>
          <div id="ov-sales-branch"></div>
        </section>
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">◈</span> Top Models</h3>
          <div id="ov-top-models"></div>
        </section>
        <section class="ov-card">
          <h3><span class="ov-ico" aria-hidden="true">▣</span> Recent Activity</h3>
          <div id="ov-activity"></div>
        </section>
      </div>
    </section>

    <section class="ov-staff" id="ov-staff" hidden>
      <div class="ov-card">
        <h3>Staff Dashboard</h3>
        <p class="muted">Your daily tasks and targets will appear here.</p>
      </div>
    </section>
  </div>

  <style>
  .ov { display: flex; flex-direction: column; gap: 16px; }
  .ov-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    min-height: 108px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    color: #0b1b33;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .ov-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .ov-hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg,
        rgba(255, 255, 255, 0.92) 0%,
        rgba(255, 255, 255, 0.78) 38%,
        rgba(255, 255, 255, 0.28) 62%,
        rgba(255, 255, 255, 0.08) 100%);
  }
  .ov-hero-text, .ov-hero .ov-refresh { position: relative; z-index: 1; }
  .ov-hero .ov-refresh { flex-shrink: 0; }
  :root[data-theme="dark"] .ov-hero { color: #eef4ff; }
  :root[data-theme="dark"] .ov-hero-shade {
    background:
      linear-gradient(100deg,
        rgba(12, 22, 42, 0.92) 0%,
        rgba(15, 28, 52, 0.82) 40%,
        rgba(15, 28, 52, 0.35) 65%,
        rgba(15, 28, 52, 0.12) 100%);
  }
  @media (max-width: 700px) {
    .ov-hero { min-height: 96px; padding: 14px 16px; }
    .ov-hero-bg { background-position: 70% center; }
    .ov-hero-shade {
      background: linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.72) 55%, rgba(255,255,255,0.35) 100%);
    }
    :root[data-theme="dark"] .ov-hero-shade {
      background: linear-gradient(180deg, rgba(12,22,42,0.92) 0%, rgba(12,22,42,0.78) 60%, rgba(12,22,42,0.4) 100%);
    }
  }
  .ov-hero-title { margin: 0; font-size: 1.35rem; font-weight: 750; letter-spacing: -0.025em; line-height: 1.2; }
  .ov-hero-sub { margin: 3px 0 10px; font-size: 0.86rem; opacity: 0.88; line-height: 1.35; max-width: 36ch; }
  .ov-hero-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #0f1f3d;
    font-size: 0.75rem;
    font-weight: 650;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }
  :root[data-theme="dark"] .ov-hero-date {
    background: rgba(15, 23, 42, 0.55);
    color: #e8eefc;
    border-color: rgba(255, 255, 255, 0.1);
  }
  .ov-hero .ov-refresh {
    background: rgba(255, 255, 255, 0.72);
    color: #0f1f3d;
    border: 1px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  :root[data-theme="dark"] .ov-hero .ov-refresh {
    background: rgba(15, 23, 42, 0.55);
    color: #e8eefc;
    border-color: rgba(255, 255, 255, 0.12);
  }
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const nowEl = document.getElementById('ov-now');
    if (nowEl) {
      const d = new Date();
      nowEl.textContent = d.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
  });
  </script>
</AppLayout>
