---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import type { UserRole } from '../lib/auth';

// SSR defaults (overridden client-side from session)
const defaultRole: UserRole = 'headoffice';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Dashboard"
  pageTitle="Dashboard"
  breadcrumb="Overview /"
  activeId="overview"
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="Bikash Gurung"
  roleLabel="Head Office Admin"
  branchName="Head Office"
  showBranchSwitcher={true}
>
  <div class="content-skeleton" id="content-skeleton">
    <div class="skeleton-placeholder">
      <p class="skeleton-title">Main content area</p>
      <p class="skeleton-hint" id="skeleton-hint">
        Active branch context will appear here.<br />
        Menu & data scope depend on role + branch.
      </p>
      <p class="skeleton-branch" id="skeleton-branch-info"></p>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSession,
    canSwitchBranch,
    getAccessibleBranches,
  } from '../lib/auth';

  const session = getSession();
  if (!session) {
    window.location.replace('/');
  } else {
    // Header profile
    const nameEl = document.querySelector('.profile-name');
    const subEl = document.querySelector('.profile-sub');
    if (nameEl) nameEl.textContent = session.displayName;
    if (subEl) {
      subEl.textContent = `${session.roleLabel} · ${session.activeBranchName}`;
    }

    // Branch label / context
    const branchLabel = document.getElementById('branch-label');
    if (branchLabel) {
      branchLabel.textContent = session.activeBranchName;
    }

    const hint = document.getElementById('skeleton-hint');
    const branchInfo = document.getElementById('skeleton-branch-info');

    if (session.role === 'headoffice') {
      if (hint) {
        hint.innerHTML =
          'You are logged in as <strong>Head Office</strong>.<br />Use the branch selector in the header to view any branch data.';
      }
    } else {
      if (hint) {
        hint.innerHTML =
          `You can only manage <strong>${session.homeBranchName}</strong> data.<br />Branch switch is disabled for your role.`;
      }
    }

    if (branchInfo) {
      branchInfo.textContent = `Active: ${session.activeBranchCode} — ${session.activeBranchName}`;
    }

    // Hide branch select for non-HO (header may still render the wrapper)
    const branchSelect = document.getElementById('branch-select') as HTMLSelectElement | null;
    if (branchSelect) {
      if (!canSwitchBranch(session)) {
        branchSelect.style.display = 'none';
      } else {
        const branches = getAccessibleBranches(session);
        branchSelect.innerHTML = branches
          .map(
            (b) =>
              `<option value="${b.code}" ${b.code === session.activeBranchCode ? 'selected' : ''}>${b.name} (${b.code})</option>`,
          )
          .join('');
      }
    }
  }
</script>
