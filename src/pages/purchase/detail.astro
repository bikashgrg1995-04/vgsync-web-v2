---
import AppLayout from "../../layouts/AppLayout.astro";
import PurchaseDialogs from "../../components/purchase/PurchaseDialogs.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../lib/navigation";
import { PAGE_META } from "../../lib/page-meta";
import type { UserRole } from "../../lib/auth";
import "../../styles/widgets/inventory-page.css";
import "../../styles/widgets/inventory-detail.css";
import "../../styles/widgets/purchase-shared.css";
import "../../styles/widgets/purchase-page.css";
import "../../styles/widgets/purchase-detail.css";
import Loading from '../../components/purchase-detail/Loading.astro';
import InvdTabs from '../../components/purchase-detail/InvdTabs.astro';
import DetailsPanel from '../../components/purchase-detail/DetailsPanel.astro';
import PaymentsPanel from '../../components/purchase-detail/PaymentsPanel.astro';
import DeliveriesPanel from '../../components/purchase-detail/DeliveriesPanel.astro';
import RelatedPanel from '../../components/purchase-detail/RelatedPanel.astro';

const meta = PAGE_META.purchase;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Purchase Detail"
  pageTitle={meta.title}
  breadcrumb="Purchase / Detail"
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page invd-page pud-page" id="pud-page">
    <a class="invd-back" href="/purchase">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
      Back to Purchase
    </a>

    <p class="inv-notice" id="pud-notice" hidden></p>

    <!-- PURCHASE HEADER -->
    <Loading />

    <!-- TABS -->
    <InvdTabs />

    <!-- TAB: PURCHASE DETAILS -->
    <DetailsPanel />

    <!-- TAB: PAYMENTS -->
    <PaymentsPanel />

    <!-- TAB: DELIVERIES -->
    <DeliveriesPanel />

    <!-- TAB: ACTIVITIES -->
    <section class="invd-panel" data-panel="activities">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Activities</h3>
        </div>
        <ul class="inv-activity" id="pud-activity">
          <li class="inv-activity-empty">Loading…</li>
        </ul>
      </div>
    </section>

    <!-- TAB: RELATED INFO -->
    <RelatedPanel />
  </div>

  <PurchaseDialogs />

  <dialog class="pu-dialog" id="dlg-due">
    <form method="dialog" class="pu-dialog-inner" id="form-due">
      <h2 class="pu-dialog-title">Payment due date</h2>
      <p class="pu-sub">When the supplier expects to be paid. You are reminded 3 days before.</p>
      <label class="pu-field"><span>Due date</span><input type="date" id="due-input" /></label>
      <p class="pu-error" id="due-error" hidden></p>
      <div class="pu-actions">
        <button type="button" class="btn-ghost-sm" id="due-clear">Clear</button>
        <button type="button" class="btn-ghost-sm" id="due-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="due-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import "../../scripts/pages/purchase-detail.ts";
</script>
