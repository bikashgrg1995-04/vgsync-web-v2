---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';
import PurchaseDialogs from '../components/purchase/PurchaseDialogs.astro';
import '../styles/widgets/purchase-shared.css';
import '../styles/widgets/purchase-page.css';
import Hero from '../components/purchase/Hero.astro';
import OverviewPanel from '../components/purchase/OverviewPanel.astro';
import ListPanel from '../components/purchase/ListPanel.astro';
import ReturnsPanel from '../components/purchase/ReturnsPanel.astro';
import CreditsPanel from '../components/purchase/CreditsPanel.astro';
import ImportPurchaseOrderDialog from '../components/purchase/ImportPurchaseOrderDialog.astro';
import UseSupplierCreditDialog from '../components/purchase/UseSupplierCreditDialog.astro';

const meta = PAGE_META.purchase;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="pu-page pd-page">
    <Hero />

    <p class="pu-notice" id="pu-notice" hidden></p>

    <!-- OVERVIEW -->
    <OverviewPanel />

    <!-- ALL PURCHASES -->
    <ListPanel />

    <!-- Returns -->
    <ReturnsPanel />

    <!-- Credit -->
    <CreditsPanel />
  </div>

  <PurchaseDialogs />

  <!-- Use credit -->
  <ImportPurchaseOrderDialog />

  <UseSupplierCreditDialog />
</AppLayout>

<script>
  import '../scripts/pages/purchase.ts';
</script>
