---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';
import '../styles/widgets/purchase-page.css';

const meta = PAGE_META.customers;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
import '../styles/pages/customers.css';
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="cus-page pd-page" id="cus-page">
    <header class="pd-hero">
      <div class="pd-hero-text">
        <div class="pd-hero-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.9"></path><path d="M16 3.1a4 4 0 0 1 0 7.8"></path></svg>
        </div>
        <div>
          <h2 class="pd-hero-title">Customers</h2>
          <p class="pd-hero-sub">Manage your customers and their information</p>
          <p class="cus-scope" id="cus-scope">Branch customers</p>
        </div>
      </div>
      <div class="pd-hero-actions">
        <button type="button" class="btn-primary-sm" id="cus-add">+ Add Customer</button>
        <a class="btn-ghost-sm pd-link-btn" href="/sales">Sales</a>
        <a class="btn-ghost-sm pd-link-btn" href="/payments">Payments</a>
      </div>
    </header>

    <p class="cus-form-error" id="cus-load-error" role="alert" hidden></p>

    <div class="pd-kpis cus-kpis">
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-blue" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.9"></path><path d="M16 3.1a4 4 0 0 1 0 7.8"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Total Customers</span>
          <div class="pd-kpi-row"><strong id="kpi-total">—</strong></div>
          <span class="pd-kpi-sub" id="kpi-total-sub"></span>
        </div>
      </article>
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-green" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Active Customers</span>
          <div class="pd-kpi-row"><strong id="kpi-active">—</strong></div>
          <span class="pd-kpi-sub" id="kpi-active-sub"></span>
        </div>
      </article>
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-purple" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M10 9v6M14 9v6"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Inactive Customers</span>
          <div class="pd-kpi-row"><strong id="kpi-inactive">—</strong></div>
          <span class="pd-kpi-sub" id="kpi-inactive-sub"></span>
        </div>
      </article>
      <article class="pd-kpi  is-danger">
        <span class="pd-kpi-icon is-red" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">With Dues</span>
          <div class="pd-kpi-row"><strong id="kpi-dues">—</strong></div>
          <span class="pd-kpi-sub" id="kpi-dues-sub"></span>
        </div>
      </article>
    </div>

    <div class="cus-layout">
      <section class="cus-list-panel pd-card">
        <div class="cus-dir-head">
          <h3>Customer Directory</h3>
          <span class="cus-count-chip" id="cus-count-chip">0 customers</span>
        </div>
        <div class="cus-filters">
          <div class="cus-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" id="cus-search" placeholder="Search customer by name, phone or email…" autocomplete="off" />
          </div>
          <select id="cus-status-filter" aria-label="Status">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
          <select id="cus-type-filter" aria-label="Customer type">
            <option value="">All Customer Type</option>
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
          <label class="cus-dues-toggle">
            <input type="checkbox" id="cus-dues-filter" />
            <span>Has dues</span>
          </label>
        </div>

        <div class="cus-table-wrap">
          <table class="cus-table cus-dir">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Type</th>
                <th>Contact</th>
                <th class="num">Owes you</th>
                <th>Status</th>
                <th class="cus-actions-h">Actions</th>
              </tr>
            </thead>
            <tbody id="cus-tbody">
              <tr><td colspan="6">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <div class="cus-pager">
          <p class="cus-footnote" id="cus-count"></p>
          <nav class="cus-pages" id="cus-pages" aria-label="Pages"></nav>
        </div>
      </section>

      <aside class="cus-detail pd-card" id="cus-detail">
        <div class="cus-detail-empty" id="cus-detail-empty">
          <p>Select a customer to view details</p>
          <p class="muted">Used in Sales, receipts and ledgers</p>
        </div>

        <div class="cus-detail-body" id="cus-detail-body" hidden>
          <div class="cus-drawer-top">
            <h3>Customer Details</h3>
            <button type="button" class="cus-x" id="cus-close" aria-label="Close details">✕</button>
          </div>

          <div class="cus-profile">
            <span class="cus-avatar big" id="d-avatar" aria-hidden="true"></span>
            <div>
              <div class="cus-profile-name"><h4 id="d-name">—</h4><span class="cus-badge" id="d-status">—</span></div>
              <p class="cus-detail-code" id="d-code">—</p>
              <p class="cus-profile-type" id="d-type-line">—</p>
            </div>
          </div>

          <div class="cus-detail-actions">
            <button type="button" class="btn-ghost-sm" id="cus-statement">Statement</button>
            <button type="button" class="btn-ghost-sm is-danger" id="cus-toggle">Deactivate</button>
          </div>

          <p class="cus-limit-warn" id="d-limit-warn" role="status" hidden>
            Owes more than the credit limit. Sales are still allowed.
          </p>

          <div class="cus-tabs" role="tablist">
            <button type="button" role="tab" class="is-active" data-tab="overview">Overview</button>
            <button type="button" role="tab" data-tab="history">Purchase History</button>
            <button type="button" role="tab" data-tab="statement">Statement</button>
          </div>

          <div class="cus-tabpanel" data-panel="overview">
            <section class="cus-card">
              <header><h4>Personal Information</h4><button type="button" class="btn-ghost-sm" id="cus-edit">✎ Edit</button></header>
              <dl class="cus-kv">
                <div><dt>Full Name</dt><dd id="d-fullname">—</dd></div>
                <div><dt>Phone</dt><dd id="d-phone">—</dd></div>
                <div><dt>Email</dt><dd id="d-email">—</dd></div>
                <div><dt>Address</dt><dd id="d-address">—</dd></div>
                <div><dt>PAN</dt><dd id="d-pan">—</dd></div>
                <div><dt>Customer Type</dt><dd id="d-type">—</dd></div>
                <div><dt>Created At</dt><dd id="d-created">—</dd></div>
                <div><dt>Notes</dt><dd id="d-notes">—</dd></div>
              </dl>
            </section>

            <section class="cus-card">
              <header><h4>Customer Statistics</h4></header>
              <div class="cus-stats">
                <div><span>Total Purchases</span><strong id="d-total">—</strong></div>
                <div><span>This Year</span><strong id="d-year">—</strong></div>
                <div><span>Last Purchase</span><strong id="d-last">—</strong></div>
              </div>
              <dl class="cus-kv tight">
                <div><dt>Owes you</dt><dd id="d-owes">—</dd></div>
                <div><dt>Credit limit</dt><dd id="d-credit">—</dd></div>
                <div><dt>You owe them</dt><dd id="d-credit-to-pay">—</dd></div>
                <div><dt>Advance received</dt><dd id="d-advance">—</dd></div>
                <div><dt>Replacement due</dt><dd id="d-stock">—</dd></div>
              </dl>
            </section>

            <section class="cus-card">
              <header><h4>This Month Purchase</h4><button type="button" class="cus-link" data-goto="history">View All →</button></header>
              <div id="d-month"></div>
            </section>

            <section class="cus-card">
              <header><h4>Recent Purchase Records</h4><button type="button" class="cus-link" data-goto="history">View All →</button></header>
              <div id="d-recent"></div>
            </section>
            <p class="cus-detail-meta" id="d-meta"></p>
          </div>

          <div class="cus-tabpanel" data-panel="history" hidden>
            <section class="cus-card">
              <header><h4>Purchase History</h4></header>
              <div id="d-history"></div>
            </section>
          </div>

          <div class="cus-tabpanel" data-panel="statement" hidden>
            <section class="cus-stmt" aria-label="Statement">
            <div class="cus-stmt-head">
              <h4>Statement</h4>
              <div class="cus-stmt-actions">
                <button type="button" class="btn-ghost-sm" id="stmt-xlsx">Excel</button>
                <button type="button" class="btn-ghost-sm" id="stmt-pdf">PDF</button>
              </div>
            </div>
            <div class="cus-stmt-filters">
              <label><span>From</span><input type="date" id="stmt-from" /></label>
              <label><span>To</span><input type="date" id="stmt-to" /></label>
              <label>
                <span>Type</span>
                <select id="stmt-type">
                  <option value="">All</option>
                  <option value="sale">Sales</option>
                  <option value="payment">Payments</option>
                  <option value="return">Returns</option>
                  <option value="refund">Refunds</option>
                  <option value="replacement">Replacements</option>
                  <option value="adjustment">Credit adjustments</option>
                </select>
              </label>
            </div>
            <p class="cus-stmt-error" id="stmt-error" role="alert" hidden></p>
            <p class="cus-stmt-totals" id="stmt-totals"></p>
            <div class="cus-stmt-wrap">
              <table class="cus-stmt-table">
                <thead>
                  <tr><th>Date</th><th>Type</th><th>Reference</th><th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th></tr>
                </thead>
                <tbody id="stmt-tbody"></tbody>
              </table>
            </div>
            <button type="button" class="btn-ghost-sm" id="stmt-more" hidden>Load more</button>
            <p class="cus-hint" id="stmt-hint">Positive balance: the customer owes you. Negative: you owe the customer.</p>
          </section>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <dialog class="cus-dialog" id="cus-dialog">
    <form class="cus-dialog-inner" id="cus-form">
      <h2 class="cus-dialog-title" id="cus-form-title">New customer</h2>
      <input type="hidden" id="f-id" />

      <div class="cus-form-grid">
        <label class="cus-field span2">
          <span>Name *</span>
          <input type="text" id="f-name" required placeholder="Full name or company" />
        </label>
        <label class="cus-field">
          <span>Type</span>
          <select id="f-type">
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Status</span>
          <select id="f-status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Phone</span>
          <input type="tel" id="f-phone" placeholder="98XXXXXXXX (optional)" />
        </label>
        <label class="cus-field">
          <span>Email</span>
          <input type="email" id="f-email" placeholder="optional" />
        </label>
        <label class="cus-field span2">
          <span>Address</span>
          <input type="text" id="f-address" />
        </label>
        <label class="cus-field">
          <span>PAN / VAT number</span>
          <input type="text" id="f-pan" placeholder="optional" />
        </label>
        <label class="cus-field">
          <span>Credit limit (NPR)</span>
          <input type="number" id="f-credit" min="0" step="1000" value="0" />
          <small class="cus-field-hint">0 means no limit. Going over only shows a warning.</small>
        </label>
        <label class="cus-field span2">
          <span>Notes</span>
          <input type="text" id="f-notes" />
        </label>
      </div>

      <p class="cus-form-error" id="f-error" hidden></p>

      <div class="cus-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="f-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="f-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import '../scripts/pages/customers.ts';
</script>
