
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="VGSync | Business Management">
	<main class="flex min-h-screen items-center justify-center bg-slate-950 p-6">
		<div class="text-center">
			<h1 class="text-5xl font-bold tracking-tight text-white">
				VGSync
			</h1>

			<p class="mt-4 text-lg text-slate-400">
				Business Management Platform
			</p>

			<div class="mt-8 inline-flex rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white">
				Frontend foundation ready
			</div>
		</div>
	</main>
</Layout>
