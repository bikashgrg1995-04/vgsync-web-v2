
---
import Layout from '../layouts/Layout.astro';

import ThemeToggle from '../components/common/ThemeToggle.astro';

import BackgroundAnimation from '../components/login/BackgroundAnimation.astro';
import LoginShowcase from '../components/login/LoginShowcase.astro';
import LoginForm from '../components/login/LoginForm.astro';

import '../styles/login/login.css';
---

<Layout title="VG Automobiles | Business Management">
    <main class="login-page">
        <BackgroundAnimation variant="page" />

        <ThemeToggle />

        <div class="login-shell">
            <LoginShowcase />
            <LoginForm />
        </div>
    </main>
</Layout>

<script>
    import '../scripts/login.ts';
</script>
