---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';
import SalesDialogs from '../components/sales/SalesDialogs.astro';
import '../styles/widgets/sales-shared.css';
import '../styles/widgets/purchase-page.css';
import '../styles/pages/sales-page.css';
import Hero from '../components/sales/Hero.astro';
import OverviewPanel from '../components/sales/OverviewPanel.astro';
import ListPanel from '../components/sales/ListPanel.astro';
import ReturnsPanel from '../components/sales/ReturnsPanel.astro';
import CreditsPanel from '../components/sales/CreditsPanel.astro';
import FollowupsPanel from '../components/sales/FollowupsPanel.astro';
import BikesPanel from '../components/sales/BikesPanel.astro';
import UseCustomerCreditDialog from '../components/sales/UseCustomerCreditDialog.astro';
import MarkFollowUpDoneDialog from '../components/sales/MarkFollowUpDoneDialog.astro';
import RegisterBikeDialog from '../components/sales/RegisterBikeDialog.astro';
import AddLocalProductDialog from '../components/sales/AddLocalProductDialog.astro';

const meta = PAGE_META.sales;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="sa-page pd-page">
    <Hero />

    <p class="sa-notice" id="sa-notice" hidden></p>

    <!-- OVERVIEW -->
    <OverviewPanel />

    <!-- ALL SALES -->
    <ListPanel />


    <!-- Returns -->
    <ReturnsPanel />

    <!-- Credit -->
    <CreditsPanel />

    <!-- Follow-ups -->
    <FollowupsPanel />

    <!-- Bikes + local products -->
    <BikesPanel />
  </div>

  <SalesDialogs />

  <!-- Use credit -->
  <UseCustomerCreditDialog />

  <!-- Follow-up done -->
  <MarkFollowUpDoneDialog />

  <!-- Register bike -->
  <RegisterBikeDialog />

  <!-- Local product -->
  <AddLocalProductDialog />
</AppLayout>

<script>
  import '../scripts/pages/sales.ts';
</script>
