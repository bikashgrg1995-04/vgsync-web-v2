---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import type { UserRole } from '../../lib/auth';

const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Update Password"
  pageTitle="Update Password"
  breadcrumb="Security /"
  activeId="settings"
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="auth-card" id="change-password-card">
    <h2 class="auth-card-title">Update your password</h2>
    <p class="auth-card-sub">
      First-time login requires a new password before you can use VGSync.
    </p>

    <form id="change-password-form" class="auth-form" novalidate>
      <label class="auth-field">
        <span>Current password</span>
        <input type="password" name="current" required autocomplete="current-password" />
      </label>
      <label class="auth-field">
        <span>New password</span>
        <input type="password" name="next" required autocomplete="new-password" />
      </label>
      <label class="auth-field">
        <span>Confirm new password</span>
        <input type="password" name="confirm" required autocomplete="new-password" />
      </label>

      <p class="auth-message" id="cp-message" hidden></p>

      <button type="submit" class="auth-submit">Save password</button>
    </form>
  </div>
</AppLayout>

<script>
  import { getSession, changePassword, ApiError } from '../../lib/auth';

  const form = document.getElementById('change-password-form') as HTMLFormElement | null;
  const msg = document.getElementById('cp-message');
  const sub = document.querySelector('.auth-card-sub');
  const submit = form?.querySelector<HTMLButtonElement>('.auth-submit');

  if (sub && getSession() && !getSession()?.mustChangePassword) {
    sub.textContent = 'You will be signed out on every device and asked to sign in with the new password.';
  }

  function showMsg(text: string, ok = false): void {
    if (!msg) return;
    msg.hidden = false;
    msg.textContent = text;
    msg.classList.toggle('is-ok', ok);
    msg.classList.toggle('is-err', !ok);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!getSession()) {
      window.location.href = '/';
      return;
    }

    const data = new FormData(form);
    const current = String(data.get('current') || '');
    const next = String(data.get('next') || '');
    const confirm = String(data.get('confirm') || '');

    if (!current || !next) {
      showMsg('Please fill in all fields.');
      return;
    }
    if (next !== confirm) {
      showMsg('New passwords do not match.');
      return;
    }

    if (submit) submit.disabled = true;
    try {
      await changePassword(current, next, confirm);
      showMsg('Password updated. Please sign in again…', true);
      setTimeout(() => window.location.replace('/?notice=password-changed'), 800);
    } catch (error) {
      showMsg(error instanceof ApiError ? error.message : 'Something went wrong. Please try again.');
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  .auth-card {
    max-width: 420px;
    margin: 12px auto;
    padding: 24px 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--panel-bg);
  }
  .auth-card-title {
    margin: 0 0 6px;
    font-size: 1.1rem;
    font-weight: 650;
  }
  .auth-card-sub {
    margin: 0 0 18px;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .auth-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .auth-field input {
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.9rem;
  }
  .auth-field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .auth-submit {
    margin-top: 4px;
    height: 40px;
    border: none;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
  }
  .auth-message {
    margin: 0;
    font-size: 0.82rem;
  }
  .auth-message.is-err { color: #ef334e; }
  .auth-message.is-ok { color: var(--success, #22c55e); }
</style>
