---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import type { UserRole } from '../../lib/auth';
import '../../styles/app/purchase-page.css';

const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Staff"
  pageTitle="Staff"
  breadcrumb="Staff /"
  activeId="staff"
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Owner"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="st-page">
    <header class="pd-hero">
      <div class="pd-hero-text">
        <div class="pd-hero-icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.9"></path><path d="M16 3.1a4 4 0 0 1 0 7.8"></path></svg></div>
        <div>
          <h2 class="pd-hero-title">Staff Management</h2>
          <p class="pd-hero-sub">Manage your team, positions, salary and access.</p>
          <p class="st-scope" id="st-scope">Team</p>
        </div>
      </div>
      <div class="pd-hero-actions">
        <div class="st-tabs" role="tablist" aria-label="Staff sections">
          <button type="button" role="tab" id="tab-team" aria-selected="true" aria-controls="panel-team">Team</button>
          <button type="button" role="tab" id="tab-positions" aria-selected="false" aria-controls="panel-positions">Positions</button>
        </div>
        <button type="button" class="btn-primary-sm" id="member-add">+ Add Staff</button>
      </div>
    </header>

    <div class="pd-kpis st-kpis" id="st-kpis">
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-blue"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.9"></path><path d="M16 3.1a4 4 0 0 1 0 7.8"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Total Staff</span>
          <div class="pd-kpi-row"><strong id="kpi-total">—</strong></div>
          <span class="pd-kpi-sub">Team members</span>
        </div>
      </article>
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-green"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Active Staff</span>
          <div class="pd-kpi-row"><strong id="kpi-active">—</strong></div>
          <span class="pd-kpi-sub">Can sign in</span>
        </div>
      </article>
      <article class="pd-kpi">
        <span class="pd-kpi-icon is-red"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M10 15V9"></path><path d="M14 15V9"></path></svg></span>
        <div class="pd-kpi-body">
          <span class="pd-kpi-label">Inactive Staff</span>
          <div class="pd-kpi-row"><strong id="kpi-inactive">—</strong></div>
          <span class="pd-kpi-sub">Deactivated accounts</span>
        </div>
      </article>
    </div>

    <p class="st-banner" id="st-banner" role="alert" hidden></p>

    <!-- TEAM -->
    <section class="st-panel pd-card" id="panel-team" role="tabpanel" aria-labelledby="tab-team">
      <div class="st-dir-head">
        <h3 class="st-dir-title">Staff Directory <span class="st-pill" id="st-pill">0 members</span></h3>
        <div class="st-view" role="group" aria-label="View">
          <button type="button" class="st-view-btn" data-view="grid" aria-label="Card view" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </button>
          <button type="button" class="st-view-btn is-active" data-view="list" aria-label="List view" aria-pressed="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
          </button>
        </div>
      </div>

      <div class="st-filters">
        <div class="st-search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="st-search" placeholder="Search by name, username or contact…" autocomplete="off" aria-label="Search team" />
        </div>
        <select id="st-status-filter" aria-label="Filter by status">
          <option value="">All Status</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        <select id="st-position-filter" aria-label="Filter by position">
          <option value="">All Positions</option>
        </select>
        <select id="st-role-filter" aria-label="Filter by role">
          <option value="">All Roles</option>
          <option value="admin">Admin</option>
          <option value="accountant">Accountant</option>
          <option value="staff">Staff</option>
        </select>
      </div>

      <div id="st-directory">
        <div class="st-table-wrap" id="st-list-view">
          <table class="st-table">
            <thead>
              <tr>
                <th>Staff</th>
                <th>Position</th>
                <th>Role</th>
                <th>Contact</th>
                <th>Join Date</th>
                <th>Status</th>
                <th class="st-th-actions">Actions</th>
              </tr>
            </thead>
            <tbody id="member-tbody"><tr><td colspan="7">Loading…</td></tr></tbody>
          </table>
        </div>
        <div class="st-grid" id="st-grid-view" hidden></div>
      </div>

      <div class="st-foot">
        <p class="st-footnote" id="member-count"></p>
        <div class="st-pages" id="st-pages"></div>
      </div>
    </section>

    <!-- POSITIONS -->
    <section class="st-panel" id="panel-positions" role="tabpanel" aria-labelledby="tab-positions" hidden>
      <div class="st-panel-head">
        <p class="st-hint">A position decides what a staff member can see and do in each module. Staff must have one.</p>
        <button type="button" class="btn-primary-sm" id="position-add">+ New position</button>
      </div>
      <div class="st-table-wrap">
        <table class="st-table">
          <thead>
            <tr>
              <th>Position</th>
              <th>Access</th>
              <th class="num">Active staff</th>
              <th>Status</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody id="position-tbody"><tr><td colspan="5">Loading…</td></tr></tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Member dialog -->
  <dialog class="st-dialog" id="member-dialog" aria-labelledby="member-title">
    <form class="st-dialog-inner" id="member-form" novalidate>
      <h2 class="st-dialog-title" id="member-title">Add team member</h2>
      <input type="hidden" id="m-id" />
      <div class="st-form-grid">
        <label class="st-field"><span>First name *</span><input type="text" id="m-first" autocomplete="off" /></label>
        <label class="st-field"><span>Last name</span><input type="text" id="m-last" autocomplete="off" /></label>
        <label class="st-field span2"><span>Username *</span><input type="text" id="m-username" autocomplete="off" autocapitalize="none" spellcheck="false" /></label>
        <label class="st-field"><span>Email</span><input type="email" id="m-email" autocomplete="off" /></label>
        <label class="st-field"><span>Phone</span><input type="tel" id="m-phone" autocomplete="off" /></label>
        <label class="st-field">
          <span>Role *</span>
          <select id="m-role">
            <option value="staff">Staff</option>
            <option value="accountant">Accountant</option>
            <option value="admin">Admin</option>
          </select>
        </label>
        <label class="st-field" id="m-position-wrap">
          <span>Position *</span>
          <select id="m-position"></select>
        </label>
        <label class="st-field span2" id="m-password-wrap">
          <span>Temporary password</span>
          <input type="text" id="m-password" autocomplete="off" placeholder="Leave empty to generate one" />
        </label>
      </div>
      <p class="st-hint" id="m-hint">The person must choose a new password the first time they sign in.</p>
      <p class="st-error" id="m-error" role="alert" hidden></p>
      <div class="st-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="m-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="m-save">Save</button>
      </div>
    </form>
  </dialog>

  <!-- Temporary password shown once -->
  <dialog class="st-dialog" id="secret-dialog" aria-labelledby="secret-title">
    <div class="st-dialog-inner">
      <h2 class="st-dialog-title" id="secret-title">Temporary password</h2>
      <p class="st-hint" id="secret-who"></p>
      <div class="st-secret">
        <code id="secret-value"></code>
        <button type="button" class="btn-ghost-sm" id="secret-copy">Copy</button>
      </div>
      <p class="st-warn">Shown only once. Give it to the person now; they must change it when they sign in.</p>
      <div class="st-dialog-actions">
        <button type="button" class="btn-primary-sm" id="secret-close">Done</button>
      </div>
    </div>
  </dialog>

  <!-- Position dialog -->
  <dialog class="st-dialog st-dialog-wide" id="position-dialog" aria-labelledby="position-title">
    <form class="st-dialog-inner" id="position-form" novalidate>
      <h2 class="st-dialog-title" id="position-title">New position</h2>
      <input type="hidden" id="p-id" />
      <div class="st-form-grid">
        <label class="st-field"><span>Name *</span><input type="text" id="p-name" autocomplete="off" placeholder="e.g. Sales counter" /></label>
        <label class="st-field"><span>Description</span><input type="text" id="p-desc" autocomplete="off" /></label>
      </div>
      <div class="st-table-wrap st-perm-wrap">
        <table class="st-table st-perm">
          <thead>
            <tr><th>Module</th><th>View</th><th>Create</th><th>Edit</th><th>Delete</th></tr>
          </thead>
          <tbody id="perm-tbody"></tbody>
        </table>
      </div>
      <p class="st-hint">Create, edit and delete need View as well.</p>
      <p class="st-error" id="p-error" role="alert" hidden></p>
      <div class="st-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="p-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="p-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import { paintAvatar } from '../../lib/avatar';
  import { getSession, canManageStaff, canEditPositions, refreshProfile } from '../../lib/auth';
  import { ApiError } from '../../lib/api';
  import {
    MODULES,
    ROLE_LABEL,
    listStaff,
    createStaff,
    updateStaff,
    deactivateStaff,
    reactivateStaff,
    resetStaffPassword,
    listPositions,
    createPosition,
    updatePosition,
    setPositionActive,
    deletePosition,
    type StaffMember,
    type StaffRole,
    type Position,
    type PositionPermission,
  } from '../../lib/staff';

  const session = getSession();
  if (!session) {
    window.location.replace('/');
  } else if (!canManageStaff(session)) {
    // Only the owner, or staff with the Administration position, manage staff.
    window.location.replace('/dashboard');
  }

  let members: StaffMember[] = [];
  let positions: Position[] = [];
  let canWrite = true;
  let canEditPos = true;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const val = (id: string) => ($<HTMLInputElement>(id)?.value ?? '').trim();

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  const FIELD_LABELS: Record<string, string> = {
    username: 'Username',
    first_name: 'First name',
    last_name: 'Last name',
    email: 'Email',
    phone: 'Phone',
    role: 'Role',
    position: 'Position',
    password: 'Password',
    name: 'Name',
    description: 'Description',
    permissions: 'Permissions',
    is_active: 'Status',
  };

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    const entries = Object.entries(error.fields);
    if (entries.length > 0 && error.status === 400) {
      return entries.map(([k, m]) => `${FIELD_LABELS[k] ?? k}: ${m}`).join(' ');
    }
    return error.message;
  }

  function banner(message: string | null): void {
    const el = $('st-banner');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  // ---------- tabs ----------

  function selectTab(name: 'team' | 'positions'): void {
    for (const t of ['team', 'positions'] as const) {
      $(`tab-${t}`)?.setAttribute('aria-selected', String(t === name));
      const panel = $(`panel-${t}`);
      if (panel) panel.hidden = t !== name;
    }
  }
  $('tab-team')?.addEventListener('click', () => selectTab('team'));
  $('tab-positions')?.addEventListener('click', () => selectTab('positions'));

  // ---------- team table ----------

  function filteredMembers(): StaffMember[] {
    const q = val('st-search').toLowerCase();
    const role = $<HTMLSelectElement>('st-role-filter')?.value ?? '';
    const status = $<HTMLSelectElement>('st-status-filter')?.value ?? '';
    const pos = $<HTMLSelectElement>('st-position-filter')?.value ?? '';
    return members.filter((m) => {
      if (role && m.role !== role) return false;
      if (pos && String(m.positionId ?? '') !== pos) return false;
      if (status === 'active' && !m.isActive) return false;
      if (status === 'inactive' && m.isActive) return false;
      if (!q) return true;
      return (
        m.name.toLowerCase().includes(q) ||
        m.username.toLowerCase().includes(q) ||
        m.phone.includes(q) ||
        m.email.toLowerCase().includes(q)
      );
    });
  }

  function statusOf(m: StaffMember): { label: string; cls: string } {
    if (!m.isActive) return { label: 'Inactive', cls: 'inactive' };
    if (m.mustChangePassword) return { label: 'Password pending', cls: 'pending' };
    return { label: 'Active', cls: 'active' };
  }

  const PAGE_SIZE = 8;
  let page = 1;
  let view: 'list' | 'grid' = 'list';
  try {
    if (localStorage.getItem('vgsync-staff-view') === 'grid') view = 'grid';
  } catch { /* ignore */ }

  const I = (d: string) =>
    `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
  const ICON_EYE = I('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>');
  const ICON_EDIT = I('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>');
  const ICON_MORE = I('<circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>');
  const ICON_PHONE = I('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>');
  const ICON_MAIL = I('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>');

  function fmtJoin(iso: string): string {
    return iso ? new Date(iso).toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
  }

  function contactHtml(m: StaffMember): string {
    const phone = m.phone ? `<span>${ICON_PHONE}${esc(m.phone)}</span>` : '';
    const mail = m.email ? `<span>${ICON_MAIL}${esc(m.email)}</span>` : '';
    return phone || mail ? `<div class="st-contact">${phone}${mail}</div>` : '<span class="st-sub">—</span>';
  }

  function actionsHtml(m: StaffMember): string {
    const more = canWrite
      ? `<div class="st-more">
          <button type="button" class="st-icon-btn" data-act="more" data-id="${m.id}" aria-label="More actions" aria-haspopup="menu">${ICON_MORE}</button>
          <div class="st-menu" role="menu" hidden>
            <button type="button" role="menuitem" data-act="reset" data-id="${m.id}">Reset password</button>
            <button type="button" role="menuitem" class="${m.isActive ? 'is-danger' : ''}" data-act="${m.isActive ? 'deactivate' : 'reactivate'}" data-id="${m.id}">${m.isActive ? 'Deactivate' : 'Reactivate'}</button>
          </div>
        </div>`
      : '';
    const edit = canWrite
      ? `<button type="button" class="st-icon-btn is-edit" data-act="edit" data-id="${m.id}" aria-label="Edit ${esc(m.name)}" title="Edit">${ICON_EDIT}</button>`
      : '';
    return `<div class="st-actions"><a class="st-icon-btn" href="/dashboard/staff/detail?id=${m.id}" aria-label="View ${esc(m.name)}" title="View">${ICON_EYE}</a>${edit}${more}</div>`;
  }

  function avatarHtml(m: StaffMember, cls = ''): string {
    return `<span class="st-avatar ${cls}" data-avatar="${m.id}" data-name="${esc(m.name)}"></span>`;
  }

  function paintAvatars(root: ParentNode): void {
    root.querySelectorAll<HTMLElement>('[data-avatar]').forEach((el) =>
      paintAvatar(el, el.dataset.avatar ?? '', el.dataset.name ?? ''),
    );
  }

  function renderKpis(): void {
    const active = members.filter((m) => m.isActive).length;
    $('kpi-total')!.textContent = String(members.length);
    $('kpi-active')!.textContent = String(active);
    $('kpi-inactive')!.textContent = String(members.length - active);
  }

  function renderPager(totalPages: number): void {
    const el = $('st-pages');
    if (!el) return;
    if (totalPages <= 1) {
      el.innerHTML = '';
      return;
    }
    const nums: Array<number | '…'> = [];
    for (let n = 1; n <= totalPages; n++) {
      if (n === 1 || n === totalPages || Math.abs(n - page) <= 1) nums.push(n);
      else if (nums[nums.length - 1] !== '…') nums.push('…');
    }
    el.innerHTML =
      `<button type="button" data-page="${page - 1}" ${page === 1 ? 'disabled' : ''} aria-label="Previous page">‹</button>` +
      nums
        .map((n) =>
          n === '…'
            ? '<span>…</span>'
            : `<button type="button" data-page="${n}" class="${n === page ? 'is-active' : ''}">${n}</button>`,
        )
        .join('') +
      `<button type="button" data-page="${page + 1}" ${page === totalPages ? 'disabled' : ''} aria-label="Next page">›</button>`;
  }

  function renderMembers(): void {
    const tbody = $('member-tbody');
    const grid = $('st-grid-view');
    const count = $('member-count');
    if (!tbody || !grid) return;
    renderKpis();
    const all = filteredMembers();
    const pill = $('st-pill');
    if (pill) pill.textContent = `${members.length} member${members.length === 1 ? '' : 's'}`;

    $('st-list-view')!.hidden = view !== 'list';
    grid.hidden = view !== 'grid';
    document.querySelectorAll<HTMLButtonElement>('.st-view-btn').forEach((b) => {
      const on = b.dataset.view === view;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });

    const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
    if (page > totalPages) page = totalPages;
    const rows = all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

    if (all.length === 0) {
      const msg = members.length ? 'No one matches.' : 'No team members yet.';
      tbody.innerHTML = `<tr><td colspan="7" class="st-empty">${msg}</td></tr>`;
      grid.innerHTML = `<p class="st-empty">${msg}</p>`;
      if (count) count.textContent = '';
      renderPager(1);
      return;
    }

    tbody.innerHTML = rows
      .map((m) => {
        const st = statusOf(m);
        return `<tr>
          <td><a class="st-person" href="/dashboard/staff/detail?id=${m.id}">${avatarHtml(m)}<span><strong>${esc(m.name)}</strong><span class="st-sub">${esc(m.username)}</span></span></a></td>
          <td>${esc(m.positionName) || '—'}</td>
          <td>${esc(ROLE_LABEL[m.role] ?? m.role)}</td>
          <td>${contactHtml(m)}</td>
          <td>${esc(fmtJoin(m.dateJoined))}</td>
          <td><span class="st-badge st-badge-${st.cls}">${st.label}</span></td>
          <td>${actionsHtml(m)}</td>
        </tr>`;
      })
      .join('');

    grid.innerHTML = rows
      .map((m) => {
        const st = statusOf(m);
        return `<article class="st-card">
          <div class="st-card-top">${avatarHtml(m, 'is-lg')}<span class="st-badge st-badge-${st.cls}">${st.label}</span></div>
          <a class="st-card-name" href="/dashboard/staff/detail?id=${m.id}">${esc(m.name)}</a>
          <span class="st-sub">${esc(m.username)} · ${esc(ROLE_LABEL[m.role] ?? m.role)}</span>
          <span class="st-card-pos">${esc(m.positionName) || '—'}</span>
          ${contactHtml(m)}
          <div class="st-card-foot"><span class="st-sub">Joined ${esc(fmtJoin(m.dateJoined))}</span>${actionsHtml(m)}</div>
        </article>`;
      })
      .join('');

    paintAvatars(tbody);
    paintAvatars(grid);
    if (count) {
      const from = (page - 1) * PAGE_SIZE + 1;
      count.textContent = `Showing ${from}–${from + rows.length - 1} of ${all.length} staff`;
    }
    renderPager(totalPages);
  }

  // ---------- positions table ----------

  function accessSummary(p: Position): string {
    const modules = p.permissions.filter((x) => x.canView);
    if (modules.length === 0) return 'No access';
    return modules
      .map((x) => MODULES.find((m) => m.id === x.module)?.label ?? x.module)
      .join(', ');
  }

  function renderPositions(): void {
    const tbody = $('position-tbody');
    if (!tbody) return;
    if (positions.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="st-empty">No positions yet. Create one before adding staff.</td></tr>';
      return;
    }
    tbody.innerHTML = positions
      .map((p) => {
        const actions = canEditPos
          ? `<div class="st-actions">
              <button type="button" class="btn-ghost-sm" data-pact="edit" data-id="${p.id}">Edit</button>
              <button type="button" class="btn-ghost-sm" data-pact="${p.isActive ? 'deactivate' : 'activate'}" data-id="${p.id}">${p.isActive ? 'Deactivate' : 'Activate'}</button>
              <button type="button" class="btn-ghost-sm is-danger" data-pact="delete" data-id="${p.id}">Delete</button>
            </div>`
          : '';
        return `<tr>
          <td><strong>${esc(p.name)}</strong>${p.description ? `<br /><span class="st-sub">${esc(p.description)}</span>` : ''}</td>
          <td class="st-access">${esc(accessSummary(p))}</td>
          <td class="num">${p.staffCount}</td>
          <td><span class="st-badge st-badge-${p.isActive ? 'active' : 'inactive'}">${p.isActive ? 'Active' : 'Inactive'}</span></td>
          <td>${actions}</td>
        </tr>`;
      })
      .join('');
  }

  // ---------- load ----------

  function applyWriteAccess(): void {
    // A company owner is read-only inside a branch.
    const current = getSession();
    canWrite = current?.accessMode !== 'read_only';
    // Positions are changed by the owner only; others can read them.
    canEditPos = canWrite && canEditPositions(current);
    const add = $('member-add');
    if (add) add.hidden = !canWrite;
    const addPosition = $('position-add');
    if (addPosition) addPosition.hidden = !canEditPos;
    // Someone who is not the owner manages staff accounts only.
    const roleSelect = $<HTMLSelectElement>('m-role');
    if (roleSelect) {
      const owner = canEditPositions(current);
      for (const option of Array.from(roleSelect.options)) {
        option.hidden = !owner && option.value !== 'staff';
        option.disabled = !owner && option.value !== 'staff';
      }
      if (!owner) roleSelect.value = 'staff';
    }
    const roleFilter = $<HTMLSelectElement>('st-role-filter');
    if (roleFilter && !canEditPositions(current)) roleFilter.hidden = true;
  }

  async function reload(): Promise<void> {
    const s = getSession();
    const scope = $('st-scope');
    if (scope && s) scope.textContent = `${s.activeBranchName} (${s.activeBranchCode})`;
    applyWriteAccess();

    try {
      [members, positions] = await Promise.all([listStaff(), listPositions()]);
      banner(
        !canWrite
          ? 'Read-only: you are viewing this branch from Head Office.'
          : !canEditPos
            ? 'You can manage staff accounts. Positions are changed by the owner.'
            : null,
      );
    } catch (error) {
      members = [];
      positions = [];
      banner(describe(error));
    }
    fillPositionFilter();
    renderMembers();
    renderPositions();
    openEditFromUrl();
  }

  function fillPositionFilter(): void {
    const select = $<HTMLSelectElement>('st-position-filter');
    if (!select) return;
    const current = select.value;
    select.innerHTML =
      '<option value="">All Positions</option>' +
      positions.map((p) => `<option value="${p.id}">${esc(p.name)}</option>`).join('');
    select.value = current;
  }

  let editHandled = false;
  function openEditFromUrl(): void {
    if (editHandled) return;
    editHandled = true;
    const id = Number(new URLSearchParams(window.location.search).get('edit'));
    const target = id ? members.find((m) => m.id === id) : null;
    if (target && canWrite) openMember(target);
  }

  // ---------- member dialog ----------

  const memberDialog = $<HTMLDialogElement>('member-dialog');
  const secretDialog = $<HTMLDialogElement>('secret-dialog');

  function fillPositionSelect(selectedId: number | null): void {
    const select = $<HTMLSelectElement>('m-position');
    if (!select) return;
    const usable = positions.filter((p) => p.isActive || p.id === selectedId);
    select.innerHTML =
      usable.length === 0
        ? '<option value="">Create a position first</option>'
        : usable.map((p) => `<option value="${p.id}">${esc(p.name)}${p.isActive ? '' : ' (inactive)'}</option>`).join('');
    if (selectedId) select.value = String(selectedId);
  }

  function syncRole(): void {
    const isStaff = $<HTMLSelectElement>('m-role')?.value === 'staff';
    const wrap = $('m-position-wrap');
    if (wrap) wrap.hidden = !isStaff;
  }
  $('m-role')?.addEventListener('change', syncRole);

  function openMember(edit?: StaffMember): void {
    $('member-title')!.textContent = edit ? 'Edit team member' : 'Add team member';
    applyWriteAccess();
    $<HTMLInputElement>('m-id')!.value = edit ? String(edit.id) : '';
    $<HTMLInputElement>('m-first')!.value = edit?.firstName ?? '';
    $<HTMLInputElement>('m-last')!.value = edit?.lastName ?? '';
    const username = $<HTMLInputElement>('m-username')!;
    username.value = edit?.username ?? '';
    username.readOnly = !!edit; // a username cannot be changed
    $<HTMLInputElement>('m-email')!.value = edit?.email ?? '';
    $<HTMLInputElement>('m-phone')!.value = edit?.phone ?? '';
    $<HTMLSelectElement>('m-role')!.value = edit?.role ?? 'staff';
    $<HTMLInputElement>('m-password')!.value = '';
    $('m-password-wrap')!.hidden = !!edit;
    $('m-hint')!.hidden = !!edit;
    fillPositionSelect(edit?.positionId ?? null);
    syncRole();
    $('m-error')!.hidden = true;
    memberDialog?.showModal();
  }

  function showSecret(who: string, password: string): void {
    $('secret-who')!.textContent = who;
    $('secret-value')!.textContent = password;
    $('secret-copy')!.textContent = 'Copy';
    secretDialog?.showModal();
  }

  $('member-add')?.addEventListener('click', () => openMember());
  $('m-cancel')?.addEventListener('click', () => memberDialog?.close());

  $('secret-copy')?.addEventListener('click', async () => {
    const text = $('secret-value')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      $('secret-copy')!.textContent = 'Copied';
    } catch {
      // Clipboard can be blocked; the text is selectable on screen.
      $('secret-copy')!.textContent = 'Select and copy';
    }
  });
  // Clear the password from the page as soon as the dialog closes.
  secretDialog?.addEventListener('close', () => {
    $('secret-value')!.textContent = '';
  });
  $('secret-close')?.addEventListener('click', () => secretDialog?.close());

  $<HTMLFormElement>('member-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('m-error')!;
    const save = $<HTMLButtonElement>('m-save')!;
    err.hidden = true;

    const id = Number(val('m-id')) || null;
    const role = $<HTMLSelectElement>('m-role')!.value as StaffRole;
    const positionId = Number($<HTMLSelectElement>('m-position')!.value) || null;
    const input = {
      firstName: val('m-first'),
      lastName: val('m-last'),
      username: val('m-username'),
      email: val('m-email'),
      phone: val('m-phone'),
      role,
      positionId,
      password: $<HTMLInputElement>('m-password')!.value,
    };

    const problem = !input.firstName
      ? 'First name is required.'
      : !id && !input.username
        ? 'Username is required.'
        : role === 'staff' && !positionId
          ? 'Choose a position for staff.'
          : null;
    if (problem) {
      err.hidden = false;
      err.textContent = problem;
      return;
    }

    save.disabled = true;
    try {
      if (id) {
        await updateStaff(id, input);
        memberDialog?.close();
      } else {
        const { member, temporaryPassword } = await createStaff(input);
        memberDialog?.close();
        if (temporaryPassword) {
          showSecret(`Username: ${member.username}`, temporaryPassword);
        }
      }
      await reload();
    } catch (error) {
      err.hidden = false;
      err.textContent = describe(error);
    } finally {
      save.disabled = false;
    }
  });

  // ---------- team row actions ----------

  function closeMenus(): void {
    document.querySelectorAll<HTMLElement>('.st-menu').forEach((m) => (m.hidden = true));
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.st-more')) closeMenus();
  });

  $('st-directory')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
    if (!button) return;
    if (button.dataset.act === 'more') {
      const menu = button.parentElement?.querySelector<HTMLElement>('.st-menu');
      const wasHidden = menu?.hidden ?? true;
      closeMenus();
      if (menu) menu.hidden = !wasHidden;
      return;
    }
    closeMenus();
    const member = members.find((m) => m.id === Number(button.dataset.id));
    if (!member) return;

    const act = button.dataset.act;
    if (act === 'edit') {
      openMember(member);
      return;
    }

    if (act === 'deactivate' && !confirm(`Deactivate ${member.name}? They will be signed out and cannot sign in again until reactivated.`)) return;
    if (act === 'reset' && !confirm(`Reset the password for ${member.name}? They will be signed out everywhere.`)) return;

    button.disabled = true;
    try {
      if (act === 'deactivate') await deactivateStaff(member.id);
      else if (act === 'reactivate') await reactivateStaff(member.id);
      else if (act === 'reset') {
        const password = await resetStaffPassword(member.id);
        if (password) showSecret(`New password for ${member.username}`, password);
      }
      await reload();
    } catch (error) {
      alert(describe(error));
      button.disabled = false;
    }
  });

  const refilter = (): void => {
    page = 1;
    renderMembers();
  };
  $('st-search')?.addEventListener('input', refilter);
  ['st-role-filter', 'st-status-filter', 'st-position-filter'].forEach((id) =>
    $(id)?.addEventListener('change', refilter),
  );
  $('st-pages')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-page]');
    if (!b || b.disabled) return;
    page = Number(b.dataset.page) || 1;
    renderMembers();
  });
  document.querySelectorAll<HTMLButtonElement>('.st-view-btn').forEach((b) =>
    b.addEventListener('click', () => {
      view = b.dataset.view === 'grid' ? 'grid' : 'list';
      try {
        localStorage.setItem('vgsync-staff-view', view);
      } catch { /* ignore */ }
      renderMembers();
    }),
  );

  // ---------- position dialog ----------

  const positionDialog = $<HTMLDialogElement>('position-dialog');

  function permRow(module: { id: string; label: string }, perm?: PositionPermission): string {
    const box = (key: string, on: boolean, label: string) =>
      `<td><input type="checkbox" data-module="${module.id}" data-key="${key}" aria-label="${label} ${esc(module.label)}" ${on ? 'checked' : ''} /></td>`;
    return `<tr>
      <th scope="row">${esc(module.label)}</th>
      ${box('canView', !!perm?.canView, 'View')}
      ${box('canCreate', !!perm?.canCreate, 'Create')}
      ${box('canUpdate', !!perm?.canUpdate, 'Edit')}
      ${box('canDelete', !!perm?.canDelete, 'Delete')}
    </tr>`;
  }

  function openPosition(edit?: Position): void {
    $('position-title')!.textContent = edit ? 'Edit position' : 'New position';
    $<HTMLInputElement>('p-id')!.value = edit ? String(edit.id) : '';
    $<HTMLInputElement>('p-name')!.value = edit?.name ?? '';
    $<HTMLInputElement>('p-desc')!.value = edit?.description ?? '';
    $('perm-tbody')!.innerHTML = MODULES.map((m) =>
      permRow(m, edit?.permissions.find((p) => p.module === m.id)),
    ).join('');
    $('p-error')!.hidden = true;
    positionDialog?.showModal();
  }

  // Create/Edit/Delete need View: tick View for them, untick the rest with it.
  $('perm-tbody')?.addEventListener('change', (event) => {
    const box = event.target as HTMLInputElement;
    const row = box.closest('tr');
    if (!row) return;
    const get = (key: string) => row.querySelector<HTMLInputElement>(`input[data-key="${key}"]`)!;
    if (box.dataset.key !== 'canView' && box.checked) get('canView').checked = true;
    if (box.dataset.key === 'canView' && !box.checked) {
      ['canCreate', 'canUpdate', 'canDelete'].forEach((k) => (get(k).checked = false));
    }
  });

  function readPermissions(): PositionPermission[] {
    return MODULES.map((m) => {
      const get = (key: string) =>
        !!document.querySelector<HTMLInputElement>(`#perm-tbody input[data-module="${m.id}"][data-key="${key}"]`)?.checked;
      return {
        module: m.id,
        canView: get('canView'),
        canCreate: get('canCreate'),
        canUpdate: get('canUpdate'),
        canDelete: get('canDelete'),
      };
    });
  }

  $('position-add')?.addEventListener('click', () => openPosition());
  $('p-cancel')?.addEventListener('click', () => positionDialog?.close());

  $<HTMLFormElement>('position-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('p-error')!;
    const save = $<HTMLButtonElement>('p-save')!;
    err.hidden = true;

    const id = Number(val('p-id')) || null;
    const input = { name: val('p-name'), description: val('p-desc'), permissions: readPermissions() };
    if (!input.name) {
      err.hidden = false;
      err.textContent = 'Name is required.';
      return;
    }

    save.disabled = true;
    try {
      if (id) await updatePosition(id, input);
      else await createPosition(input);
      positionDialog?.close();
      await reload();
    } catch (error) {
      err.hidden = false;
      err.textContent = describe(error);
    } finally {
      save.disabled = false;
    }
  });

  $('position-tbody')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-pact]');
    if (!button) return;
    const position = positions.find((p) => p.id === Number(button.dataset.id));
    if (!position) return;

    const act = button.dataset.pact;
    if (act === 'edit') {
      openPosition(position);
      return;
    }
    if (act === 'delete' && !confirm(`Delete the position "${position.name}"?`)) return;

    button.disabled = true;
    try {
      if (act === 'delete') await deletePosition(position.id);
      else await setPositionActive(position.id, act === 'activate');
      await reload();
    } catch (error) {
      alert(describe(error));
      button.disabled = false;
    }
  });

  if (session && canManageStaff(session)) {
    void reload();
    refreshProfile()
      .then((fresh) => {
        // Re-check after the server confirms the role.
        if (fresh && !canManageStaff(fresh)) window.location.replace('/dashboard');
        else applyWriteAccess();
      })
      .catch(() => {});
  }
</script>

