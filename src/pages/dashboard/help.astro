---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import { CATEGORIES } from '../../lib/support';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.help;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
const liveChatUrl = (import.meta.env.PUBLIC_LIVE_CHAT_URL ?? '').trim();
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="hs-page" id="hs-page" data-live-chat={liveChatUrl}>
    <!-- Hero -->
    <section class="hs-hero" aria-labelledby="hs-hero-title">
      <img
        class="hs-hero-avatar"
        src="/images/help-agent.png"
        alt=""
        width="150"
        height="178"
        decoding="async"
        onerror="this.hidden=true"
      />

      <div class="hs-hero-body">
        <h2 id="hs-hero-title">How can we help you?</h2>
        <p>Find answers, get support, or track your requests.</p>
        <form class="hs-search" id="hs-search-form" role="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="hs-search" placeholder="Search for help articles…" autocomplete="off" aria-label="Search for help articles" />
          <button type="submit" class="hs-btn hs-btn-primary">Search</button>
        </form>
      </div>

      <svg class="hs-hero-skyline" viewBox="0 0 320 120" aria-hidden="true" preserveAspectRatio="xMaxYMax meet">
        <path d="M0 120V92l30-14 24 10 20-30 18 20 26-8 16-34 10 34 24-10 28 24 24-10 24 14 16-8 20 16V120z" fill="currentColor" opacity=".18" />
        <rect x="196" y="34" width="26" height="86" fill="currentColor" opacity=".22" />
        <path d="M194 34l15-22 15 22z" fill="currentColor" opacity=".26" />
        <rect x="236" y="56" width="34" height="64" fill="currentColor" opacity=".2" />
        <rect x="150" y="70" width="30" height="50" fill="currentColor" opacity=".16" />
      </svg>
    </section>

    <!-- Quick actions -->
    <div class="hs-actions">
      <button type="button" class="hs-action hs-action-blue" id="hs-act-help">
        <span class="hs-action-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/></svg>
        </span>
        <span class="hs-action-text"><strong>Browse Help Center</strong><small>Find answers to common questions</small></span>
        <span class="hs-action-go" aria-hidden="true">→</span>
      </button>
      <button type="button" class="hs-action hs-action-violet" id="hs-act-ticket">
        <span class="hs-action-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 0 0 6v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3a2 2 0 0 1 0-6V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1z"/><path d="M13 5v14" stroke-dasharray="2 3"/></svg>
        </span>
        <span class="hs-action-text"><strong>Create Support Ticket</strong><small>Get help from our team</small></span>
        <span class="hs-action-go" aria-hidden="true">→</span>
      </button>
      <button type="button" class="hs-action hs-action-green" id="hs-act-contact">
        <span class="hs-action-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        </span>
        <span class="hs-action-text"><strong>Contact Us</strong><small>Talk to our support team</small></span>
        <span class="hs-action-go" aria-hidden="true">→</span>
      </button>
      <a class="hs-action hs-action-orange" id="hs-act-video" href="#" target="_blank" rel="noopener noreferrer" hidden>
        <span class="hs-action-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l10.5-6.5a1 1 0 0 0 0-1.8L9.5 4.6A1 1 0 0 0 8 5.5z"/></svg>
        </span>
        <span class="hs-action-text"><strong>Video Tutorials</strong><small>Learn with step-by-step guides</small></span>
        <span class="hs-action-go" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hs-grid">
      <!-- FAQs -->
      <section class="hs-card" id="hs-faq-card" aria-labelledby="hs-faq-title">
        <header class="hs-card-head">
          <h3 id="hs-faq-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/></svg>
            Frequently Asked Questions
          </h3>
          <button type="button" class="hs-link" id="hs-faq-all" hidden>View All →</button>
        </header>
        <p class="hs-note" id="hs-faq-note" hidden></p>
        <div class="hs-faq-list" id="hs-faq-list">
          <p class="hs-empty">Loading…</p>
        </div>
      </section>

      <!-- Tickets -->
      <section class="hs-card" id="hs-tickets-card" aria-labelledby="hs-tickets-title">
        <header class="hs-card-head">
          <h3 id="hs-tickets-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 0 0 6v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-3a2 2 0 0 1 0-6V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1z"/></svg>
            My Support Tickets
          </h3>
          <button type="button" class="hs-link" id="hs-tickets-all" hidden>View All →</button>
        </header>
        <p class="hs-note hs-note-ok" id="hs-ticket-ok" role="status" hidden></p>
        <p class="hs-note hs-note-error" id="hs-tickets-error" role="alert" hidden></p>
        <div class="hs-table-wrap">
          <table class="hs-table">
            <thead>
              <tr>
                <th>Ticket #</th>
                <th>Subject</th>
                <th>Category</th>
                <th>Status</th>
                <th>Created At</th>
                <th class="hs-right">Actions</th>
              </tr>
            </thead>
            <tbody id="hs-tickets-body">
              <tr><td colspan="6" class="hs-empty">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="hs-grid hs-grid-bottom">
      <!-- Other ways -->
      <section class="hs-card" id="hs-contact-card" aria-labelledby="hs-contact-title">
        <header class="hs-card-head">
          <h3 id="hs-contact-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-7h3zM3 19a2 2 0 0 0 2 2h1v-7H3z"/></svg>
            Other Ways to Get Help
          </h3>
        </header>
        <p class="hs-note hs-note-error" id="hs-contact-error" role="alert" hidden></p>
        <div class="hs-ways">
          <div class="hs-way" id="hs-way-email">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              Email Support
            </h4>
            <a id="hs-email" href="#">—</a>
            <p id="hs-reply-time"></p>
          </div>
          <div class="hs-way" id="hs-way-phone">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
              Call Us
            </h4>
            <a id="hs-phone" href="#">—</a>
            <p id="hs-hours"></p>
          </div>
          {liveChatUrl && (
            <div class="hs-way" id="hs-way-chat">
              <h4>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 20l1-5.2A8 8 0 1 1 21 12z"/></svg>
                Live Chat
              </h4>
              <p>Chat with our support team</p>
              <a class="hs-btn hs-btn-outline" href={liveChatUrl} target="_blank" rel="noopener noreferrer">Start chat</a>
            </div>
          )}
          <div class="hs-way" id="hs-way-guide">
            <h4>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>
              User Guide
            </h4>
            <p>Download user manual</p>
            <a class="hs-btn hs-btn-outline" id="hs-guide" href="#" target="_blank" rel="noopener noreferrer" hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"/></svg>
              Download PDF
            </a>
            <p class="hs-muted" id="hs-guide-none" hidden>Coming soon</p>
          </div>
        </div>
      </section>

      <!-- Immediate help -->
      <aside class="hs-urgent" aria-labelledby="hs-urgent-title">
        <h3 id="hs-urgent-title">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#2563eb"/><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Need immediate help?
        </h3>
        <p>Our support team is ready to assist you.</p>
        <button type="button" class="hs-btn hs-btn-primary hs-btn-block" id="hs-urgent-ticket">Create Support Ticket →</button>
      </aside>
    </div>
  </div>

  <!-- New ticket -->
  <dialog class="hs-dialog" id="hs-ticket-dialog" aria-labelledby="hs-ticket-title">
    <form class="hs-dialog-inner" id="hs-ticket-form" novalidate>
      <h2 id="hs-ticket-title">Create Support Ticket</h2>
      <p class="hs-dialog-sub">Tell us what went wrong. We'll get back to you by email or phone.</p>

      <label class="hs-field">
        <span>Subject *</span>
        <input type="text" id="hs-f-subject" maxlength="150" placeholder="e.g. Stock not updating" required />
      </label>
      <label class="hs-field">
        <span>Category</span>
        <select id="hs-f-category">
          {CATEGORIES.map((c) => <option value={c.value} selected={c.value === 'other'}>{c.label}</option>)}
        </select>
      </label>
      <label class="hs-field">
        <span>Describe the problem *</span>
        <textarea id="hs-f-description" rows="5" placeholder="What did you do, and what happened instead?" required></textarea>
      </label>

      <p class="hs-note hs-note-error" id="hs-f-error" role="alert" hidden></p>

      <div class="hs-dialog-actions">
        <button type="button" class="hs-btn hs-btn-ghost" id="hs-f-cancel">Cancel</button>
        <button type="submit" class="hs-btn hs-btn-primary" id="hs-f-save">Submit ticket</button>
      </div>
    </form>
  </dialog>

  <!-- Ticket details -->
  <dialog class="hs-dialog" id="hs-view-dialog" aria-labelledby="hs-v-subject">
    <div class="hs-dialog-inner">
      <p class="hs-v-ref" id="hs-v-ref">—</p>
      <h2 id="hs-v-subject">—</h2>
      <span class="hs-badge" id="hs-v-status">—</span>

      <dl class="hs-dl">
        <div><dt>Category</dt><dd id="hs-v-category">—</dd></div>
        <div><dt>Raised by</dt><dd id="hs-v-by">—</dd></div>
        <div><dt>Created</dt><dd id="hs-v-created">—</dd></div>
        <div><dt>Last updated</dt><dd id="hs-v-updated">—</dd></div>
        <div class="hs-span2"><dt>Description</dt><dd class="hs-pre" id="hs-v-description">—</dd></div>
      </dl>

      <div class="hs-dialog-actions">
        <button type="button" class="hs-btn hs-btn-ghost" id="hs-v-close">Close</button>
      </div>
    </div>
  </dialog>
</AppLayout>

<script>
  import { getSession } from '../../lib/auth';
  import { ApiError } from '../../lib/api';
  import {
    listFaqs,
    listTickets,
    createTicket,
    getContact,
    formatTicketDate,
    formatTicketDateTime,
    type Faq,
    type Ticket,
    type TicketCategory,
    type SupportContact,
  } from '../../lib/support';

  if (!getSession()) window.location.replace('/');

  const FAQ_PREVIEW = 5;
  const TICKET_PREVIEW = 5;

  let faqs: Faq[] = [];
  let tickets: Ticket[] = [];
  let showAllFaqs = false;
  let showAllTickets = false;
  let faqToken = 0;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = (id: string) => $<HTMLInputElement>(id)!;

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const FIELD_LABELS: Record<string, string> = {
    subject: 'Subject',
    category: 'Category',
    description: 'Description',
  };

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    const entries = Object.entries(error.fields);
    if (entries.length > 0 && error.status === 400) {
      return entries.map(([key, msg]) => `${FIELD_LABELS[key] ?? key}: ${msg}`).join(' ');
    }
    return error.message;
  }

  function showBox(id: string, message: string | null): void {
    const el = $(id);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  // ---------- FAQs ----------

  function renderFaqs(searching: boolean): void {
    const list = $('hs-faq-list');
    const more = $<HTMLButtonElement>('hs-faq-all');
    if (!list) return;

    if (faqs.length === 0) {
      list.innerHTML = `<p class="hs-empty">${
        searching ? 'No help articles match your search.' : 'No questions have been added yet.'
      }</p>`;
      if (more) more.hidden = true;
      return;
    }

    const visible = showAllFaqs || searching ? faqs : faqs.slice(0, FAQ_PREVIEW);
    list.innerHTML = visible
      .map(
        (f) => `<details class="hs-faq">
          <summary><span>${esc(f.question)}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p class="hs-pre">${esc(f.answer)}</p>
        </details>`,
      )
      .join('');

    if (more) {
      more.hidden = searching || faqs.length <= FAQ_PREVIEW;
      more.textContent = showAllFaqs ? 'Show less' : 'View All →';
    }
  }

  async function loadFaqs(search = ''): Promise<void> {
    const token = ++faqToken;
    const searching = search.trim().length > 0;
    try {
      const result = await listFaqs(search);
      if (token !== faqToken) return; // a newer search replaced this one
      faqs = result;
      showBox('hs-faq-note', searching ? `${faqs.length} result${faqs.length === 1 ? '' : 's'} for “${search.trim()}”` : null);
      renderFaqs(searching);
    } catch (error) {
      if (token !== faqToken) return;
      faqs = [];
      const list = $('hs-faq-list');
      if (list) list.innerHTML = `<p class="hs-empty hs-error">${esc(describe(error))}</p>`;
      const more = $('hs-faq-all');
      if (more) more.hidden = true;
    }
  }

  // ---------- tickets ----------

  function statusClass(status: string): string {
    return `hs-badge hs-badge-${status.replace('_', '-')}`;
  }

  function renderTickets(): void {
    const body = $('hs-tickets-body');
    const more = $<HTMLButtonElement>('hs-tickets-all');
    if (!body) return;

    if (tickets.length === 0) {
      body.innerHTML = `<tr><td colspan="6" class="hs-empty">You have no support tickets yet.</td></tr>`;
      if (more) more.hidden = true;
      return;
    }

    const visible = showAllTickets ? tickets : tickets.slice(0, TICKET_PREVIEW);
    body.innerHTML = visible
      .map(
        (t) => `<tr>
          <td class="hs-mono">#${esc(t.reference)}</td>
          <td class="hs-subject" title="${esc(t.subject)}">${esc(t.subject)}</td>
          <td>${esc(t.categoryLabel)}</td>
          <td><span class="${statusClass(t.status)}">${esc(t.statusLabel)}</span></td>
          <td>${esc(formatTicketDate(t.createdAt))}</td>
          <td class="hs-right"><button type="button" class="hs-btn hs-btn-outline hs-btn-sm" data-ticket="${t.id}">View</button></td>
        </tr>`,
      )
      .join('');

    if (more) {
      more.hidden = tickets.length <= TICKET_PREVIEW;
      more.textContent = showAllTickets ? 'Show less' : 'View All →';
    }
  }

  async function loadTickets(): Promise<void> {
    try {
      tickets = await listTickets();
      showBox('hs-tickets-error', null);
    } catch (error) {
      tickets = [];
      showBox('hs-tickets-error', describe(error));
    }
    renderTickets();
  }

  const viewDialog = $<HTMLDialogElement>('hs-view-dialog');

  function openTicket(ticket: Ticket): void {
    const set = (id: string, value: string) => {
      const el = $(id);
      if (el) el.textContent = value || '—';
    };
    set('hs-v-ref', `#${ticket.reference}`);
    set('hs-v-subject', ticket.subject);
    set('hs-v-category', ticket.categoryLabel);
    set('hs-v-by', ticket.createdBy);
    set('hs-v-created', formatTicketDateTime(ticket.createdAt));
    set('hs-v-updated', formatTicketDateTime(ticket.updatedAt));
    set('hs-v-description', ticket.description);
    const badge = $('hs-v-status');
    if (badge) {
      badge.textContent = ticket.statusLabel;
      badge.className = statusClass(ticket.status);
    }
    viewDialog?.showModal();
  }

  $('hs-tickets-body')?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-ticket]');
    if (!button) return;
    const ticket = tickets.find((t) => t.id === Number(button.dataset.ticket));
    if (ticket) openTicket(ticket);
  });
  $('hs-v-close')?.addEventListener('click', () => viewDialog?.close());

  // ---------- contact ----------

  function renderContact(c: SupportContact): void {
    const email = $<HTMLAnchorElement>('hs-email');
    if (email) {
      email.textContent = c.email || '—';
      if (c.email) email.href = `mailto:${c.email}`;
    }
    const phone = $<HTMLAnchorElement>('hs-phone');
    if (phone) {
      phone.textContent = c.phone || '—';
      if (c.phone) phone.href = `tel:${c.phone.replace(/[^\d+]/g, '')}`;
    }
    const reply = $('hs-reply-time');
    if (reply) reply.textContent = c.replyTime;
    const hours = $('hs-hours');
    if (hours) hours.textContent = c.hours;

    // A link is only a link when it is a web address.
    const safe = (url: string) => /^https?:\/\//i.test(url);

    const guide = $<HTMLAnchorElement>('hs-guide');
    const none = $('hs-guide-none');
    if (guide && none) {
      const has = safe(c.userGuideUrl);
      guide.hidden = !has;
      none.hidden = has;
      if (has) guide.href = c.userGuideUrl;
    }

    const video = $<HTMLAnchorElement>('hs-act-video');
    if (video) {
      const has = safe(c.videoTutorialsUrl);
      video.hidden = !has;
      if (has) video.href = c.videoTutorialsUrl;
    }
  }

  async function loadContact(): Promise<void> {
    try {
      renderContact(await getContact());
      showBox('hs-contact-error', null);
    } catch (error) {
      showBox('hs-contact-error', describe(error));
    }
  }

  // ---------- new ticket ----------

  const ticketDialog = $<HTMLDialogElement>('hs-ticket-dialog');
  const ticketForm = $<HTMLFormElement>('hs-ticket-form');

  function openTicketForm(): void {
    ticketForm?.reset();
    $<HTMLSelectElement>('hs-f-category')!.value = 'other';
    showBox('hs-f-error', null);
    ticketDialog?.showModal();
    input('hs-f-subject').focus();
  }

  for (const id of ['hs-act-ticket', 'hs-urgent-ticket']) {
    $(id)?.addEventListener('click', openTicketForm);
  }
  $('hs-f-cancel')?.addEventListener('click', () => ticketDialog?.close());

  ticketForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const save = $<HTMLButtonElement>('hs-f-save');
    showBox('hs-f-error', null);

    const subject = input('hs-f-subject').value.trim();
    const description = ($<HTMLTextAreaElement>('hs-f-description')?.value ?? '').trim();

    if (subject.length < 3) {
      showBox('hs-f-error', 'Please enter a short subject.');
      return;
    }
    if (description.length < 10) {
      showBox('hs-f-error', 'Please describe the problem in a few words.');
      return;
    }

    if (save) save.disabled = true;
    try {
      const ticket = await createTicket({
        subject,
        category: $<HTMLSelectElement>('hs-f-category')!.value as TicketCategory,
        description,
      });
      ticketDialog?.close();
      showBox('hs-ticket-ok', `Ticket #${ticket.reference} was created. Our team will get back to you soon.`);
      await loadTickets();
    } catch (error) {
      showBox('hs-f-error', describe(error));
    } finally {
      if (save) save.disabled = false;
    }
  });

  // ---------- search, shortcuts ----------

  $('hs-search-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    showAllFaqs = false;
    void loadFaqs(input('hs-search').value);
    $('hs-faq-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Clearing the box brings the normal list back.
  input('hs-search')?.addEventListener('input', () => {
    if (input('hs-search').value.trim() === '') {
      showAllFaqs = false;
      void loadFaqs('');
    }
  });

  $('hs-act-help')?.addEventListener('click', () => {
    showAllFaqs = true;
    renderFaqs(false);
    $('hs-faq-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  $('hs-act-contact')?.addEventListener('click', () => {
    $('hs-contact-card')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  $('hs-faq-all')?.addEventListener('click', () => {
    showAllFaqs = !showAllFaqs;
    renderFaqs(false);
  });
  $('hs-tickets-all')?.addEventListener('click', () => {
    showAllTickets = !showAllTickets;
    renderTickets();
  });

  void loadFaqs();
  void loadTickets();
  void loadContact();
</script>

