---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.settings;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="settings-page" id="settings-page">
    {/* Left nav tabs */}
    <nav class="settings-nav" aria-label="Settings sections">
      <button type="button" class="settings-nav-item is-active" data-settings-tab="profile">Profile</button>
      <button type="button" class="settings-nav-item" data-settings-tab="organization">Organization</button>
      <button type="button" class="settings-nav-item" data-settings-tab="branch">Branch</button>
      <button type="button" class="settings-nav-item" data-settings-tab="inventory">Inventory</button>
      <button type="button" class="settings-nav-item" data-settings-tab="regional">Regional</button>
      <button type="button" class="settings-nav-item" data-settings-tab="notifications">Notifications</button>
      <button type="button" class="settings-nav-item" data-settings-tab="security">Security</button>
      <button type="button" class="settings-nav-item" data-settings-tab="appearance">Appearance</button>
    </nav>

    <div class="settings-panels">
      {/* Profile */}
      <section class="settings-panel is-active" data-settings-panel="profile">
        <header class="settings-panel-head">
          <h2>Profile</h2>
          <p>Your account identity across all branches you can access.</p>
        </header>

        <div class="settings-card">
          <div class="settings-profile-row">
            <div class="settings-avatar" id="settings-avatar">BG</div>
            <div class="settings-profile-text">
              <strong id="settings-display-name">—</strong>
              <span id="settings-role-line">—</span>
            </div>
          </div>

          <div class="settings-grid">
            <label class="settings-field">
              <span>Display name</span>
              <input type="text" id="set-display-name" autocomplete="name" />
            </label>
            <label class="settings-field">
              <span>Username</span>
              <input type="text" id="set-username" readonly />
            </label>
            <label class="settings-field">
              <span>Role</span>
              <input type="text" id="set-role" readonly />
            </label>
            <label class="settings-field">
              <span>Home branch</span>
              <input type="text" id="set-home-branch" readonly />
            </label>
          </div>

          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-profile">Save profile</button>
          </div>
        </div>
      </section>

      {/* Organization */}
      <section class="settings-panel" data-settings-panel="organization">
        <header class="settings-panel-head">
          <h2>Organization</h2>
          <p>Tenant-level company details used on invoices and reports.</p>
        </header>

        <div class="settings-card">
          <div class="settings-grid">
            <label class="settings-field settings-field-span2">
              <span>Legal name</span>
              <input type="text" id="org-name" placeholder="VG Automobiles Pvt. Ltd." />
            </label>
            <label class="settings-field">
              <span>Trade name</span>
              <input type="text" id="org-trade" placeholder="VGSync" />
            </label>
            <label class="settings-field">
              <span>PAN / VAT</span>
              <input type="text" id="org-tax" placeholder="e.g. 123456789" />
            </label>
            <label class="settings-field settings-field-span2">
              <span>Registered address</span>
              <input type="text" id="org-address" placeholder="Kathmandu, Nepal" />
            </label>
            <label class="settings-field">
              <span>Phone</span>
              <input type="tel" id="org-phone" placeholder="+977 …" />
            </label>
            <label class="settings-field">
              <span>Email</span>
              <input type="email" id="org-email" placeholder="accounts@company.com" />
            </label>
          </div>
          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-org">Save organization</button>
          </div>
        </div>
      </section>

      {/* Branch */}
      <section class="settings-panel" data-settings-panel="branch">
        <header class="settings-panel-head">
          <h2>Branch context</h2>
          <p>Working branch for inventory, sales and purchases. HO users can switch from the header.</p>
        </header>

        <div class="settings-card">
          <div class="settings-kv">
            <div>
              <span class="kv-label">Active branch</span>
              <strong id="branch-active-name">—</strong>
            </div>
            <div>
              <span class="kv-label">Code</span>
              <strong id="branch-active-code">—</strong>
            </div>
            <div>
              <span class="kv-label">Home branch</span>
              <strong id="branch-home-name">—</strong>
            </div>
            <div>
              <span class="kv-label">Access</span>
              <strong id="branch-access">—</strong>
            </div>
          </div>

          <div class="settings-grid" style="margin-top:14px">
            <label class="settings-field">
              <span>Default warehouse code</span>
              <input type="text" id="branch-warehouse" placeholder="WH-01" />
            </label>
            <label class="settings-field">
              <span>Branch phone</span>
              <input type="tel" id="branch-phone" placeholder="+977 …" />
            </label>
          </div>

          <p class="settings-hint" id="branch-switch-hint">
            Branch managers and staff are locked to their home branch.
          </p>

          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-branch">Save branch prefs</button>
          </div>
        </div>
      </section>

      {/* Inventory */}
      <section class="settings-panel" data-settings-panel="inventory">
        <header class="settings-panel-head">
          <h2>Inventory defaults</h2>
          <p>Operational defaults applied when creating stock and purchase documents.</p>
        </header>

        <div class="settings-card">
          <div class="settings-grid">
            <label class="settings-field">
              <span>Default unit</span>
              <select id="inv-unit">
                <option value="pcs">Pieces (pcs)</option>
                <option value="set">Set</option>
                <option value="box">Box</option>
                <option value="kg">Kilogram (kg)</option>
                <option value="ltr">Litre (ltr)</option>
              </select>
            </label>
            <label class="settings-field">
              <span>Low stock alert qty</span>
              <input type="number" id="inv-low-stock" min="0" step="1" value="5" />
            </label>
            <label class="settings-field">
              <span>SKU prefix</span>
              <input type="text" id="inv-sku-prefix" placeholder="VG-" />
            </label>
            <label class="settings-field">
              <span>Costing method</span>
              <select id="inv-costing">
                <option value="avg">Weighted average</option>
                <option value="fifo">FIFO</option>
                <option value="last">Last purchase</option>
              </select>
            </label>
          </div>

          <div class="settings-toggles">
            <label class="settings-toggle">
              <input type="checkbox" id="inv-allow-negative" />
              <span>Allow negative stock (override with approval)</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="inv-batch" checked />
              <span>Track batch / lot numbers</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="inv-serial" />
              <span>Track serial numbers for high-value items</span>
            </label>
          </div>

          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-inventory">Save inventory</button>
          </div>
        </div>
      </section>

      {/* Regional */}
      <section class="settings-panel" data-settings-panel="regional">
        <header class="settings-panel-head">
          <h2>Regional</h2>
          <p>Currency, calendar and number formats for documents and reports.</p>
        </header>

        <div class="settings-card">
          <div class="settings-grid">
            <label class="settings-field">
              <span>Currency</span>
              <select id="reg-currency">
                <option value="NPR">NPR — Nepalese Rupee</option>
                <option value="INR">INR — Indian Rupee</option>
                <option value="USD">USD — US Dollar</option>
              </select>
            </label>
            <label class="settings-field">
              <span>Timezone</span>
              <select id="reg-tz">
                <option value="Asia/Kathmandu">Asia/Kathmandu (NPT)</option>
                <option value="Asia/Kolkata">Asia/Kolkata (IST)</option>
                <option value="UTC">UTC</option>
              </select>
            </label>
            <label class="settings-field">
              <span>Date format</span>
              <select id="reg-date">
                <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                <option value="MM/DD/YYYY">MM/DD/YYYY</option>
              </select>
            </label>
            <label class="settings-field">
              <span>Fiscal year start</span>
              <select id="reg-fiscal">
                <option value="shrawan">Shrawan (Nepal FY)</option>
                <option value="april">April (India FY)</option>
                <option value="january">January (Calendar)</option>
              </select>
            </label>
          </div>
          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-regional">Save regional</button>
          </div>
        </div>
      </section>

      {/* Notifications */}
      <section class="settings-panel" data-settings-panel="notifications">
        <header class="settings-panel-head">
          <h2>Notifications</h2>
          <p>Alerts for stock, sales and system events. Delivery channels wire to backend later.</p>
        </header>

        <div class="settings-card">
          <div class="settings-toggles">
            <label class="settings-toggle">
              <input type="checkbox" id="ntf-low-stock" checked />
              <span>Low stock alerts</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="ntf-purchase" checked />
              <span>Purchase order updates</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="ntf-sales" checked />
              <span>Large sales / invoice activity</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="ntf-staff" />
              <span>Staff assignment &amp; login events</span>
            </label>
            <label class="settings-toggle">
              <input type="checkbox" id="ntf-email" />
              <span>Email digest (daily)</span>
            </label>
          </div>
          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-notifications">Save notifications</button>
          </div>
        </div>
      </section>

      {/* Security */}
      <section class="settings-panel" data-settings-panel="security">
        <header class="settings-panel-head">
          <h2>Security</h2>
          <p>Password and session controls for this account.</p>
        </header>

        <div class="settings-card">
          <div class="settings-kv">
            <div>
              <span class="kv-label">Session started</span>
              <strong id="sec-session">—</strong>
            </div>
            <div>
              <span class="kv-label">Password status</span>
              <strong id="sec-password-status">—</strong>
            </div>
          </div>

          <div class="settings-actions" style="margin-top:14px">
            <a class="btn-primary" href="/dashboard/change-password">Change password</a>
          </div>

          <p class="settings-hint">
            First-time accounts must change temporary passwords before using the system.
          </p>
        </div>
      </section>

      {/* Appearance */}
      <section class="settings-panel" data-settings-panel="appearance">
        <header class="settings-panel-head">
          <h2>Appearance</h2>
          <p>Theme preference is stored on this device and applies to login and app shell.</p>
        </header>

        <div class="settings-card">
          <div class="settings-theme-row" role="group" aria-label="Theme">
            <button type="button" class="theme-option" data-set-theme="light">
              <span class="theme-option-swatch is-light"></span>
              Light
            </button>
            <button type="button" class="theme-option" data-set-theme="dark">
              <span class="theme-option-swatch is-dark"></span>
              Dark
            </button>
          </div>
          <p class="settings-hint">You can also switch theme from the header control.</p>
        </div>
      </section>

      <p class="settings-toast" id="settings-toast" hidden>Saved</p>
    </div>
  </div>
</AppLayout>

<script>
  import { getSession, canSwitchBranch, updateSession } from '../../lib/auth';

  const PREFS_KEY = 'vgsync-settings';
  const THEME_KEY = 'vgsync-theme';

  type Prefs = Record<string, unknown>;

  function loadPrefs(): Prefs {
    try {
      const raw = localStorage.getItem(PREFS_KEY);
      return raw ? (JSON.parse(raw) as Prefs) : {};
    } catch {
      return {};
    }
  }

  function savePrefs(patch: Prefs): void {
    const next = { ...loadPrefs(), ...patch };
    try {
      localStorage.setItem(PREFS_KEY, JSON.stringify(next));
    } catch {
      // ignore
    }
  }

  function toast(msg = 'Saved'): void {
    const el = document.getElementById('settings-toast');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    window.clearTimeout((el as HTMLElement & { _t?: number })._t);
    (el as HTMLElement & { _t?: number })._t = window.setTimeout(() => {
      el.hidden = true;
    }, 1800);
  }

  function initials(name: string): string {
    const p = name.trim().split(/\s+/).filter(Boolean);
    if (!p.length) return 'U';
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[p.length - 1][0]).toUpperCase();
  }

  function val(id: string): HTMLInputElement | HTMLSelectElement | null {
    return document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
  }

  function check(id: string): HTMLInputElement | null {
    return document.getElementById(id) as HTMLInputElement | null;
  }

  // Tabs
  document.querySelectorAll<HTMLButtonElement>('[data-settings-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.settingsTab;
      document.querySelectorAll('[data-settings-tab]').forEach((b) => b.classList.remove('is-active'));
      document.querySelectorAll('[data-settings-panel]').forEach((p) => p.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.querySelector(`[data-settings-panel="${id}"]`)?.classList.add('is-active');
    });
  });

  const session = getSession();
  if (!session) {
    window.location.replace('/');
  } else {
    const prefs = loadPrefs();

    // Profile
    const avatar = document.getElementById('settings-avatar');
    const nameLine = document.getElementById('settings-display-name');
    const roleLine = document.getElementById('settings-role-line');
    if (avatar) avatar.textContent = initials(session.displayName);
    if (nameLine) nameLine.textContent = session.displayName;
    if (roleLine) roleLine.textContent = `${session.roleLabel} · ${session.homeBranchName}`;

    if (val('set-display-name')) val('set-display-name')!.value = session.displayName;
    if (val('set-username')) val('set-username')!.value = session.username;
    if (val('set-role')) val('set-role')!.value = session.roleLabel;
    if (val('set-home-branch')) val('set-home-branch')!.value = session.homeBranchName;

    // Org
    if (val('org-name')) val('org-name')!.value = String(prefs.orgName ?? 'VG Automobiles Pvt. Ltd.');
    if (val('org-trade')) val('org-trade')!.value = String(prefs.orgTrade ?? 'VGSync');
    if (val('org-tax')) val('org-tax')!.value = String(prefs.orgTax ?? '');
    if (val('org-address')) val('org-address')!.value = String(prefs.orgAddress ?? 'Kathmandu, Nepal');
    if (val('org-phone')) val('org-phone')!.value = String(prefs.orgPhone ?? '');
    if (val('org-email')) val('org-email')!.value = String(prefs.orgEmail ?? '');

    // Branch
    const aName = document.getElementById('branch-active-name');
    const aCode = document.getElementById('branch-active-code');
    const hName = document.getElementById('branch-home-name');
    const access = document.getElementById('branch-access');
    if (aName) aName.textContent = session.activeBranchName;
    if (aCode) aCode.textContent = session.activeBranchCode;
    if (hName) hName.textContent = session.homeBranchName;
    if (access) {
      access.textContent = canSwitchBranch(session)
        ? 'All branches (switchable)'
        : 'Home branch only';
    }
    if (val('branch-warehouse')) val('branch-warehouse')!.value = String(prefs.warehouse ?? '');
    if (val('branch-phone')) val('branch-phone')!.value = String(prefs.branchPhone ?? '');

    // Inventory
    if (val('inv-unit')) val('inv-unit')!.value = String(prefs.invUnit ?? 'pcs');
    if (val('inv-low-stock')) val('inv-low-stock')!.value = String(prefs.invLowStock ?? 5);
    if (val('inv-sku-prefix')) val('inv-sku-prefix')!.value = String(prefs.invSkuPrefix ?? 'VG-');
    if (val('inv-costing')) val('inv-costing')!.value = String(prefs.invCosting ?? 'avg');
    if (check('inv-allow-negative')) check('inv-allow-negative')!.checked = Boolean(prefs.invNeg);
    if (check('inv-batch')) check('inv-batch')!.checked = prefs.invBatch !== false;
    if (check('inv-serial')) check('inv-serial')!.checked = Boolean(prefs.invSerial);

    // Regional
    if (val('reg-currency')) val('reg-currency')!.value = String(prefs.currency ?? 'NPR');
    if (val('reg-tz')) val('reg-tz')!.value = String(prefs.tz ?? 'Asia/Kathmandu');
    if (val('reg-date')) val('reg-date')!.value = String(prefs.dateFmt ?? 'YYYY-MM-DD');
    if (val('reg-fiscal')) val('reg-fiscal')!.value = String(prefs.fiscal ?? 'shrawan');

    // Notifications
    if (check('ntf-low-stock')) check('ntf-low-stock')!.checked = prefs.ntfLow !== false;
    if (check('ntf-purchase')) check('ntf-purchase')!.checked = prefs.ntfPurchase !== false;
    if (check('ntf-sales')) check('ntf-sales')!.checked = prefs.ntfSales !== false;
    if (check('ntf-staff')) check('ntf-staff')!.checked = Boolean(prefs.ntfStaff);
    if (check('ntf-email')) check('ntf-email')!.checked = Boolean(prefs.ntfEmail);

    // Security
    const secSession = document.getElementById('sec-session');
    const secPass = document.getElementById('sec-password-status');
    if (secSession) {
      try {
        secSession.textContent = new Date(session.loggedInAt).toLocaleString();
      } catch {
        secSession.textContent = session.loggedInAt;
      }
    }
    if (secPass) {
      secPass.textContent = session.mustChangePassword
        ? 'Must update password'
        : 'Up to date';
    }

    // Appearance
    const root = document.documentElement;
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    document.querySelectorAll('[data-set-theme]').forEach((el) => {
      el.classList.toggle('is-active', el.getAttribute('data-set-theme') === theme);
      el.addEventListener('click', () => {
        const t = el.getAttribute('data-set-theme') as 'light' | 'dark';
        root.dataset.theme = t;
        try {
          localStorage.setItem(THEME_KEY, t);
        } catch {}
        document.querySelectorAll('[data-set-theme]').forEach((x) =>
          x.classList.toggle('is-active', x.getAttribute('data-set-theme') === t),
        );
        document.querySelectorAll('[data-theme-value]').forEach((chip) => {
          chip.classList.toggle('is-active', chip.getAttribute('data-theme-value') === t);
        });
        toast('Theme updated');
      });
    });

    // Saves
    document.getElementById('save-profile')?.addEventListener('click', () => {
      const name = val('set-display-name')?.value.trim() || session.displayName;
      updateSession({ displayName: name });
      if (nameLine) nameLine.textContent = name;
      if (avatar) avatar.textContent = initials(name);
      const sideName = document.getElementById('sidebar-profile-name');
      if (sideName) sideName.textContent = name;
      toast('Profile saved');
    });

    document.getElementById('save-org')?.addEventListener('click', () => {
      savePrefs({
        orgName: val('org-name')?.value ?? '',
        orgTrade: val('org-trade')?.value ?? '',
        orgTax: val('org-tax')?.value ?? '',
        orgAddress: val('org-address')?.value ?? '',
        orgPhone: val('org-phone')?.value ?? '',
        orgEmail: val('org-email')?.value ?? '',
      });
      toast('Organization saved');
    });

    document.getElementById('save-branch')?.addEventListener('click', () => {
      savePrefs({
        warehouse: val('branch-warehouse')?.value ?? '',
        branchPhone: val('branch-phone')?.value ?? '',
      });
      toast('Branch prefs saved');
    });

    document.getElementById('save-inventory')?.addEventListener('click', () => {
      savePrefs({
        invUnit: val('inv-unit')?.value ?? 'pcs',
        invLowStock: Number(val('inv-low-stock')?.value || 5),
        invSkuPrefix: val('inv-sku-prefix')?.value ?? 'VG-',
        invCosting: val('inv-costing')?.value ?? 'avg',
        invNeg: Boolean(check('inv-allow-negative')?.checked),
        invBatch: Boolean(check('inv-batch')?.checked),
        invSerial: Boolean(check('inv-serial')?.checked),
      });
      toast('Inventory defaults saved');
    });

    document.getElementById('save-regional')?.addEventListener('click', () => {
      savePrefs({
        currency: val('reg-currency')?.value ?? 'NPR',
        tz: val('reg-tz')?.value ?? 'Asia/Kathmandu',
        dateFmt: val('reg-date')?.value ?? 'YYYY-MM-DD',
        fiscal: val('reg-fiscal')?.value ?? 'shrawan',
      });
      toast('Regional settings saved');
    });

    document.getElementById('save-notifications')?.addEventListener('click', () => {
      savePrefs({
        ntfLow: Boolean(check('ntf-low-stock')?.checked),
        ntfPurchase: Boolean(check('ntf-purchase')?.checked),
        ntfSales: Boolean(check('ntf-sales')?.checked),
        ntfStaff: Boolean(check('ntf-staff')?.checked),
        ntfEmail: Boolean(check('ntf-email')?.checked),
      });
      toast('Notifications saved');
    });
  }
</script>

<style>
  .settings-page {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    max-width: 960px;
    margin: 0 auto;
  }

  @media (max-width: 800px) {
    .settings-page {
      grid-template-columns: 1fr;
    }
  }

  .settings-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-bg);
    position: sticky;
    top: 0;
  }

  @media (max-width: 800px) {
    .settings-nav {
      flex-direction: row;
      flex-wrap: wrap;
      position: static;
    }
  }

  .settings-nav-item {
    text-align: left;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 550;
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
  }

  .settings-nav-item:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }

  .settings-nav-item.is-active {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .settings-panel {
    display: none;
  }

  .settings-panel.is-active {
    display: block;
  }

  .settings-panel-head {
    margin-bottom: 12px;
  }

  .settings-panel-head h2 {
    margin: 0 0 4px;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .settings-panel-head p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .settings-card {
    padding: 16px;
    border: 1px solid var(--border);
