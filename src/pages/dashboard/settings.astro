---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.settings;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="settings-page" id="settings-page">
    <nav class="settings-nav" aria-label="Settings sections">
      <button type="button" class="settings-nav-item is-active" data-settings-tab="profile">Profile</button>
      <button type="button" class="settings-nav-item" data-settings-tab="business" id="tab-business" hidden>Business</button>
      <button type="button" class="settings-nav-item" data-settings-tab="security">Security</button>
      <button type="button" class="settings-nav-item" data-settings-tab="appearance">Appearance</button>
    </nav>

    <div class="settings-panels">
      <section class="settings-panel is-active" data-settings-panel="profile">
        <header class="settings-panel-head">
          <h2>Profile</h2>
          <p>Your account identity and photo across branches you can access.</p>
        </header>

        <div class="settings-card">
          <div class="settings-profile-row">
            <div class="settings-avatar-wrap">
              <div class="settings-avatar" id="settings-avatar">BG</div>
              <label class="settings-avatar-upload" for="avatar-file" title="Upload photo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 5v14"/><path d="M5 12h14"/>
                </svg>
              </label>
              <input type="file" id="avatar-file" accept="image/png,image/jpeg,image/webp" hidden />
            </div>
            <div class="settings-profile-text">
              <strong id="settings-display-name">—</strong>
              <span id="settings-role-line">—</span>
              <div class="settings-avatar-actions">
                <button type="button" class="btn-ghost" id="avatar-change">Change photo</button>
                <button type="button" class="btn-ghost is-danger" id="avatar-remove">Remove</button>
              </div>
              <p class="settings-avatar-hint" id="avatar-hint">JPG, PNG or WebP · max 512 KB · kept on this device</p>
            </div>
          </div>

          <div class="settings-grid">
            <label class="settings-field"><span>First name</span><input type="text" id="set-first" autocomplete="given-name" maxlength="150" /></label>
            <label class="settings-field"><span>Last name</span><input type="text" id="set-last" autocomplete="family-name" maxlength="150" /></label>
            <label class="settings-field"><span>Email</span><input type="email" id="set-email" autocomplete="email" /></label>
            <label class="settings-field"><span>Phone</span><input type="tel" id="set-phone" autocomplete="tel" maxlength="20" /></label>
            <label class="settings-field"><span>Username</span><input type="text" id="set-username" readonly /></label>
            <label class="settings-field"><span>Role</span><input type="text" id="set-role" readonly /></label>
            <label class="settings-field settings-field-span2"><span>Home branch</span><input type="text" id="set-home-branch" readonly /></label>
          </div>
          <p class="settings-error" id="profile-error" hidden></p>
          <div class="settings-actions">
            <button type="button" class="btn-primary" id="save-profile">Save profile</button>
          </div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="business">
        <header class="settings-panel-head"><h2>Business</h2><p>Details shown on your documents. Only the owner can change them.</p></header>
        <div class="settings-card">
          <p class="settings-note" id="biz-note" hidden></p>
          <div class="settings-kv">
            <div><span class="kv-label">Working in</span><strong id="biz-active">—</strong></div>
            <div><span class="kv-label">Code</span><strong id="biz-code">—</strong></div>
          </div>
          <div class="settings-grid" style="margin-top:14px">
            <label class="settings-field settings-field-span2" id="biz-company-wrap" hidden><span>Company name</span><input type="text" id="biz-company" maxlength="150" /></label>
            <label class="settings-field settings-field-span2"><span>Business name</span><input type="text" id="biz-name" maxlength="150" /></label>
            <label class="settings-field settings-field-span2"><span>Address</span><input type="text" id="biz-address" /></label>
            <label class="settings-field"><span>Phone</span><input type="tel" id="biz-phone" maxlength="20" /></label>
            <label class="settings-field"><span>Email</span><input type="email" id="biz-email" /></label>
          </div>
          <p class="settings-error" id="biz-error" hidden></p>
          <div class="settings-actions"><button type="button" class="btn-primary" id="save-business">Save business</button></div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="security">
        <header class="settings-panel-head"><h2>Security</h2><p>Password and session.</p></header>
        <div class="settings-card">
          <div class="settings-kv">
            <div><span class="kv-label">Session started</span><strong id="sec-session">—</strong></div>
            <div><span class="kv-label">Password status</span><strong id="sec-password-status">—</strong></div>
          </div>
          <div class="settings-actions" style="margin-top:14px"><a class="btn-primary" href="/dashboard/change-password">Change password</a></div>
        </div>
      </section>

      <section class="settings-panel" data-settings-panel="appearance">
        <header class="settings-panel-head"><h2>Appearance</h2><p>Theme on this device.</p></header>
        <div class="settings-card">
          <div class="settings-theme-row">
            <button type="button" class="theme-option" data-set-theme="light"><span class="theme-option-swatch is-light"></span> Light</button>
            <button type="button" class="theme-option" data-set-theme="dark"><span class="theme-option-swatch is-dark"></span> Dark</button>
          </div>
        </div>
      </section>

      <p class="settings-toast" id="settings-toast" hidden>Saved</p>
    </div>
  </div>
</AppLayout>

<script>
  import { getSession, canSwitchBranch, ApiError } from '../../lib/auth';
  import { paintAvatar, setAvatarFromFile, clearAvatar } from '../../lib/avatar';
  import {
    getMyProfile, saveMyProfile, getBusiness, saveBusiness, getCompanyName, saveCompanyName,
  } from '../../lib/settings';

  const THEME_KEY = 'vgsync-theme';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = (id: string) => $<HTMLInputElement>(id)!;

  function toast(msg = 'Saved'): void {
    const el = $('settings-toast');
    if (!el) return;
    el.textContent = msg; el.hidden = false;
    window.clearTimeout((el as any)._t);
    (el as any)._t = window.setTimeout(() => { el.hidden = true; }, 2200);
  }

  function setError(id: string, message: string | null): void {
    const el = $(id);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    if (error.status === 403) return 'You do not have permission to change this.';
    const parts = Object.entries(error.fields ?? {}).map(([k, v]) => `${k.replace(/_/g, ' ')}: ${[v].flat().join(' ')}`);
    return error.status === 400 && parts.length ? parts.join(' ') : error.message;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-settings-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.settingsTab;
      document.querySelectorAll('[data-settings-tab]').forEach((b) => b.classList.remove('is-active'));
      document.querySelectorAll('[data-settings-panel]').forEach((p) => p.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.querySelector(`[data-settings-panel="${id}"]`)?.classList.add('is-active');
    });
  });

  const session = getSession();
  if (!session) window.location.replace('/');
  else {
    const me = session;
    const avatar = $('settings-avatar');
    const avatarHint = $('avatar-hint');
    const nameLine = $('settings-display-name');

    function paintName(name: string): void {
      if (nameLine) nameLine.textContent = name;
      paintAvatar(avatar, me.userId, name);
      const side = $('sidebar-profile-name');
      if (side) side.textContent = name;
      paintAvatar($('sidebar-profile-initials'), me.userId, name);
    }

    paintAvatar(avatar, me.userId, me.displayName);
    if (nameLine) nameLine.textContent = me.displayName;
    const roleLine = $('settings-role-line');
    if (roleLine) roleLine.textContent = `${me.roleLabel} · ${me.homeBranchName}`;
    input('set-username').value = me.username;
    input('set-role').value = me.roleLabel;
    input('set-home-branch').value = me.homeBranchName;
    input('set-email').value = me.email;

    getMyProfile().then((p) => {
      input('set-first').value = p.firstName;
      input('set-last').value = p.lastName;
      input('set-email').value = p.email;
      input('set-phone').value = p.phone;
    }).catch(() => setError('profile-error', 'Could not load your profile.'));

    // Photo stays on this device.
    async function onAvatarFile(file: File | undefined | null) {
      if (!file) return;
      const result = await setAvatarFromFile(me.userId, file);
      if (!result.ok) {
        if (avatarHint) { avatarHint.textContent = result.error; avatarHint.classList.add('is-error'); }
        toast(result.error);
        return;
      }
      paintAvatar(avatar, me.userId, me.displayName);
      paintAvatar($('sidebar-profile-initials'), me.userId, me.displayName);
      if (avatarHint) { avatarHint.textContent = 'JPG, PNG or WebP · max 512 KB · kept on this device'; avatarHint.classList.remove('is-error'); }
      toast('Profile photo updated');
    }
    const fileInput = $<HTMLInputElement>('avatar-file');
    fileInput?.addEventListener('change', () => { void onAvatarFile(fileInput.files?.[0]); fileInput.value = ''; });
    $('avatar-change')?.addEventListener('click', () => fileInput?.click());
    $('avatar-remove')?.addEventListener('click', () => {
      clearAvatar(me.userId);
      paintAvatar(avatar, me.userId, me.displayName);
      paintAvatar($('sidebar-profile-initials'), me.userId, me.displayName);
      toast('Profile photo removed');
    });

    $('save-profile')?.addEventListener('click', async () => {
      const btn = $<HTMLButtonElement>('save-profile')!;
      btn.disabled = true;
      setError('profile-error', null);
      try {
        const saved = await saveMyProfile({
          firstName: input('set-first').value,
          lastName: input('set-last').value,
          email: input('set-email').value,
          phone: input('set-phone').value,
        });
        paintName(`${saved.firstName} ${saved.lastName}`.trim() || me.username);
        toast('Profile saved');
      } catch (error) {
        setError('profile-error', describe(error));
      } finally {
        btn.disabled = false;
      }
    });

    // Business: owners only.
    const isOwner = me.role === 'owner' || me.role === 'branch_owner';
    const canEdit = isOwner && me.accessMode !== 'read_only';
    const isCompanyOwner = me.role === 'owner';
    if (isOwner) {
      $('tab-business')!.hidden = false;
      $('biz-active')!.textContent = me.activeBranchName;
      $('biz-code')!.textContent = me.activeBranchCode;
      const note = $('biz-note')!;
      const fields = ['biz-company', 'biz-name', 'biz-address', 'biz-phone', 'biz-email'];
      if (!canEdit) {
        note.hidden = false;
        note.textContent = 'You are viewing this branch from Head Office, so it is read-only. Switch to Head Office to edit company details, or open the branch to see its own.';
        fields.forEach((id) => (input(id).disabled = true));
        $('save-business')!.hidden = true;
      }
      void (async () => {
        try {
          const [biz, company] = await Promise.all([
            getBusiness(me.activeBusinessId),
            isCompanyOwner ? getCompanyName() : Promise.resolve(null),
          ]);
          input('biz-name').value = biz.name;
          input('biz-address').value = biz.address;
          input('biz-phone').value = biz.phone;
          input('biz-email').value = biz.email;
          // The company name belongs to the company, so edit it from Head Office.
          if (company !== null && biz.type === 'head_office') {
            $('biz-company-wrap')!.hidden = false;
            input('biz-company').value = company;
          }
        } catch (error) {
          setError('biz-error', describe(error));
        }
      })();

      $('save-business')?.addEventListener('click', async () => {
        const btn = $<HTMLButtonElement>('save-business')!;
        btn.disabled = true;
        setError('biz-error', null);
        try {
          if (!$('biz-company-wrap')!.hidden) await saveCompanyName(input('biz-company').value);
          const saved = await saveBusiness(me.activeBusinessId, {
            name: input('biz-name').value,
            address: input('biz-address').value,
            phone: input('biz-phone').value,
            email: input('biz-email').value,
          });
          $('biz-active')!.textContent = saved.name;
          toast('Business saved');
        } catch (error) {
          setError('biz-error', describe(error));
        } finally {
          btn.disabled = false;
        }
      });
    }

    const secSession = $('sec-session');
    const secPass = $('sec-password-status');
    if (secSession) { try { secSession.textContent = new Date(me.loggedInAt).toLocaleString(); } catch { secSession.textContent = me.loggedInAt; } }
    if (secPass) secPass.textContent = me.mustChangePassword ? 'Must update password' : 'Up to date';

    const root = document.documentElement;
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    document.querySelectorAll('[data-set-theme]').forEach((el) => {
      el.classList.toggle('is-active', el.getAttribute('data-set-theme') === theme);
      el.addEventListener('click', () => {
        const t = el.getAttribute('data-set-theme') as 'light' | 'dark';
        root.dataset.theme = t;
        try { localStorage.setItem(THEME_KEY, t); } catch {}
        document.querySelectorAll('[data-set-theme]').forEach((x) => x.classList.toggle('is-active', x.getAttribute('data-set-theme') === t));
        const toggle = $('theme-toggle');
        toggle?.classList.toggle('is-dark', t === 'dark');
        toggle?.classList.toggle('is-light', t === 'light');
        toast('Theme updated');
      });
    });
  }
</script>

<style>
  .settings-page { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; align-items: start; max-width: 960px; margin: 0 auto; }
  @media (max-width: 800px) { .settings-page { grid-template-columns: 1fr; } }
  .settings-nav { display: flex; flex-direction: column; gap: 2px; padding: 8px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); position: sticky; top: 0; }
  @media (max-width: 800px) { .settings-nav { flex-direction: row; flex-wrap: wrap; position: static; } }
  .settings-nav-item { text-align: left; border: none; background: transparent; color: var(--text-secondary); font-family: inherit; font-size: 0.82rem; font-weight: 550; padding: 8px 10px; border-radius: 8px; cursor: pointer; }
  .settings-nav-item:hover { background: var(--surface-hover); color: var(--text-primary); }
  .settings-nav-item.is-active { background: var(--accent-soft); color: var(--accent); }
  .settings-panel { display: none; }
  .settings-panel.is-active { display: block; }
  .settings-panel-head { margin-bottom: 12px; }
  .settings-panel-head h2 { margin: 0 0 4px; font-size: 1.05rem; font-weight: 650; }
  .settings-panel-head p { margin: 0; font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }
  .settings-card { padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); }
  .settings-profile-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .settings-avatar-wrap { position: relative; width: 64px; height: 64px; flex-shrink: 0; }
  .settings-avatar { width: 64px; height: 64px; border-radius: 14px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-size: 0.95rem; font-weight: 700; background-size: cover; background-position: center; overflow: hidden; }
  .settings-avatar.has-photo { color: transparent; }
  .settings-avatar-upload { position: absolute; right: -4px; bottom: -4px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #fff; border: 2px solid var(--panel-bg); cursor: pointer; }
  .settings-avatar-actions { display: flex; gap: 8px; margin-top: 6px; }
  .settings-avatar-hint { margin: 4px 0 0; font-size: 0.7rem; color: var(--text-muted); }
  .settings-avatar-hint.is-error { color: #ef334e; }
  .btn-ghost { border: none; background: transparent; padding: 0; font-family: inherit; font-size: 0.75rem; font-weight: 600; color: var(--accent); cursor: pointer; }
  .btn-ghost.is-danger { color: #ef334e; }
  .settings-profile-text { display: flex; flex-direction: column; gap: 2px; }
  .settings-profile-text strong { font-size: 0.95rem; }
  .settings-profile-text > span { font-size: 0.78rem; color: var(--text-muted); }
  .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; }
  @media (max-width: 560px) { .settings-grid { grid-template-columns: 1fr; } }
  .settings-field-span2 { grid-column: 1 / -1; }
  .settings-field { display: flex; flex-direction: column; gap: 4px; font-size: 0.72rem; font-weight: 600; color: var(--text-secondary); }
  .settings-field input, .settings-field select { height: 36px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.85rem; }
  .settings-field input:focus, .settings-field select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .settings-field input[readonly] { opacity: 0.75; cursor: default; }
  .settings-toggles { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .settings-toggle { display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: var(--text-secondary); cursor: pointer; }
  .settings-toggle input { accent-color: var(--accent); }
  .settings-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .kv-label { display: block; font-size: 0.68rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 2px; }
  .settings-kv strong { font-size: 0.88rem; font-weight: 600; }
  .settings-actions { margin-top: 14px; display: flex; gap: 8px; }
  .btn-primary { display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 14px; border: none; border-radius: 9px; background: var(--accent); color: #fff; font-family: inherit; font-size: 0.84rem; font-weight: 650; text-decoration: none; cursor: pointer; }
  .settings-theme-row { display: flex; gap: 10px; }
  .theme-option { flex: 1; display: flex; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
  .theme-option.is-active { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .theme-option-swatch { width: 22px; height: 22px; border-radius: 6px; border: 1px solid var(--border); }
  .theme-option-swatch.is-light { background: #f8fafc; }
  .theme-option-swatch.is-dark { background: #0f172a; }
  .settings-error { margin: 10px 0 0; font-size: 0.8rem; color: #ef334e; }
  .settings-note { margin: 0 0 12px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); font-size: 0.78rem; color: var(--text-secondary); }
  .settings-nav-item[hidden] { display: none; }
  .settings-toast { position: fixed; right: 20px; bottom: 20px; z-index: 50; padding: 10px 14px; border-radius: 10px; background: var(--panel-bg); border: 1px solid var(--border); box-shadow: 0 10px 30px rgba(0,0,0,0.18); font-size: 0.85rem; font-weight: 600; }
</style>
