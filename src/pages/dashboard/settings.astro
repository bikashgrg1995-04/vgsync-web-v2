---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';
import pkg from '../../../package.json';
import '../../styles/app/settings-page.css';

const meta = PAGE_META.settings;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
const builtOn = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="se-root" id="settings-page">
    <header class="se-hero">
      <div class="se-hero-tile" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg>
      </div>
      <div>
        <h2 class="se-hero-title">Settings</h2>
        <p class="se-hero-sub">Manage your store settings and preferences</p>
      </div>
      <svg class="se-hero-gear" width="180" height="180" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"></path></svg>
    </header>

    <div class="se-layout">
      <!-- Section list -->
      <nav class="se-nav" aria-label="Settings sections">
        <button type="button" class="se-nav-item is-active" data-settings-tab="general">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg>
          General
        </button>
        <button type="button" class="se-nav-item" data-settings-tab="profile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0z"></path></svg>
          Profile
        </button>
        <button type="button" class="se-nav-item" data-settings-tab="business" id="tab-business" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v6h5a1 1 0 0 1 1 1v9zM7 8v2h2V8zm0 4v2h2v-2zm0 4v2h2v-2zm6-4v2h2v-2zm0 4v2h2v-2z"></path></svg>
          Branch &amp; Business
        </button>
        <a class="se-nav-item" href="/dashboard/staff" id="tab-users" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2 20a7 7 0 0 1 14 0z"></path><circle cx="17" cy="9" r="2.5"></circle><path d="M17 14a5 5 0 0 1 5 5v1h-5.5a8 8 0 0 0-2-5.2A5 5 0 0 1 17 14z"></path></svg>
          Users &amp; Permissions
        </a>
        <button type="button" class="se-nav-item" data-settings-tab="security">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z"></path></svg>
          Security
        </button>
        <button type="button" class="se-nav-item" data-settings-tab="appearance">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          Appearance
        </button>

        <span class="se-nav-sep" aria-hidden="true"></span>

        <button type="button" class="se-nav-item is-soon" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7z"></path><path d="m3 7 9 5 9-5"></path><path d="M12 12v10"></path></svg>
          Inventory Settings <em>Soon</em>
        </button>
        <button type="button" class="se-nav-item is-soon" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"></path></svg>
          Sales Settings <em>Soon</em>
        </button>
        <button type="button" class="se-nav-item is-soon" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4.5 12 3.5 3.5 0 0 0 5 19z"></path></svg>
          Backup &amp; Restore <em>Soon</em>
        </button>
      </nav>

      <div class="se-panels">
        <!-- ================= GENERAL ================= -->
        <section class="se-panel is-active" data-settings-panel="general">
          <div class="se-grid">
            <!-- General settings -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M4 21V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v6h5a1 1 0 0 1 1 1v10zM7 7v2h2V7zm0 4v2h2v-2zm0 4v2h2v-2zm6 0v2h2v-2zm0-4v2h2v-2z"></path></svg></span>
                <div><h3>General Settings</h3><p>Basic settings for your store</p></div>
              </header>
              <div class="se-form">
                <label class="se-row"><span>Store Name</span><input type="text" id="gen-name" readonly /></label>
                <label class="se-row"><span>Currency</span><input type="text" value="NPR (Rs.)" readonly /></label>
                <label class="se-row"><span>Timezone</span><input type="text" value="Asia/Kathmandu" readonly /></label>
              </div>
              <p class="se-hint">These are set for your business. To change them, contact VGSync support.</p>
            </article>

            <!-- Branch information -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9.5 4.6 4h14.8L21 9.5v1a3 3 0 0 1-5 2.2 3 3 0 0 1-4 0 3 3 0 0 1-4 0 3 3 0 0 1-5-2.2zM5 14.5V21h5v-5h4v5h5v-6.5a5 5 0 0 1-1 .1 5 5 0 0 1-3-1 5 5 0 0 1-3 1 5 5 0 0 1-3-1 5 5 0 0 1-3 1 5 5 0 0 1-1-.1z"></path></svg></span>
                <div><h3>Branch Information</h3><p>Manage branch details</p></div>
              </header>
              <div class="se-branch">
                <div class="se-branch-photo" aria-hidden="true">
                  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 4.6 4h14.8L21 9.5"></path><path d="M4 10v11h16V10"></path><path d="M9 21v-6h6v6"></path></svg>
                  <span id="gen-initial">B</span>
                </div>
                <dl class="se-kv">
                  <div><dt>Branch Name</dt><dd id="gen-branch">—</dd></div>
                  <div><dt>Code</dt><dd id="gen-code">—</dd></div>
                  <div><dt>Address</dt><dd id="gen-address">—</dd></div>
                  <div><dt>Contact</dt><dd id="gen-contact">—</dd></div>
                </dl>
              </div>
            </article>

            <!-- Notifications -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22a2.5 2.5 0 0 0 2.4-1.8h-4.8A2.5 2.5 0 0 0 12 22zm7-5.5V11a7 7 0 0 0-5-6.7V3.5a2 2 0 0 0-4 0v.8A7 7 0 0 0 5 11v5.5l-2 2V20h18v-1.5z"></path></svg></span>
                <div><h3>Notifications <em class="se-soon">Coming soon</em></h3><p>Configure how you receive notifications</p></div>
              </header>
              <ul class="se-toggles">
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
                  <div><strong>Email Notifications</strong><small>Receive important updates via email</small></div>
                  <input type="checkbox" class="se-switch" checked disabled aria-label="Email notifications" />
                </li>
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg></span>
                  <div><strong>In-App Notifications</strong><small>Get notified in the dashboard</small></div>
                  <input type="checkbox" class="se-switch" checked disabled aria-label="In-app notifications" />
                </li>
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span>
                  <div><strong>SMS Notifications</strong><small>Receive critical alerts via SMS</small></div>
                  <input type="checkbox" class="se-switch" disabled aria-label="SMS notifications" />
                </li>
              </ul>
            </article>

            <!-- Security -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5zm-1.2 13.4L7.6 12.2l1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4z"></path></svg></span>
                <div><h3>Security Settings</h3><p>Keep your account and data secure</p></div>
              </header>
              <ul class="se-toggles">
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
                  <div><strong>Password</strong><small id="gen-password">—</small></div>
                  <a class="se-btn is-outline" href="/dashboard/change-password">Change</a>
                </li>
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
                  <div><strong>Current session</strong><small id="gen-session">—</small></div>
                </li>
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z"></path><path d="m9 12 2 2 4-4"></path></svg></span>
                  <div><strong>Two-Factor Authentication <em class="se-soon">Coming soon</em></strong><small>Add an extra layer of security</small></div>
                  <input type="checkbox" class="se-switch" disabled aria-label="Two-factor authentication" />
                </li>
              </ul>
            </article>

            <!-- Data management -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C7.6 3 4 4.6 4 6.5v11C4 19.4 7.6 21 12 21s8-1.6 8-3.5v-11C20 4.6 16.4 3 12 3zm0 2c3.5 0 6 1 6 1.5S15.5 8 12 8 6 7 6 6.5 8.5 5 12 5zm6 12.5c0 .5-2.5 1.5-6 1.5s-6-1-6-1.5V15c1.5 1 3.7 1.5 6 1.5s4.5-.5 6-1.5zm0-5c0 .5-2.5 1.5-6 1.5s-6-1-6-1.5V10c1.5 1 3.7 1.5 6 1.5s4.5-.5 6-1.5z"></path></svg></span>
                <div><h3>Data Management <em class="se-soon">Coming soon</em></h3><p>Manage your data and backups</p></div>
              </header>
              <ul class="se-toggles">
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path></svg></span>
                  <div><strong>Backup Database</strong><small>Download a backup of your data</small></div>
                  <button type="button" class="se-btn is-outline" disabled>Download</button>
                </li>
                <li>
                  <span class="se-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"></path><path d="m7 8 5-5 5 5"></path><path d="M4 21h16"></path></svg></span>
                  <div><strong>Restore Database</strong><small>Restore from a backup file</small></div>
                  <button type="button" class="se-btn is-outline" disabled>Upload</button>
                </li>
              </ul>
            </article>

            <!-- About -->
            <article class="se-card">
              <header class="se-card-head">
                <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2zm0-8h-2V7h2z"></path></svg></span>
                <div><h3>About VGSync</h3><p>Application information</p></div>
              </header>
              <div class="se-about">
                <div class="se-about-logo">
                  <span class="se-logo-tile" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5v10l-9 5-9-5V7z"></path><path d="m3 7 9 5 9-5"></path><path d="M12 12v10"></path></svg></span>
                  <div><strong>VGSync</strong><small>Manage · Grow · Succeed</small></div>
                </div>
                <dl class="se-kv is-compact">
                  <div><dt>Version</dt><dd>v{pkg.version}</dd></div>
                  <div><dt>Last Updated</dt><dd>{builtOn}</dd></div>
                  <div><dt>Built With</dt><dd><span class="se-heart" aria-hidden="true">♥</span> for business</dd></div>
                </dl>
              </div>
            </article>
          </div>
        </section>

        <!-- ================= PROFILE ================= -->
        <section class="se-panel" data-settings-panel="profile">
          <article class="se-card">
            <header class="se-card-head">
              <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0z"></path></svg></span>
              <div><h3>Profile</h3><p>Your account identity and photo across branches you can access</p></div>
            </header>

            <div class="se-profile-row">
              <div class="se-avatar-wrap">
                <div class="se-avatar" id="settings-avatar">BG</div>
                <label class="se-avatar-upload" for="avatar-file" title="Upload photo">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </label>
                <input type="file" id="avatar-file" accept="image/png,image/jpeg,image/webp" hidden />
              </div>
              <div class="se-profile-text">
                <strong id="settings-display-name">—</strong>
                <span id="settings-role-line">—</span>
                <div class="se-avatar-actions">
                  <button type="button" class="se-link" id="avatar-change">Change photo</button>
                  <button type="button" class="se-link is-danger" id="avatar-remove">Remove</button>
                </div>
                <p class="se-hint" id="avatar-hint">JPG, PNG or WebP · max 512 KB · kept on this device</p>
              </div>
            </div>

            <div class="se-fields">
              <label class="se-field"><span>First name</span><input type="text" id="set-first" autocomplete="given-name" maxlength="150" /></label>
              <label class="se-field"><span>Last name</span><input type="text" id="set-last" autocomplete="family-name" maxlength="150" /></label>
              <label class="se-field"><span>Email</span><input type="email" id="set-email" autocomplete="email" /></label>
              <label class="se-field"><span>Phone</span><input type="tel" id="set-phone" autocomplete="tel" maxlength="20" /></label>
              <label class="se-field"><span>Username</span><input type="text" id="set-username" readonly /></label>
              <label class="se-field"><span>Role</span><input type="text" id="set-role" readonly /></label>
              <label class="se-field is-wide"><span>Home branch</span><input type="text" id="set-home-branch" readonly /></label>
            </div>
            <p class="se-error" id="profile-error" hidden></p>
            <div class="se-actions">
              <button type="button" class="se-btn is-primary" id="save-profile">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><path d="M17 21v-8H7v8"></path><path d="M7 3v5h8"></path></svg>
                Save Changes
              </button>
            </div>
          </article>
        </section>

        <!-- ================= BUSINESS ================= -->
        <section class="se-panel" data-settings-panel="business">
          <article class="se-card">
            <header class="se-card-head">
              <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v6h5a1 1 0 0 1 1 1v9zM7 8v2h2V8zm0 4v2h2v-2zm0 4v2h2v-2zm6-4v2h2v-2zm0 4v2h2v-2z"></path></svg></span>
              <div><h3>Branch &amp; Business</h3><p>Your business details. To change them, contact VGSync support.</p></div>
            </header>
            <dl class="se-kv is-wide">
              <div><dt>Working in</dt><dd id="biz-active">—</dd></div>
              <div><dt>Code</dt><dd id="biz-code">—</dd></div>
            </dl>
            <div class="se-fields">
              <label class="se-field is-wide" id="biz-company-wrap" hidden><span>Company name</span><input type="text" id="biz-company" readonly /></label>
              <label class="se-field is-wide"><span>Business name</span><input type="text" id="biz-name" readonly /></label>
              <label class="se-field is-wide"><span>Address</span><input type="text" id="biz-address" readonly /></label>
              <label class="se-field"><span>Phone</span><input type="tel" id="biz-phone" readonly /></label>
              <label class="se-field"><span>Email</span><input type="email" id="biz-email" readonly /></label>
            </div>
            <p class="se-error" id="biz-error" hidden></p>
          </article>
        </section>

        <!-- ================= SECURITY ================= -->
        <section class="se-panel" data-settings-panel="security">
          <article class="se-card">
            <header class="se-card-head">
              <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5zm-1.2 13.4L7.6 12.2l1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4z"></path></svg></span>
              <div><h3>Security</h3><p>Password and session</p></div>
            </header>
            <dl class="se-kv is-wide">
              <div><dt>Session started</dt><dd id="sec-session">—</dd></div>
              <div><dt>Password status</dt><dd id="sec-password-status">—</dd></div>
            </dl>
            <div class="se-actions"><a class="se-btn is-primary" href="/dashboard/change-password">Change password</a></div>
          </article>
        </section>

        <!-- ================= APPEARANCE ================= -->
        <section class="se-panel" data-settings-panel="appearance">
          <article class="se-card">
            <header class="se-card-head">
              <span class="se-tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg></span>
              <div><h3>Appearance</h3><p>Theme on this device</p></div>
            </header>
            <div class="se-theme-row">
              <button type="button" class="se-theme" data-set-theme="light"><span class="se-swatch is-light"></span> Light</button>
              <button type="button" class="se-theme" data-set-theme="dark"><span class="se-swatch is-dark"></span> Dark</button>
            </div>
          </article>
        </section>

        <p class="se-toast" id="settings-toast" hidden>Saved</p>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { getSession, ApiError } from '../../lib/auth';
  import { paintAvatar, setAvatarFromFile, clearAvatar } from '../../lib/avatar';
  import { getMyProfile, saveMyProfile, getBusiness, getCompanyName } from '../../lib/settings';

  const THEME_KEY = 'vgsync-theme';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = (id: string) => $<HTMLInputElement>(id)!;
  const setText = (id: string, text: string) => { const el = $(id); if (el) el.textContent = text || '—'; };

  function toast(msg = 'Saved'): void {
    const el = $('settings-toast');
    if (!el) return;
    el.textContent = msg; el.hidden = false;
    window.clearTimeout((el as any)._t);
    (el as any)._t = window.setTimeout(() => { el.hidden = true; }, 2200);
  }

  function setError(id: string, message: string | null): void {
    const el = $(id);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    if (error.status === 403) return 'You do not have permission to change this.';
    const parts = Object.entries(error.fields ?? {}).map(([k, v]) => `${k.replace(/_/g, ' ')}: ${[v].flat().join(' ')}`);
    return error.status === 400 && parts.length ? parts.join(' ') : error.message;
  }

  function showTab(id: string): void {
    document.querySelectorAll('[data-settings-tab]').forEach((b) => b.classList.toggle('is-active', (b as HTMLElement).dataset.settingsTab === id));
    document.querySelectorAll('[data-settings-panel]').forEach((p) => p.classList.toggle('is-active', (p as HTMLElement).dataset.settingsPanel === id));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-settings-tab]').forEach((btn) => {
    btn.addEventListener('click', () => showTab(btn.dataset.settingsTab!));
  });

  const session = getSession();
  if (!session) window.location.replace('/');
  else {
    const me = session;
    const avatar = $('settings-avatar');
    const avatarHint = $('avatar-hint');
    const nameLine = $('settings-display-name');

    function paintName(name: string): void {
      if (nameLine) nameLine.textContent = name;
      paintAvatar(avatar, me.userId, name);
      const side = $('sidebar-profile-name');
      if (side) side.textContent = name;
      paintAvatar($('sidebar-profile-initials'), me.userId, name);
      paintAvatar($('header-avatar'), me.userId, name);
    }

    // ---- General cards (from the session; owners also get address and phone)
    setText('gen-name', me.activeBranchName);
    input('gen-name').value = me.activeBranchName;
    setText('gen-branch', me.activeBranchName);
    setText('gen-code', me.activeBranchCode);
    setText('gen-initial', (me.activeBranchName || 'B')[0].toUpperCase());
    let loggedIn = me.loggedInAt;
    try { loggedIn = new Date(me.loggedInAt).toLocaleString(); } catch { /* keep the raw value */ }
    setText('gen-session', `Signed in ${loggedIn}`);
    setText('gen-password', me.mustChangePassword ? 'You must update your password' : 'Up to date');

    // ---- Profile
    paintAvatar(avatar, me.userId, me.displayName);
    if (nameLine) nameLine.textContent = me.displayName;
    setText('settings-role-line', `${me.roleLabel} · ${me.homeBranchName}`);
    input('set-username').value = me.username;
    input('set-role').value = me.roleLabel;
    input('set-home-branch').value = me.homeBranchName;
    input('set-email').value = me.email;

    getMyProfile().then((p) => {
      input('set-first').value = p.firstName;
      input('set-last').value = p.lastName;
      input('set-email').value = p.email;
      input('set-phone').value = p.phone;
    }).catch(() => setError('profile-error', 'Could not load your profile.'));

    // Photo stays on this device.
    async function onAvatarFile(file: File | undefined | null) {
      if (!file) return;
      const result = await setAvatarFromFile(me.userId, file);
      if (!result.ok) {
        if (avatarHint) { avatarHint.textContent = result.error; avatarHint.classList.add('is-error'); }
        toast(result.error);
        return;
      }
      paintAvatar(avatar, me.userId, me.displayName);
      paintAvatar($('sidebar-profile-initials'), me.userId, me.displayName);
      paintAvatar($('header-avatar'), me.userId, me.displayName);
      if (avatarHint) { avatarHint.textContent = 'JPG, PNG or WebP · max 512 KB · kept on this device'; avatarHint.classList.remove('is-error'); }
      toast('Profile photo updated');
    }
    const fileInput = $<HTMLInputElement>('avatar-file');
    fileInput?.addEventListener('change', () => { void onAvatarFile(fileInput.files?.[0]); fileInput.value = ''; });
    $('avatar-change')?.addEventListener('click', () => fileInput?.click());
    $('avatar-remove')?.addEventListener('click', () => {
      clearAvatar(me.userId);
      paintAvatar(avatar, me.userId, me.displayName);
      paintAvatar($('sidebar-profile-initials'), me.userId, me.displayName);
      paintAvatar($('header-avatar'), me.userId, me.displayName);
      toast('Profile photo removed');
    });

    $('save-profile')?.addEventListener('click', async () => {
      const btn = $<HTMLButtonElement>('save-profile')!;
      btn.disabled = true;
      setError('profile-error', null);
      try {
        const saved = await saveMyProfile({
          firstName: input('set-first').value,
          lastName: input('set-last').value,
          email: input('set-email').value,
          phone: input('set-phone').value,
        });
        paintName(`${saved.firstName} ${saved.lastName}`.trim() || me.username);
        toast('Profile saved');
      } catch (error) {
        setError('profile-error', describe(error));
      } finally {
        btn.disabled = false;
      }
    });

    // ---- Business details: owners can look, only VGSync support changes them.
    const isOwner = me.role === 'owner' || me.role === 'branch_owner';
    if (isOwner) {
      $('tab-business')!.hidden = false;
      $('tab-users')!.hidden = false;
      setText('biz-active', me.activeBranchName);
      setText('biz-code', me.activeBranchCode);
      void (async () => {
        try {
          const [biz, company] = await Promise.all([
            getBusiness(me.activeBusinessId),
            me.role === 'owner' ? getCompanyName() : Promise.resolve(null),
          ]);
          input('biz-name').value = biz.name;
          input('biz-address').value = biz.address;
          input('biz-phone').value = biz.phone;
          input('biz-email').value = biz.email;
          setText('gen-address', biz.address);
          setText('gen-contact', [biz.phone, biz.email].filter(Boolean).join(' · '));
          if (company !== null) {
            $('biz-company-wrap')!.hidden = false;
            input('biz-company').value = company;
          }
        } catch (error) {
          setError('biz-error', describe(error));
        }
      })();
    } else {
      setText('gen-address', 'Visible to owners');
      setText('gen-contact', 'Visible to owners');
    }

    // ---- Security tab
    setText('sec-session', loggedIn);
    setText('sec-password-status', me.mustChangePassword ? 'Must update password' : 'Up to date');

    // ---- Appearance
    const root = document.documentElement;
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    document.querySelectorAll('[data-set-theme]').forEach((el) => {
      el.classList.toggle('is-active', el.getAttribute('data-set-theme') === theme);
      el.addEventListener('click', () => {
        const t = el.getAttribute('data-set-theme') as 'light' | 'dark';
        root.dataset.theme = t;
        try { localStorage.setItem(THEME_KEY, t); } catch { /* storage can be blocked */ }
        document.querySelectorAll('[data-set-theme]').forEach((x) => x.classList.toggle('is-active', x.getAttribute('data-set-theme') === t));
        const toggle = $('theme-toggle');
        toggle?.classList.toggle('is-dark', t === 'dark');
        toggle?.classList.toggle('is-light', t === 'light');
        toast('Theme updated');
      });
    });
  }
</script>
