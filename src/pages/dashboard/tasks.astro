---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';
import '../../styles/app/purchase-shared.css';
import '../../styles/app/purchase-page.css';

const meta = PAGE_META.tasks;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="pu-page pd-page">
    <header class="pd-hero">
      <div class="pd-hero-text">
        <div>
          <h2 class="pd-hero-title">Tasks</h2>
          <p class="pd-hero-sub" id="tk-sub">Work handed to you. Start it, finish it, and leave a note when you are done.</p>
        </div>
      </div>
      <div class="pd-hero-actions">
        <button type="button" class="btn-primary-sm" id="tk-new" hidden>+ Assign task</button>
        <button type="button" class="btn-ghost-sm" id="tk-refresh">Refresh</button>
      </div>
    </header>

    <div class="pd-kpis">
      <article class="pd-kpi"><div class="pd-kpi-body"><span class="pd-kpi-label">My open tasks</span><div class="pd-kpi-row"><strong id="tk-k-open">—</strong></div><span class="pd-kpi-sub">To do or in progress</span></div></article>
      <article class="pd-kpi"><div class="pd-kpi-body"><span class="pd-kpi-label">My overdue</span><div class="pd-kpi-row"><strong id="tk-k-over">—</strong></div><span class="pd-kpi-sub">Past the due date</span></div></article>
      <article class="pd-kpi"><div class="pd-kpi-body"><span class="pd-kpi-label">Done this week</span><div class="pd-kpi-row"><strong id="tk-k-done">—</strong></div><span class="pd-kpi-sub">Finished by me</span></div></article>
      <article class="pd-kpi" id="tk-k-team" hidden><div class="pd-kpi-body"><span class="pd-kpi-label">Team open</span><div class="pd-kpi-row"><strong id="tk-k-topen">—</strong></div><span class="pd-kpi-sub" id="tk-k-tsub">Across the team</span></div></article>
    </div>

    <section class="pu-card" id="tk-people-card" hidden>
      <div class="pu-filters"><strong>Who is doing what</strong><span class="pu-count">Click a name to see their tasks</span></div>
      <div class="pu-table-wrap">
        <table class="pu-table">
          <thead><tr><th>Person</th><th class="num">Open</th><th class="num">Overdue</th><th class="num">Done</th></tr></thead>
          <tbody id="tk-people"></tbody>
        </table>
      </div>
    </section>

    <section class="pu-card">
      <div class="pu-filters">
        <div class="tk-tabs" id="tk-tabs">
          <button type="button" class="tk-tab is-active" data-tab="mine">My tasks</button>
          <button type="button" class="tk-tab" data-tab="by-me" hidden>Assigned by me</button>
          <button type="button" class="tk-tab" data-tab="team" hidden>Everyone</button>
        </div>
        <select id="tk-status" aria-label="Status">
          <option value="open">Open</option>
          <option value="done">Done</option>
          <option value="cancelled">Cancelled</option>
          <option value="all">All</option>
        </select>
        <span class="pu-count" id="tk-count"></span>
      </div>
      <p class="pu-notice" id="tk-notice" hidden></p>
      <div class="pu-table-wrap">
        <table class="pu-table">
          <thead><tr><th>Task</th><th id="tk-th-person">Assigned by</th><th>Due</th><th>Status</th><th></th></tr></thead>
          <tbody id="tk-tbody"><tr><td colspan="5" class="pu-empty">Loading…</td></tr></tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Assign / edit -->
  <dialog class="pu-dialog" id="tk-form-dlg">
    <form method="dialog" class="pu-dialog-inner" id="tk-form">
      <h2 class="pu-dialog-title" id="tk-form-title">Assign a task</h2>
      <label class="pu-field"><span>Task *</span><input type="text" id="tf-title" maxlength="200" required placeholder="e.g. Count the engine oil stock" /></label>
      <label class="pu-field"><span>Details</span><textarea id="tf-desc" rows="3" maxlength="2000"></textarea></label>
      <div class="pu-grid">
        <label class="pu-field"><span>Assign to *</span><select id="tf-who" required></select></label>
        <label class="pu-field"><span>Due date</span><input type="date" id="tf-due" /></label>
        <label class="pu-field"><span>Priority</span>
          <select id="tf-priority"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option></select>
        </label>
      </div>
      <p class="pu-error" id="tf-error" hidden></p>
      <div class="pu-actions">
        <button type="button" class="btn-ghost-sm" id="tf-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="tf-save">Assign</button>
      </div>
    </form>
  </dialog>

  <!-- Task detail -->
  <dialog class="pu-dialog pu-wide" id="tk-dlg">
    <div class="pu-dialog-inner">
      <h2 class="pu-dialog-title" id="td-title"></h2>
      <p class="pu-sub" id="td-meta"></p>
      <p class="td-desc" id="td-desc"></p>
      <div class="td-actions" id="td-actions"></div>
      <label class="pu-field" id="td-note-wrap"><span>Note (optional)</span><input type="text" id="td-note" maxlength="500" placeholder="What was done?" /></label>
      <p class="pu-error" id="td-error" hidden></p>
      <h3 class="td-h">History</h3>
      <ol class="td-events" id="td-events"></ol>
      <div class="td-comment">
        <input type="text" id="td-comment" maxlength="500" placeholder="Write a comment…" aria-label="Comment" />
        <button type="button" class="btn-ghost-sm" id="td-send">Send</button>
      </div>
      <div class="pu-actions"><button type="button" class="btn-ghost-sm" id="td-close">Close</button></div>
    </div>
  </dialog>
</AppLayout>

<style is:global>
  .tk-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .tk-tab { border: 1px solid var(--border); background: transparent; color: var(--text-secondary); border-radius: 999px; padding: 6px 14px; font: inherit; font-size: 0.8rem; cursor: pointer; }
  .tk-tab.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tk-pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 0.7rem; font-weight: 650; background: var(--surface); }
  .tk-pill.todo { background: color-mix(in srgb, #94a3b8 22%, transparent); }
  .tk-pill.in_progress { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .tk-pill.done { background: color-mix(in srgb, #22c55e 24%, transparent); }
  .tk-pill.cancelled { background: color-mix(in srgb, #ef4444 18%, transparent); }
  .tk-prio-high { color: #ef4444; font-weight: 700; font-size: 0.7rem; margin-left: 6px; }
  .tk-late { color: #ef4444; font-weight: 650; }
  .tk-row { cursor: pointer; }
  .tk-row:hover { background: var(--surface); }
  .tk-sub { display: block; font-size: 0.72rem; color: var(--text-muted); }
  .td-desc { white-space: pre-wrap; font-size: 0.85rem; margin: 0 0 10px; }
  .td-actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
  .td-h { font-size: 0.85rem; margin: 14px 0 6px; }
  .td-events { list-style: none; margin: 0; padding: 0 0 0 12px; border-left: 2px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
  .td-event { font-size: 0.8rem; }
  .td-event small { display: block; color: var(--text-muted); font-size: 0.7rem; }
  .td-comment { display: flex; gap: 8px; margin-top: 12px; }
  .td-comment input, #tf-desc { flex: 1; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font: inherit; font-size: 0.85rem; }
  #tf-desc { width: 100%; resize: vertical; }
</style>

<script>
  import { can, getSession } from '../../lib/auth';
  import {
    cancelTask, commentOnTask, createTask, editTask, getTask, getTaskSummary, listAssignees, listTasks, setTaskStatus,
    type Person, type Task, type TaskStatus, type TaskSummary,
  } from '../../lib/tasks';

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const session = getSession();
  if (!session) window.location.replace('/');

  const readOnly = session?.accessMode === 'read_only';
  const canAssign = !readOnly && can(session, 'tasks.create');
  const canSeeAll = can(session, 'tasks.view');
  const canEdit = !readOnly && can(session, 'tasks.update');
  const canCancel = !readOnly && can(session, 'tasks.delete');
  const me = Number((session as unknown as { userId?: number; id?: number })?.userId ?? (session as unknown as { id?: number })?.id ?? 0);

  type Tab = 'mine' | 'by-me' | 'team';
  let tab: Tab = 'mine';
  let personFilter: number | null = null;
  let tasks: Task[] = [];
  let summary: TaskSummary | null = null;
  let people: Person[] = [];
  let openId: number | null = null;
  let editing: Task | null = null;

  const STATUS_TEXT: Record<string, string> = { todo: 'To do', in_progress: 'In progress', done: 'Done', cancelled: 'Cancelled' };
  const message = (e: unknown) => (e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
  const when = (iso: string) => new Date(iso).toLocaleString();

  function notice(text: string | null): void {
    const el = $('tk-notice');
    el.textContent = text ?? '';
    el.hidden = !text;
  }

  function params(): Record<string, string> {
    const p: Record<string, string> = {};
    const status = ($('tk-status') as HTMLSelectElement).value;
    if (status === 'open') p.status = 'todo,in_progress';
    else if (status !== 'all') p.status = status;
    if (tab === 'mine') p.mine = 'true';
    if (tab === 'by-me') p.assigned_by_me = 'true';
    if (tab === 'team' && personFilter) p.assigned_to = String(personFilter);
    return p;
  }

  function renderTable(): void {
    const forMe = tab === 'mine';
    $('tk-th-person').textContent = forMe ? 'Assigned by' : 'Assigned to';
    $('tk-count').textContent = `${tasks.length} task${tasks.length === 1 ? '' : 's'}`;
    $('tk-tbody').innerHTML = tasks.length
      ? tasks
          .map((t) => {
            const who = forMe ? t.assignedBy : t.assignedTo;
            const due = t.dueDate ? `<span class="${t.isOverdue ? 'tk-late' : ''}">${esc(t.dueDate)}${t.isOverdue ? ' (overdue)' : ''}</span>` : '—';
            const prio = t.priority === 'high' ? '<span class="tk-prio-high">HIGH</span>' : '';
            return `<tr class="tk-row" data-id="${t.id}"><td>${esc(t.title)}${prio}</td><td>${esc(who.name)}<span class="tk-sub">${esc(who.position)}</span></td><td>${due}</td><td><span class="tk-pill ${t.status}">${esc(t.statusLabel)}</span></td><td><button type="button" class="btn-ghost-sm">Open</button></td></tr>`;
          })
          .join('')
      : `<tr><td colspan="5" class="pu-empty">${tab === 'mine' ? 'No tasks for you here.' : 'Nothing here.'}</td></tr>`;
    document.querySelectorAll<HTMLElement>('.tk-row').forEach((row) => row.addEventListener('click', () => void openTask(Number(row.dataset.id))));
  }

  function renderSummary(): void {
    if (!summary) return;
    $('tk-k-open').textContent = String(summary.mine.open);
    $('tk-k-over').textContent = String(summary.mine.overdue);
    $('tk-k-done').textContent = String(summary.mine.doneThisWeek);
    if (summary.team) {
      $('tk-k-team').hidden = false;
      $('tk-k-topen').textContent = String(summary.team.open);
      $('tk-k-tsub').textContent = `${summary.team.overdue} overdue`;
    }
    const card = $('tk-people-card');
    card.hidden = !(tab === 'team' && summary.team);
    $('tk-people').innerHTML = summary.people
      .map((p) => `<tr class="tk-row" data-person="${p.id}"><td>${esc(p.name)}${personFilter === p.id ? ' •' : ''}</td><td class="num">${p.open}</td><td class="num${p.overdue ? ' tk-late' : ''}">${p.overdue}</td><td class="num">${p.done}</td></tr>`)
      .join('');
    document.querySelectorAll<HTMLElement>('[data-person]').forEach((row) =>
      row.addEventListener('click', () => {
        const id = Number(row.dataset.person);
        personFilter = personFilter === id ? null : id;
        void load();
      }),
    );
  }

  async function load(): Promise<void> {
    try {
      [tasks, summary] = await Promise.all([listTasks(params()), getTaskSummary()]);
      notice(readOnly ? 'Read-only: you are viewing this business from the company owner account.' : null);
    } catch (e) {
      tasks = [];
      notice(message(e));
    }
    renderSummary();
    renderTable();
  }

  // ---- detail -------------------------------------------------------------
  function eventText(e: Task['events'][number]): string {
    if (e.kind === 'status') return `Status: ${STATUS_TEXT[e.fromStatus] ?? e.fromStatus} → ${STATUS_TEXT[e.toStatus] ?? e.toStatus}${e.note ? ` — ${e.note}` : ''}`;
    if (e.kind === 'comment') return `“${e.note}”`;
    return e.note || e.kind;
  }

  function paintDetail(t: Task): void {
    openId = t.id;
    $('td-title').innerHTML = `${esc(t.title)} <span class="tk-pill ${t.status}">${esc(t.statusLabel)}</span>`;
    $('td-meta').textContent = `For ${t.assignedTo.name} · from ${t.assignedBy.name} · ${t.dueDate ? `due ${t.dueDate}${t.isOverdue ? ' (overdue)' : ''}` : 'no due date'} · ${t.priorityLabel} priority`;
    $('td-desc').textContent = t.description;
    $('td-desc').hidden = !t.description;
    const mine = t.assignedTo.id === me;
    const live = t.status === 'todo' || t.status === 'in_progress';
    const buttons: string[] = [];
    if (!readOnly && (mine || canEdit) && live) {
      if (t.status === 'todo') buttons.push('<button type="button" class="btn-ghost-sm" data-do="in_progress">Start</button>');
      buttons.push('<button type="button" class="btn-primary-sm" data-do="done">Mark done</button>');
    }
    if (!readOnly && (mine || canEdit) && t.status === 'done') buttons.push('<button type="button" class="btn-ghost-sm" data-do="in_progress">Reopen</button>');
    if (canEdit && t.status !== 'cancelled') buttons.push('<button type="button" class="btn-ghost-sm" data-do="edit">Edit / reassign</button>');
    if (canCancel && live) buttons.push('<button type="button" class="btn-ghost-sm" data-do="cancel">Cancel task</button>');
    $('td-actions').innerHTML = buttons.join('');
    $('td-note-wrap').hidden = !buttons.some((b) => b.includes('data-do="done"') || b.includes('cancel'));
    ($('td-note') as HTMLInputElement).value = '';
    $('td-events').innerHTML = t.events
      .map((e) => `<li class="td-event">${esc(eventText(e))}<small>${esc(e.actorName)} · ${esc(when(e.createdAt))}</small></li>`)
      .join('');
    $('td-actions').querySelectorAll<HTMLButtonElement>('[data-do]').forEach((b) => b.addEventListener('click', () => void act(t, b.dataset.do!)));
  }

  async function openTask(id: number): Promise<void> {
    try {
      const t = await getTask(id);
      $('td-error').hidden = true;
      paintDetail(t);
      const dlg = $('tk-dlg') as HTMLDialogElement;
      if (!dlg.open) dlg.showModal();
    } catch (e) {
      notice(message(e));
    }
  }

  async function act(t: Task, what: string): Promise<void> {
    const err = $('td-error');
    err.hidden = true;
    const note = ($('td-note') as HTMLInputElement).value.trim();
    try {
      let updated: Task;
      if (what === 'edit') {
        openForm(t);
        return;
      }
      if (what === 'cancel') updated = await cancelTask(t.id, note);
      else updated = await setTaskStatus(t.id, what as TaskStatus, what === 'done' ? note : '');
      paintDetail(updated);
      void load();
    } catch (e) {
      err.textContent = message(e);
      err.hidden = false;
    }
  }

  $('td-send').addEventListener('click', async () => {
    const input = $('td-comment') as HTMLInputElement;
    const text = input.value.trim();
    if (!text || openId === null) return;
    try {
      paintDetail(await commentOnTask(openId, text));
      input.value = '';
    } catch (e) {
      $('td-error').textContent = message(e);
      $('td-error').hidden = false;
    }
  });
  $('td-close').addEventListener('click', () => ($('tk-dlg') as HTMLDialogElement).close());

  // ---- assign / edit ------------------------------------------------------
  async function openForm(task: Task | null): Promise<void> {
    editing = task;
    $('tf-error').hidden = true;
    $('tk-form-title').textContent = task ? 'Edit task' : 'Assign a task';
    $('tf-save').textContent = task ? 'Save' : 'Assign';
    try {
      if (!people.length) people = await listAssignees();
    } catch {
      people = [];
    }
    ($('tf-who') as HTMLSelectElement).innerHTML = people.length
      ? people.map((p) => `<option value="${p.id}">${esc(p.name)}${p.position ? ` — ${esc(p.position)}` : ''}</option>`).join('')
      : '<option value="">No staff to assign to yet</option>';
    ($('tf-title') as HTMLInputElement).value = task?.title ?? '';
    ($('tf-desc') as HTMLTextAreaElement).value = task?.description ?? '';
    ($('tf-due') as HTMLInputElement).value = task?.dueDate ?? '';
    ($('tf-priority') as HTMLSelectElement).value = task?.priority ?? 'normal';
    if (task) ($('tf-who') as HTMLSelectElement).value = String(task.assignedTo.id);
    const dlg = $('tk-form-dlg') as HTMLDialogElement;
    if (!dlg.open) dlg.showModal();
  }

  $('tk-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const err = $('tf-error');
    err.hidden = true;
    const whoValue = ($('tf-who') as HTMLSelectElement).value;
    if (!whoValue) {
      err.textContent = 'Choose who to assign it to.';
      err.hidden = false;
      return;
    }
    const input = {
      title: ($('tf-title') as HTMLInputElement).value.trim(),
      description: ($('tf-desc') as HTMLTextAreaElement).value.trim(),
      dueDate: ($('tf-due') as HTMLInputElement).value || null,
      priority: ($('tf-priority') as HTMLSelectElement).value as 'low' | 'normal' | 'high',
      assignedTo: Number(whoValue),
    };
    const btn = $('tf-save') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const saved = editing ? await editTask(editing.id, input) : await createTask(input);
      ($('tk-form-dlg') as HTMLDialogElement).close();
      await load();
      if (editing) paintDetail(saved);
    } catch (e) {
      err.textContent = message(e);
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });
  $('tf-cancel').addEventListener('click', () => ($('tk-form-dlg') as HTMLDialogElement).close());

  // ---- wiring -------------------------------------------------------------
  document.querySelectorAll<HTMLElement>('.tk-tab').forEach((el) =>
    el.addEventListener('click', () => {
      tab = el.dataset.tab as Tab;
      personFilter = null;
      document.querySelectorAll('.tk-tab').forEach((x) => x.classList.toggle('is-active', x === el));
      void load();
    }),
  );
  $('tk-status').addEventListener('change', () => void load());
  $('tk-refresh').addEventListener('click', () => void load());
  $('tk-new').addEventListener('click', () => void openForm(null));

  $('tk-new').hidden = !canAssign;
  document.querySelector<HTMLElement>('[data-tab="by-me"]')!.hidden = !canAssign;
  document.querySelector<HTMLElement>('[data-tab="team"]')!.hidden = !canSeeAll;
  if (canSeeAll) $('tk-sub').textContent = 'Work handed to you, and (under Everyone) what the whole team is doing.';

  void load().then(() => {
    const id = Number(new URLSearchParams(window.location.search).get('id'));
    if (id) void openTask(id);
  });
</script>
