---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.customers;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="cus-page" id="cus-page">
    <div class="cus-toolbar">
      <div>
        <p class="cus-scope" id="cus-scope">Branch customers</p>
        <h2 class="cus-heading">Customer directory</h2>
      </div>
      <button type="button" class="btn-primary-sm" id="cus-add">+ New customer</button>
    </div>

    <p class="cus-form-error" id="cus-load-error" role="alert" hidden></p>

    <div class="cus-kpis">
      <article class="cus-kpi">
        <span class="cus-kpi-label">Total</span>
        <strong id="kpi-total">—</strong>
      </article>
      <article class="cus-kpi">
        <span class="cus-kpi-label">Active</span>
        <strong id="kpi-active">—</strong>
      </article>
      <article class="cus-kpi">
        <span class="cus-kpi-label">Receivable</span>
        <strong id="kpi-recv">—</strong>
      </article>
      <article class="cus-kpi is-danger">
        <span class="cus-kpi-label">With dues</span>
        <strong id="kpi-dues">—</strong>
      </article>
    </div>

    <div class="cus-layout">
      <section class="cus-list-panel">
        <div class="cus-filters">
          <div class="cus-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" id="cus-search" placeholder="Search name, phone, PAN…" autocomplete="off" />
          </div>
          <select id="cus-type-filter">
            <option value="">All types</option>
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
          <select id="cus-status-filter">
            <option value="">All status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
          <label class="cus-dues-toggle">
            <input type="checkbox" id="cus-dues-filter" />
            <span>Has dues</span>
          </label>
        </div>

        <div class="cus-table-wrap">
          <table class="cus-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Phone</th>
                <th class="num">Owes you</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="cus-tbody">
              <tr><td colspan="5">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cus-footnote" id="cus-count"></p>
      </section>

      <aside class="cus-detail" id="cus-detail">
        <div class="cus-detail-empty" id="cus-detail-empty">
          <p>Select a customer to view details</p>
          <p class="muted">Used in Sales, receipts and ledgers</p>
        </div>

        <div class="cus-detail-body" id="cus-detail-body" hidden>
          <header class="cus-detail-head">
            <div>
              <p class="cus-detail-code" id="d-code">—</p>
              <h3 id="d-name">—</h3>
              <span class="cus-badge" id="d-status">—</span>
            </div>
            <div class="cus-detail-actions">
              <button type="button" class="btn-ghost-sm" id="cus-edit">Edit</button>
              <button type="button" class="btn-ghost-sm is-danger" id="cus-toggle">Deactivate</button>
            </div>
          </header>

          <p class="cus-limit-warn" id="d-limit-warn" role="status" hidden>
            Owes more than the credit limit. Sales are still allowed.
          </p>

          <dl class="cus-dl">
            <div><dt>Type</dt><dd id="d-type">—</dd></div>
            <div><dt>Phone</dt><dd id="d-phone">—</dd></div>
            <div><dt>Email</dt><dd id="d-email">—</dd></div>
            <div><dt>PAN</dt><dd id="d-pan">—</dd></div>
            <div class="span2"><dt>Address</dt><dd id="d-address">—</dd></div>
            <div><dt>Owes you</dt><dd id="d-owes">—</dd></div>
            <div><dt>Credit limit</dt><dd id="d-credit">—</dd></div>
            <div><dt>You owe them</dt><dd id="d-credit-to-pay">—</dd></div>
            <div><dt>Advance received</dt><dd id="d-advance">—</dd></div>
            <div><dt>Total sales</dt><dd id="d-total">—</dd></div>
            <div><dt>Replacement due</dt><dd id="d-stock">—</dd></div>
            <div class="span2"><dt>Notes</dt><dd id="d-notes">—</dd></div>
          </dl>

          <p class="cus-detail-meta" id="d-meta"></p>

          <section class="cus-stmt" aria-label="Statement">
            <div class="cus-stmt-head">
              <h4>Statement</h4>
              <div class="cus-stmt-actions">
                <button type="button" class="btn-ghost-sm" id="stmt-xlsx">Excel</button>
                <button type="button" class="btn-ghost-sm" id="stmt-pdf">PDF</button>
              </div>
            </div>
            <div class="cus-stmt-filters">
              <label><span>From</span><input type="date" id="stmt-from" /></label>
              <label><span>To</span><input type="date" id="stmt-to" /></label>
              <label>
                <span>Type</span>
                <select id="stmt-type">
                  <option value="">All</option>
                  <option value="sale">Sales</option>
                  <option value="payment">Payments</option>
                  <option value="return">Returns</option>
                  <option value="refund">Refunds</option>
                  <option value="replacement">Replacements</option>
                  <option value="adjustment">Credit adjustments</option>
                </select>
              </label>
            </div>
            <p class="cus-stmt-error" id="stmt-error" role="alert" hidden></p>
            <p class="cus-stmt-totals" id="stmt-totals"></p>
            <div class="cus-stmt-wrap">
              <table class="cus-stmt-table">
                <thead>
                  <tr><th>Date</th><th>Type</th><th>Reference</th><th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th></tr>
                </thead>
                <tbody id="stmt-tbody"></tbody>
              </table>
            </div>
            <button type="button" class="btn-ghost-sm" id="stmt-more" hidden>Load more</button>
            <p class="cus-hint" id="stmt-hint">Positive balance: the customer owes you. Negative: you owe the customer.</p>
          </section>
        </div>
      </aside>
    </div>
  </div>

  <dialog class="cus-dialog" id="cus-dialog">
    <form class="cus-dialog-inner" id="cus-form">
      <h2 class="cus-dialog-title" id="cus-form-title">New customer</h2>
      <input type="hidden" id="f-id" />

      <div class="cus-form-grid">
        <label class="cus-field span2">
          <span>Name *</span>
          <input type="text" id="f-name" required placeholder="Full name or company" />
        </label>
        <label class="cus-field">
          <span>Type</span>
          <select id="f-type">
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Status</span>
          <select id="f-status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Phone</span>
          <input type="tel" id="f-phone" placeholder="98XXXXXXXX (optional)" />
        </label>
        <label class="cus-field">
          <span>Email</span>
          <input type="email" id="f-email" placeholder="optional" />
        </label>
        <label class="cus-field span2">
          <span>Address</span>
          <input type="text" id="f-address" />
        </label>
        <label class="cus-field">
          <span>PAN / VAT number</span>
          <input type="text" id="f-pan" placeholder="optional" />
        </label>
        <label class="cus-field">
          <span>Credit limit (NPR)</span>
          <input type="number" id="f-credit" min="0" step="1000" value="0" />
          <small class="cus-field-hint">0 means no limit. Going over only shows a warning.</small>
        </label>
        <label class="cus-field span2">
          <span>Notes</span>
          <input type="text" id="f-notes" />
        </label>
      </div>

      <p class="cus-form-error" id="f-error" hidden></p>

      <div class="cus-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="f-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="f-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import { getSession, refreshProfile } from '../../lib/auth';
  import { ApiError } from '../../lib/api';
  import {
    listCustomers,
    createCustomer,
    updateCustomer,
    setCustomerActive,
    getCustomerSummary,
    getStatement,
    downloadStatement,
    formatNpr,
    TYPE_LABEL,
    STATEMENT_TYPES,
    type Customer,
    type CustomerInput,
    type CustomerType,
    type StatementFilters,
    type StatementRow,
    type StatementType,
  } from '../../lib/customers';

  if (!getSession()) window.location.replace('/');

  let customers: Customer[] = [];
  let selectedId: number | null = null;
  let canWrite = true;

  let stmtPage = 1;
  let stmtRows: StatementRow[] = [];
  let stmtToken = 0;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = (id: string) => $<HTMLInputElement>(id)!;

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  const FIELD_LABELS: Record<string, string> = {
    name: 'Name',
    customer_type: 'Type',
    phone: 'Phone',
    email: 'Email',
    address: 'Address',
    pan_number: 'PAN',
    notes: 'Notes',
    credit_limit: 'Credit limit',
    is_active: 'Status',
    date_from: 'From',
    date_to: 'To',
  };

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    const entries = Object.entries(error.fields);
    if (entries.length > 0 && error.status === 400) {
      return entries.map(([key, msg]) => `${FIELD_LABELS[key] ?? key}: ${msg}`).join(' ');
    }
    return error.message;
  }

  function setText(id: string, value: string): void {
    const el = $(id);
    if (el) el.textContent = value || '—';
  }

  function showBox(id: string, message: string | null): void {
    const el = $(id);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  function selected(): Customer | null {
    return customers.find((c) => c.id === selectedId) ?? null;
  }

  function filtered(): Customer[] {
    const q = (input('cus-search').value ?? '').trim().toLowerCase();
    const type = $<HTMLSelectElement>('cus-type-filter')?.value ?? '';
    const st = $<HTMLSelectElement>('cus-status-filter')?.value ?? '';
    const dues = input('cus-dues-filter').checked;

    return customers.filter((c) => {
      if (type && c.type !== type) return false;
      if (st === 'active' && !c.isActive) return false;
      if (st === 'inactive' && c.isActive) return false;
      if (dues && c.creditToReceive <= 0) return false;
      if (!q) return true;
      return (
        c.name.toLowerCase().includes(q) ||
        c.phone.includes(q) ||
        c.pan.toLowerCase().includes(q) ||
        c.email.toLowerCase().includes(q)
      );
    });
  }

  function renderKpis(): void {
    const s = getCustomerSummary(customers);
    setText('kpi-total', String(s.total));
    setText('kpi-active', String(s.active));
    setText('kpi-recv', formatNpr(s.receivable));
    setText('kpi-dues', String(s.withDues));
  }

  function renderTable(): void {
    const tbody = $('cus-tbody');
    const count = $('cus-count');
    if (!tbody) return;
    const rows = filtered();
    if (rows.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="cus-empty">No customers found.</td></tr>`;
      if (count) count.textContent = '0 customers';
      return;
    }
    tbody.innerHTML = rows
      .map((c) => {
        const active = c.id === selectedId ? ' is-selected' : '';
        const over = c.overCreditLimit ? ' <span class="cus-over" title="Over credit limit">over limit</span>' : '';
        return `<tr class="cus-row${active}" data-id="${c.id}">
          <td><strong>${esc(c.name)}</strong></td>
          <td>${esc(TYPE_LABEL[c.type] ?? c.type)}</td>
          <td>${esc(c.phone) || '—'}</td>
          <td class="num">${formatNpr(c.creditToReceive)}${over}</td>
          <td><span class="cus-badge cus-badge-${c.isActive ? 'active' : 'inactive'}">${c.isActive ? 'Active' : 'Inactive'}</span></td>
        </tr>`;
      })
      .join('');
    if (count) count.textContent = `${rows.length} customer${rows.length === 1 ? '' : 's'} · active branch only`;

    tbody.querySelectorAll<HTMLTableRowElement>('.cus-row').forEach((row) => {
      row.addEventListener('click', () => {
        selectedId = Number(row.dataset.id) || null;
        renderTable();
        renderDetail();
        void loadStatement(true);
      });
    });
  }

  function renderDetail(): void {
    const empty = $('cus-detail-empty');
    const body = $('cus-detail-body');
    const c = selected();
    if (!c) {
      selectedId = null;
      empty?.removeAttribute('hidden');
      body?.setAttribute('hidden', '');
      return;
    }
    empty?.setAttribute('hidden', '');
    body?.removeAttribute('hidden');

    setText('d-code', `Customer #${c.id}`);
    setText('d-name', c.name);
    setText('d-type', TYPE_LABEL[c.type] ?? c.type);
    setText('d-phone', c.phone);
    setText('d-email', c.email);
    setText('d-pan', c.pan);
    setText('d-address', c.address);
    setText('d-owes', formatNpr(c.creditToReceive));
    setText('d-credit', c.creditLimit > 0 ? formatNpr(c.creditLimit) : 'No limit');
    setText('d-credit-to-pay', formatNpr(c.creditToPay));
    setText('d-advance', formatNpr(c.advanceReceived));
    setText('d-total', formatNpr(c.totalSales));
    setText('d-stock', String(c.stockToGive));
    setText('d-notes', c.notes);
    setText(
      'd-meta',
      `Created ${new Date(c.createdAt).toLocaleDateString()} · Updated ${new Date(c.updatedAt).toLocaleDateString()}`,
    );

    const warn = $('d-limit-warn');
    if (warn) warn.hidden = !c.overCreditLimit;

    const st = $('d-status');
    if (st) {
      st.textContent = c.isActive ? 'Active' : 'Inactive';
      st.className = `cus-badge cus-badge-${c.isActive ? 'active' : 'inactive'}`;
    }
    const toggle = $('cus-toggle');
    if (toggle) toggle.textContent = c.isActive ? 'Deactivate' : 'Reactivate';
  }

  // ---------- statement ----------

  function stmtFilters(): StatementFilters {
    return {
      dateFrom: input('stmt-from').value,
      dateTo: input('stmt-to').value,
      type: ($<HTMLSelectElement>('stmt-type')?.value ?? '') as StatementType | '',
    };
  }

  function renderStatementRows(): void {
    const tbody = $('stmt-tbody');
    if (!tbody) return;
    if (stmtRows.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="cus-empty">No transactions.</td></tr>`;
      return;
    }
    tbody.innerHTML = stmtRows
      .map((r) => {
        const label = STATEMENT_TYPES[r.type as StatementType] ?? r.type;
        return `<tr>
          <td>${esc(r.date)}</td>
          <td>${esc(label)}</td>
          <td title="${esc(r.description)}">${esc(r.reference) || '—'}</td>
          <td class="num">${r.debit ? formatNpr(r.debit) : ''}</td>
          <td class="num">${r.credit ? formatNpr(r.credit) : ''}</td>
          <td class="num">${formatNpr(r.balance)}</td>
        </tr>`;
      })
      .join('');
  }

  async function loadStatement(reset: boolean): Promise<void> {
    const c = selected();
    const more = $<HTMLButtonElement>('stmt-more');
    if (!c) return;

    if (reset) {
      stmtPage = 1;
      stmtRows = [];
      renderStatementRows();
      setText('stmt-totals', '');
      if (more) more.hidden = true;
    }
    showBox('stmt-error', null);

    const token = ++stmtToken;
    try {
      const data = await getStatement(c.id, stmtFilters(), stmtPage);
      if (token !== stmtToken) return; // a newer request replaced this one

      stmtRows = stmtRows.concat(data.rows);
      renderStatementRows();
      const totals = $('stmt-totals');
      if (totals) {
        totals.textContent =
          `Opening ${formatNpr(data.openingBalance)} · Debit ${formatNpr(data.totalDebit)} · ` +
          `Credit ${formatNpr(data.totalCredit)} · Closing ${formatNpr(data.closingBalance)}`;
      }
      if (more) more.hidden = !data.hasMore;
    } catch (error) {
      if (token !== stmtToken) return;
      showBox('stmt-error', describe(error));
    }
  }

  $('stmt-more')?.addEventListener('click', () => {
    stmtPage += 1;
    void loadStatement(false);
  });
  for (const id of ['stmt-from', 'stmt-to', 'stmt-type']) {
    $(id)?.addEventListener('change', () => void loadStatement(true));
  }

  async function download(file: 'xlsx' | 'pdf'): Promise<void> {
    const c = selected();
    if (!c) return;
    const button = $<HTMLButtonElement>(file === 'xlsx' ? 'stmt-xlsx' : 'stmt-pdf')!;
    button.disabled = true;
    showBox('stmt-error', null);
    try {
      await downloadStatement(c.id, file, stmtFilters());
    } catch (error) {
      showBox('stmt-error', describe(error));
    } finally {
      button.disabled = false;
    }
  }
  $('stmt-xlsx')?.addEventListener('click', () => void download('xlsx'));
  $('stmt-pdf')?.addEventListener('click', () => void download('pdf'));

  // ---------- load + write access ----------

  function applyWriteAccess(): void {
    // A company owner has read-only access inside a branch.
    canWrite = getSession()?.accessMode !== 'read_only';
    for (const id of ['cus-add', 'cus-edit', 'cus-toggle']) {
      const el = $(id);
      if (el) el.hidden = !canWrite;
    }
  }

  async function reload(): Promise<void> {
    const sess = getSession();
    const scope = $('cus-scope');
    if (scope && sess) scope.textContent = `${sess.activeBranchName} (${sess.activeBranchCode})`;
    applyWriteAccess();

    try {
      customers = await listCustomers();
      showBox('cus-load-error', canWrite ? null : 'Read-only: you are viewing this branch from Head Office.');
    } catch (error) {
      customers = [];
      showBox('cus-load-error', describe(error));
    }

    if (selectedId && !selected()) selectedId = null;
    renderKpis();
    renderTable();
    renderDetail();
  }

  // ---------- form ----------

  const dialog = $<HTMLDialogElement>('cus-dialog');
  const form = $<HTMLFormElement>('cus-form');

  function openForm(edit?: Customer): void {
    setText('cus-form-title', edit ? 'Edit customer' : 'New customer');
    input('f-id').value = edit ? String(edit.id) : '';
    input('f-name').value = edit?.name ?? '';
    $<HTMLSelectElement>('f-type')!.value = edit?.type ?? 'individual';
    $<HTMLSelectElement>('f-status')!.value = edit && !edit.isActive ? 'inactive' : 'active';
    input('f-phone').value = edit?.phone ?? '';
    input('f-email').value = edit?.email ?? '';
    input('f-address').value = edit?.address ?? '';
    input('f-pan').value = edit?.pan ?? '';
    input('f-credit').value = String(edit?.creditLimit ?? 0);
    input('f-notes').value = edit?.notes ?? '';
    showBox('f-error', null);
    dialog?.showModal();
  }

  $('cus-add')?.addEventListener('click', () => openForm());
  $('cus-edit')?.addEventListener('click', () => {
    const c = selected();
    if (c) openForm(c);
  });
  $('f-cancel')?.addEventListener('click', () => dialog?.close());

  $('cus-toggle')?.addEventListener('click', async () => {
    const c = selected();
    if (!c) return;
    const next = !c.isActive;
    if (!next && !confirm(`Deactivate ${c.name}? They will no longer be offered on new sales.`)) return;

    const button = $<HTMLButtonElement>('cus-toggle')!;
    button.disabled = true;
    try {
      await setCustomerActive(c.id, next);
      await reload();
    } catch (error) {
      alert(describe(error));
    } finally {
      button.disabled = false;
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const save = $<HTMLButtonElement>('f-save');
    showBox('f-error', null);

    const id = Number(input('f-id').value) || null;
    const payload: CustomerInput = {
      name: input('f-name').value,
      type: $<HTMLSelectElement>('f-type')!.value as CustomerType,
      isActive: $<HTMLSelectElement>('f-status')!.value === 'active',
      phone: input('f-phone').value,
      email: input('f-email').value,
      address: input('f-address').value,
      pan: input('f-pan').value,
      creditLimit: Number(input('f-credit').value || 0),
      notes: input('f-notes').value,
    };

    if (!payload.name.trim()) {
      showBox('f-error', 'Name is required.');
      return;
    }

    if (save) save.disabled = true;
    try {
      const saved = id ? await updateCustomer(id, payload) : await createCustomer(payload);
      selectedId = saved.id;
      dialog?.close();
      await reload();
      void loadStatement(true);
    } catch (error) {
      showBox('f-error', describe(error));
    } finally {
      if (save) save.disabled = false;
    }
  });

  $('cus-search')?.addEventListener('input', () => renderTable());
  $('cus-type-filter')?.addEventListener('change', () => renderTable());
  $('cus-status-filter')?.addEventListener('change', () => renderTable());
  $('cus-dues-filter')?.addEventListener('change', () => renderTable());

  void reload();
  refreshProfile().then(applyWriteAccess).catch(() => {});
</script>

<style>
  .cus-page { display: flex; flex-direction: column; gap: 14px; }

  .cus-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cus-scope { margin: 0 0 2px; font-size: 0.75rem; color: var(--text-muted); }
  .cus-heading { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.02em; }

  .btn-primary-sm, .btn-ghost-sm {
    height: 34px; padding: 0 12px; border-radius: 8px;
    font-family: inherit; font-size: 0.8rem; font-weight: 650; cursor: pointer;
  }
  .btn-primary-sm { border: none; background: var(--accent); color: #fff; }
  .btn-ghost-sm { border: 1px solid var(--border); background: transparent; color: var(--text-secondary); }
  .btn-ghost-sm:hover { background: var(--surface-hover); color: var(--text-primary); }
  .btn-ghost-sm.is-danger { color: #ef334e; border-color: color-mix(in srgb, #ef334e 35%, var(--border)); }

  .cus-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
