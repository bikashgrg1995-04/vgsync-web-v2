---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.customers;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="cus-page" id="cus-page">
    <div class="cus-toolbar">
      <div>
        <p class="cus-scope" id="cus-scope">Branch customers</p>
        <h2 class="cus-heading">Customer directory</h2>
      </div>
      <button type="button" class="btn-primary-sm" id="cus-add">+ New customer</button>
    </div>

    <div class="cus-kpis">
      <article class="cus-kpi">
        <span class="cus-kpi-label">Total</span>
        <strong id="kpi-total">—</strong>
      </article>
      <article class="cus-kpi">
        <span class="cus-kpi-label">Active</span>
        <strong id="kpi-active">—</strong>
      </article>
      <article class="cus-kpi">
        <span class="cus-kpi-label">Receivable</span>
        <strong id="kpi-recv">—</strong>
      </article>
      <article class="cus-kpi is-danger">
        <span class="cus-kpi-label">Blocked</span>
        <strong id="kpi-blocked">—</strong>
      </article>
    </div>

    <div class="cus-layout">
      <section class="cus-list-panel">
        <div class="cus-filters">
          <div class="cus-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" id="cus-search" placeholder="Search name, phone, code…" autocomplete="off" />
          </div>
          <select id="cus-type-filter">
            <option value="">All types</option>
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
          <select id="cus-status-filter">
            <option value="">All status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="blocked">Blocked</option>
          </select>
        </div>

        <div class="cus-table-wrap">
          <table class="cus-table">
            <thead>
              <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Type</th>
                <th>Phone</th>
                <th class="num">Balance</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="cus-tbody">
              <tr><td colspan="6">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cus-footnote" id="cus-count"></p>
      </section>

      <aside class="cus-detail" id="cus-detail">
        <div class="cus-detail-empty" id="cus-detail-empty">
          <p>Select a customer to view details</p>
          <p class="muted">Used in Sales, receipts and ledgers</p>
        </div>

        <div class="cus-detail-body" id="cus-detail-body" hidden>
          <header class="cus-detail-head">
            <div>
              <p class="cus-detail-code" id="d-code">—</p>
              <h3 id="d-name">—</h3>
              <span class="cus-badge" id="d-status">—</span>
            </div>
            <div class="cus-detail-actions">
              <button type="button" class="btn-ghost-sm" id="cus-edit">Edit</button>
              <button type="button" class="btn-ghost-sm is-danger" id="cus-delete">Delete</button>
            </div>
          </header>

          <dl class="cus-dl">
            <div><dt>Type</dt><dd id="d-type">—</dd></div>
            <div><dt>Phone</dt><dd id="d-phone">—</dd></div>
            <div><dt>Email</dt><dd id="d-email">—</dd></div>
            <div><dt>City</dt><dd id="d-city">—</dd></div>
            <div class="span2"><dt>Address</dt><dd id="d-address">—</dd></div>
            <div><dt>PAN</dt><dd id="d-pan">—</dd></div>
            <div><dt>Credit limit</dt><dd id="d-credit">—</dd></div>
            <div><dt>Balance</dt><dd id="d-balance">—</dd></div>
            <div class="span2"><dt>Notes</dt><dd id="d-notes">—</dd></div>
          </dl>

          <p class="cus-detail-meta" id="d-meta"></p>

          <div class="cus-detail-links">
            <span class="chip">Sales invoices</span>
            <span class="chip">Receipts</span>
            <span class="chip">Ledger</span>
          </div>
          <p class="cus-hint">Sales &amp; payments will reference this customer record by ID/code.</p>
        </div>
      </aside>
    </div>
  </div>

  <dialog class="cus-dialog" id="cus-dialog">
    <form class="cus-dialog-inner" id="cus-form">
      <h2 class="cus-dialog-title" id="cus-form-title">New customer</h2>
      <input type="hidden" id="f-id" />

      <div class="cus-form-grid">
        <label class="cus-field span2">
          <span>Name *</span>
          <input type="text" id="f-name" required placeholder="Full name or company" />
        </label>
        <label class="cus-field">
          <span>Type</span>
          <select id="f-type">
            <option value="individual">Individual</option>
            <option value="business">Business</option>
            <option value="fleet">Fleet</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Status</span>
          <select id="f-status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="blocked">Blocked</option>
          </select>
        </label>
        <label class="cus-field">
          <span>Phone *</span>
          <input type="tel" id="f-phone" required placeholder="98XXXXXXXX" />
        </label>
        <label class="cus-field">
          <span>Email</span>
          <input type="email" id="f-email" placeholder="optional" />
        </label>
        <label class="cus-field span2">
          <span>Address</span>
          <input type="text" id="f-address" />
        </label>
        <label class="cus-field">
          <span>City</span>
          <input type="text" id="f-city" />
        </label>
        <label class="cus-field">
          <span>PAN</span>
          <input type="text" id="f-pan" />
        </label>
        <label class="cus-field">
          <span>Credit limit (NPR)</span>
          <input type="number" id="f-credit" min="0" step="1000" value="0" />
        </label>
        <label class="cus-field span2">
          <span>Notes</span>
          <input type="text" id="f-notes" />
        </label>
      </div>

      <p class="cus-form-error" id="f-error" hidden></p>

      <div class="cus-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="f-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="f-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import { getSession } from '../../lib/auth';
  import {
    listCustomersByBranch,
    getCustomerSummary,
    getCustomerById,
    createCustomer,
    updateCustomer,
    deleteCustomer,
    formatNpr,
    TYPE_LABEL,
    STATUS_LABEL,
    type Customer,
    type CustomerType,
    type CustomerStatus,
  } from '../../lib/customers';

  if (!getSession()) window.location.replace('/');

  let customers: Customer[] = [];
  let selectedId: string | null = null;

  function branchCode(): string {
    return getSession()?.activeBranchCode ?? 'HO';
  }

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function filtered(): Customer[] {
    const q = (document.getElementById('cus-search') as HTMLInputElement)?.value.trim().toLowerCase() ?? '';
    const type = (document.getElementById('cus-type-filter') as HTMLSelectElement)?.value ?? '';
    const st = (document.getElementById('cus-status-filter') as HTMLSelectElement)?.value ?? '';
    return customers.filter((c) => {
      if (type && c.type !== type) return false;
      if (st && c.status !== st) return false;
      if (!q) return true;
      return (
        c.name.toLowerCase().includes(q) ||
        c.phone.includes(q) ||
        c.code.toLowerCase().includes(q) ||
        c.email.toLowerCase().includes(q)
      );
    });
  }

  function renderKpis(): void {
    const s = getCustomerSummary(branchCode());
    const set = (id: string, v: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    };
    set('kpi-total', String(s.total));
    set('kpi-active', String(s.active));
    set('kpi-recv', formatNpr(s.receivable));
    set('kpi-blocked', String(s.blocked));
  }

  function renderTable(): void {
    const tbody = document.getElementById('cus-tbody');
    const count = document.getElementById('cus-count');
    if (!tbody) return;
    const rows = filtered();
    if (rows.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="cus-empty">No customers found.</td></tr>`;
      if (count) count.textContent = '0 customers';
      return;
    }
    tbody.innerHTML = rows
      .map((c) => {
        const active = c.id === selectedId ? ' is-selected' : '';
        return `<tr class="cus-row${active}" data-id="${esc(c.id)}">
          <td class="mono">${esc(c.code)}</td>
          <td><strong>${esc(c.name)}</strong></td>
          <td>${esc(TYPE_LABEL[c.type])}</td>
          <td>${esc(c.phone)}</td>
          <td class="num">${formatNpr(c.balance)}</td>
          <td><span class="cus-badge cus-badge-${c.status}">${esc(STATUS_LABEL[c.status])}</span></td>
        </tr>`;
      })
      .join('');
    if (count) count.textContent = `${rows.length} customer${rows.length === 1 ? '' : 's'} · active branch only`;

    tbody.querySelectorAll<HTMLTableRowElement>('.cus-row').forEach((row) => {
      row.addEventListener('click', () => {
        selectedId = row.dataset.id || null;
        renderTable();
        renderDetail();
      });
    });
  }

  function renderDetail(): void {
    const empty = document.getElementById('cus-detail-empty');
    const body = document.getElementById('cus-detail-body');
    if (!selectedId) {
      empty?.removeAttribute('hidden');
      body?.setAttribute('hidden', '');
      return;
    }
    const c = getCustomerById(selectedId);
    if (!c) {
      selectedId = null;
      empty?.removeAttribute('hidden');
      body?.setAttribute('hidden', '');
      return;
    }
    empty?.setAttribute('hidden', '');
    body?.removeAttribute('hidden');

    const set = (id: string, v: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = v || '—';
    };
    set('d-code', c.code);
    set('d-name', c.name);
    set('d-type', TYPE_LABEL[c.type]);
    set('d-phone', c.phone);
    set('d-email', c.email);
    set('d-city', c.city);
    set('d-address', c.address);
    set('d-pan', c.pan);
    set('d-credit', formatNpr(c.creditLimit));
    set('d-balance', formatNpr(c.balance));
    set('d-notes', c.notes);
    set('d-meta', `Created ${c.createdAt} · Updated ${c.updatedAt}`);

    const st = document.getElementById('d-status');
    if (st) {
      st.textContent = STATUS_LABEL[c.status];
      st.className = `cus-badge cus-badge-${c.status}`;
    }
  }

  function reload(): void {
    const s = getSession();
    const scope = document.getElementById('cus-scope');
    if (scope && s) scope.textContent = `${s.activeBranchName} (${s.activeBranchCode})`;
    customers = listCustomersByBranch(branchCode());
    if (selectedId && !customers.some((c) => c.id === selectedId)) selectedId = null;
    renderKpis();
    renderTable();
    renderDetail();
  }

  // Form
  const dialog = document.getElementById('cus-dialog') as HTMLDialogElement | null;
  const form = document.getElementById('cus-form') as HTMLFormElement | null;

  function openForm(edit?: Customer): void {
    const title = document.getElementById('cus-form-title');
    if (title) title.textContent = edit ? 'Edit customer' : 'New customer';
    (document.getElementById('f-id') as HTMLInputElement).value = edit?.id ?? '';
    (document.getElementById('f-name') as HTMLInputElement).value = edit?.name ?? '';
    (document.getElementById('f-type') as HTMLSelectElement).value = edit?.type ?? 'individual';
    (document.getElementById('f-status') as HTMLSelectElement).value = edit?.status ?? 'active';
    (document.getElementById('f-phone') as HTMLInputElement).value = edit?.phone ?? '';
    (document.getElementById('f-email') as HTMLInputElement).value = edit?.email ?? '';
    (document.getElementById('f-address') as HTMLInputElement).value = edit?.address ?? '';
    (document.getElementById('f-city') as HTMLInputElement).value = edit?.city ?? '';
    (document.getElementById('f-pan') as HTMLInputElement).value = edit?.pan ?? '';
    (document.getElementById('f-credit') as HTMLInputElement).value = String(edit?.creditLimit ?? 0);
    (document.getElementById('f-notes') as HTMLInputElement).value = edit?.notes ?? '';
    const err = document.getElementById('f-error');
    if (err) err.hidden = true;
    dialog?.showModal();
  }

  document.getElementById('cus-add')?.addEventListener('click', () => openForm());
  document.getElementById('cus-edit')?.addEventListener('click', () => {
    if (!selectedId) return;
    const c = getCustomerById(selectedId);
    if (c) openForm(c);
  });
  document.getElementById('cus-delete')?.addEventListener('click', () => {
    if (!selectedId) return;
    const c = getCustomerById(selectedId);
    if (!c) return;
    if (!confirm(`Delete ${c.name}? This cannot be undone.`)) return;
    const res = deleteCustomer(selectedId);
    if (!res.ok) {
      alert(res.error);
      return;
    }
    selectedId = null;
    reload();
  });
  document.getElementById('f-cancel')?.addEventListener('click', () => dialog?.close());

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = (document.getElementById('f-id') as HTMLInputElement).value;
    const payload = {
      name: (document.getElementById('f-name') as HTMLInputElement).value,
      type: (document.getElementById('f-type') as HTMLSelectElement).value as CustomerType,
      status: (document.getElementById('f-status') as HTMLSelectElement).value as CustomerStatus,
      phone: (document.getElementById('f-phone') as HTMLInputElement).value,
      email: (document.getElementById('f-email') as HTMLInputElement).value,
      address: (document.getElementById('f-address') as HTMLInputElement).value,
      city: (document.getElementById('f-city') as HTMLInputElement).value,
      pan: (document.getElementById('f-pan') as HTMLInputElement).value,
      creditLimit: Number((document.getElementById('f-credit') as HTMLInputElement).value || 0),
      notes: (document.getElementById('f-notes') as HTMLInputElement).value,
    };
    const result = id
      ? updateCustomer(id, payload)
      : createCustomer(branchCode(), payload);
    const err = document.getElementById('f-error');
    if (!result.ok) {
      if (err) {
        err.hidden = false;
        err.textContent = result.error;
      }
      return;
    }
    selectedId = result.customer.id;
    dialog?.close();
    reload();
  });

  document.getElementById('cus-search')?.addEventListener('input', () => renderTable());
  document.getElementById('cus-type-filter')?.addEventListener('change', () => renderTable());
  document.getElementById('cus-status-filter')?.addEventListener('change', () => renderTable());
  document.getElementById('branch-select')?.addEventListener('change', () => setTimeout(reload, 0));

  reload();
</script>

<style>
  .cus-page { display: flex; flex-direction: column; gap: 14px; }

  .cus-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cus-scope { margin: 0 0 2px; font-size: 0.75rem; color: var(--text-muted); }
  .cus-heading { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.02em; }

  .btn-primary-sm, .btn-ghost-sm {
    height: 34px; padding: 0 12px; border-radius: 8px;
    font-family: inherit; font-size: 0.8rem; font-weight: 650; cursor: pointer;
  }
  .btn-primary-sm { border: none; background: var(--accent); color: #fff; }
  .btn-ghost-sm { border: 1px solid var(--border); background: transparent; color: var(--text-secondary); }
  .btn-ghost-sm:hover { background: var(--surface-hover); color: var(--text-primary); }
  .btn-ghost-sm.is-danger { color: #ef334e; border-color: color-mix(in srgb, #ef334e 35%, var(--border)); }

  .cus-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 700px) { .cus-kpis { grid-template-columns: repeat(2, 1fr); } }

  .cus-kpi {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-bg);
  }
  .cus-kpi-label {
    display: block; font-size: 0.68rem; font-weight: 600; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px;
  }
  .cus-kpi strong { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; }
  .cus-kpi.is-danger strong { color: #ef334e; }

  .cus-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.9fr);
    gap: 12px;
    align-items: start;
  }
  @media (max-width: 900px) { .cus-layout { grid-template-columns: 1fr; } }

  .cus-list-panel, .cus-detail {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-bg);
    padding: 12px;
  }

  .cus-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .cus-search {
    display: flex; align-items: center; gap: 8px; flex: 1; min-width: 160px;
    height: 34px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-muted);
  }
  .cus-search input {
    flex: 1; min-width: 0; border: none; outline: none; background: transparent;
    color: var(--text-primary); font-family: inherit; font-size: 0.82rem;
  }
  .cus-filters select {
    height: 34px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.8rem;
  }

  .cus-table-wrap { overflow-x: auto; }
  .cus-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .cus-table th, .cus-table td {
    padding: 9px 10px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap;
  }
  .cus-table th {
    font-size: 0.68rem; font-weight: 650; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em;
  }
  .cus-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .cus-table .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.74rem; }
  .cus-row { cursor: pointer; }
  .cus-row:hover td { background: var(--surface-hover); }
  .cus-row.is-selected td { background: var(--accent-soft); }
  .cus-empty { text-align: center !important; color: var(--text-muted); padding: 24px !important; }
  .cus-footnote { margin: 8px 0 0; font-size: 0.72rem; color: var(--text-muted); }

  .cus-badge {
    display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 999px;
    font-size: 0.68rem; font-weight: 650;
  }
  .cus-badge-active { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
  .cus-badge-inactive { background: rgba(148, 163, 184, 0.15); color: #64748b; }
  .cus-badge-blocked { background: rgba(239, 51, 78, 0.12); color: #ef334e; }

  .cus-detail-empty {
    min-height: 220px; display: grid; place-content: center; text-align: center; gap: 4px;
    color: var(--text-secondary); font-size: 0.88rem;
  }
  .cus-detail-empty .muted { font-size: 0.75rem; color: var(--text-muted); }

  .cus-detail-head {
    display: flex; justify-content: space-between; gap: 10px; margin-bottom: 14px;
  }
  .cus-detail-code { margin: 0; font-size: 0.72rem; color: var(--text-muted); font-family: ui-monospace, monospace; }
  .cus-detail-head h3 { margin: 2px 0 6px; font-size: 1rem; font-weight: 650; }
  .cus-detail-actions { display: flex; gap: 6px; flex-shrink: 0; }

  .cus-dl {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; margin: 0;
  }
  .cus-dl .span2 { grid-column: 1 / -1; }
  .cus-dl dt {
    font-size: 0.65rem; font-weight: 650; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 2px;
  }
  .cus-dl dd { margin: 0; font-size: 0.84rem; color: var(--text-primary); word-break: break-word; }

  .cus-detail-meta { margin: 12px 0 0; font-size: 0.7rem; color: var(--text-muted); }
  .cus-detail-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .chip {
    padding: 4px 8px; border-radius: 999px; font-size: 0.68rem; font-weight: 600;
    background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
  }
  .cus-hint { margin: 8px 0 0; font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; }

  .cus-dialog {
    border: none; border-radius: 14px; padding: 0; background: var(--panel-bg);
    color: var(--text-primary); box-shadow: 0 24px 60px rgba(0,0,0,0.28);
    max-width: 520px; width: calc(100% - 32px);
  }
  .cus-dialog::backdrop { background: rgba(8,15,29,0.55); backdrop-filter: blur(4px); }
  .cus-dialog-inner { padding: 20px; }
  .cus-dialog-title { margin: 0 0 14px; font-size: 1rem; font-weight: 650; }

  .cus-form-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px;
  }
  .cus-field {
    display: flex; flex-direction: column; gap: 4px;
    font-size: 0.72rem; font-weight: 600; color: var(--text-secondary);
  }
  .cus-field.span2 { grid-column: 1 / -1; }
  .cus-field input, .cus-field select {
    height: 36px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.85rem;
  }
  .cus-form-error { margin: 8px 0 0; font-size: 0.8rem; color: #ef334e; }
  .cus-dialog-actions {
    display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px;
  }

  @media (max-width: 520px) {
    .cus-form-grid { grid-template-columns: 1fr; }
    .cus-field.span2 { grid-column: auto; }
  }
</style>
