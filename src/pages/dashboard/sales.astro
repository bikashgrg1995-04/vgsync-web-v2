---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.sales;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="sa-page">
    <div class="sa-toolbar">
      <div>
        <p class="sa-scope" id="sa-scope">Sales</p>
        <div class="sa-tabs" role="tablist">
          <button type="button" class="sa-tab is-active" data-tab="list">Sales</button>
          <button type="button" class="sa-tab" data-tab="returns">Returns</button>
          <button type="button" class="sa-tab" data-tab="credits">Customer credit</button>
          <button type="button" class="sa-tab" data-tab="followups">Follow-ups</button>
          <button type="button" class="sa-tab" data-tab="bikes">Bikes &amp; local products</button>
        </div>
      </div>
      <div class="sa-toolbar-right">
        <button type="button" class="btn-ghost-sm" id="sa-refresh">Refresh</button>
        <button type="button" class="btn-primary-sm" id="sa-new" hidden>+ New sale</button>
      </div>
    </div>

    <p class="sa-notice" id="sa-notice" hidden></p>

    <div class="sa-kpis">
      <article class="sa-kpi"><span>Sales</span><strong id="kpi-count">—</strong></article>
      <article class="sa-kpi"><span>Drafts</span><strong id="kpi-drafts">—</strong></article>
      <article class="sa-kpi"><span>Total value</span><strong id="kpi-value">—</strong></article>
      <article class="sa-kpi is-danger"><span>Still to receive</span><strong id="kpi-receive">—</strong></article>
    </div>

    <!-- Sales -->
    <section class="sa-panel is-active" data-panel="list">
      <div class="sa-layout">
        <div class="sa-card">
          <div class="sa-filters">
            <input type="search" id="f-search" placeholder="Search customer, phone or chassis…" autocomplete="off" />
            <select id="f-status" aria-label="Status">
              <option value="">All status</option>
              <option value="draft">Draft</option>
              <option value="confirmed">Confirmed</option>
              <option value="cancelled">Cancelled</option>
            </select>
            <select id="f-type" aria-label="Kind">
              <option value="">All kinds</option>
              <option value="stock">Stock sale</option>
              <option value="bike">Bike sale</option>
              <option value="maintenance">Maintenance</option>
            </select>
            <select id="f-pay" aria-label="Payment">
              <option value="">All payments</option>
              <option value="unpaid">Unpaid</option>
              <option value="partial">Part paid</option>
              <option value="paid">Paid</option>
            </select>
            <input type="date" id="f-from" aria-label="From" />
            <input type="date" id="f-to" aria-label="To" />
          </div>
          <div class="sa-table-wrap">
            <table class="sa-table">
              <thead>
                <tr>
                  <th>Invoice</th><th>Date</th><th>Customer</th><th>Kind</th><th>Status</th>
                  <th class="num">Total</th><th class="num">Paid</th><th class="num">Due</th><th>Payment</th>
                </tr>
              </thead>
              <tbody id="sa-tbody"><tr><td colspan="9" class="sa-empty">Loading…</td></tr></tbody>
            </table>
          </div>
          <p class="sa-foot" id="sa-count"></p>
        </div>

        <aside class="sa-card" id="sa-detail">
          <p class="sa-empty-detail">Select a sale to see its lines, payments and instalments.</p>
        </aside>
      </div>
    </section>

    <!-- Returns -->
    <section class="sa-panel" data-panel="returns">
      <div class="sa-card">
        <div class="sa-table-wrap">
          <table class="sa-table">
            <thead>
              <tr>
                <th>No</th><th>Date</th><th>Invoice</th><th>Customer</th><th>Goods</th><th>Reason</th>
                <th class="num">Value</th><th class="num">Credit to pay</th><th>Status</th><th></th>
              </tr>
            </thead>
            <tbody id="ret-tbody"><tr><td colspan="10" class="sa-empty">Loading…</td></tr></tbody>
          </table>
        </div>
        <p class="sa-foot">Returns are made from a confirmed sale (open it and press Return goods). The value first reduces what the customer still owes; the rest becomes credit to pay. Bikes and service charges cannot be returned.</p>
      </div>
    </section>

    <!-- Credit -->
    <section class="sa-panel" data-panel="credits">
      <div class="sa-card">
        <div class="sa-credit-head">
          <p class="sa-foot" style="margin:0">Credit you owe a customer after a return: refund it, set it against another sale, or give other goods.</p>
          <button type="button" class="btn-primary-sm" id="cr-new" hidden>+ Use credit</button>
        </div>
        <div class="sa-table-wrap">
          <table class="sa-table">
            <thead>
              <tr><th>Date</th><th>Customer</th><th>Kind</th><th>Detail</th><th class="num">Amount</th><th>Status</th><th></th></tr>
            </thead>
            <tbody id="cr-tbody"><tr><td colspan="7" class="sa-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Follow-ups -->
    <section class="sa-panel" data-panel="followups">
      <div class="sa-card">
        <div class="sa-filters">
          <select id="fu-status" aria-label="Status">
            <option value="pending">Pending</option>
            <option value="">All</option>
            <option value="done">Done</option>
            <option value="skipped">Skipped</option>
          </select>
          <select id="fu-kind" aria-label="Kind">
            <option value="">All kinds</option>
            <option value="maintenance_post">Post-service check (3 days)</option>
            <option value="maintenance_due">Maintenance (90 days)</option>
            <option value="emi_due">EMI instalment</option>
            <option value="credit_due">Credit to receive</option>
          </select>
          <label class="sa-check"><input type="checkbox" id="fu-overdue" /> Overdue only</label>
        </div>
        <div class="sa-table-wrap">
          <table class="sa-table">
            <thead>
              <tr><th>Due</th><th>Kind</th><th>Customer</th><th>Sale</th><th>Vehicle</th><th class="num">Amount</th><th>Status</th><th></th></tr>
            </thead>
            <tbody id="fu-tbody"><tr><td colspan="8" class="sa-empty">Loading…</td></tr></tbody>
          </table>
        </div>
        <p class="sa-foot">Follow-ups are created when a sale is confirmed. EMI and credit follow-ups close by themselves when paid.</p>
      </div>
    </section>

    <!-- Bikes + local products -->
    <section class="sa-panel" data-panel="bikes">
      <div class="sa-layout sa-layout-even">
        <div class="sa-card">
          <div class="sa-credit-head">
            <strong>Bikes</strong>
            <button type="button" class="btn-primary-sm" id="bk-new" hidden>+ Register bike</button>
          </div>
          <div class="sa-table-wrap">
            <table class="sa-table">
              <thead><tr><th>Chassis</th><th>Engine</th><th>Model</th><th>Colour</th><th>Status</th></tr></thead>
              <tbody id="bk-tbody"><tr><td colspan="5" class="sa-empty">Loading…</td></tr></tbody>
            </table>
          </div>
          <p class="sa-foot">Register each bike by chassis number before selling it. Stock itself comes from purchases.</p>
        </div>
        <div class="sa-card">
          <div class="sa-credit-head">
            <strong>Local products</strong>
            <button type="button" class="btn-primary-sm" id="lp-new" hidden>+ Add</button>
          </div>
          <div class="sa-table-wrap">
            <table class="sa-table">
              <thead><tr><th>Name</th><th>Unit</th><th class="num">Sale price</th></tr></thead>
              <tbody id="lp-tbody"><tr><td colspan="3" class="sa-empty">Loading…</td></tr></tbody>
            </table>
          </div>
          <p class="sa-foot">Sales-only items (services, accessories bought in). They never touch stock.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- Sale form -->
  <dialog class="sa-dialog sa-wide" id="dlg-form">
    <form method="dialog" class="sa-dialog-inner" id="form-sale">
      <h2 class="sa-dialog-title" id="sf-title">New sale</h2>
      <input type="hidden" id="sf-id" />
      <div class="sa-grid">
        <label class="sa-field"><span>Kind of sale</span>
          <select id="sf-type">
            <option value="stock">Stock sale</option>
            <option value="bike">Bike sale</option>
            <option value="maintenance">Maintenance</option>
          </select>
        </label>
        <label class="sa-field"><span>Date</span><input type="date" id="sf-date" /></label>
        <label class="sa-field"><span>Customer (empty = walk-in)</span><select id="sf-customer"></select></label>
        <label class="sa-field" id="sf-walkin-wrap"><span>Walk-in name</span><input type="text" id="sf-walkin" maxlength="150" /></label>
        <label class="sa-field" id="sf-due-wrap"><span>Promised to pay by (credit sale)</span><input type="date" id="sf-due" /></label>
        <label class="sa-field" id="sf-chassis-wrap" hidden><span>Vehicle chassis no</span><input type="text" id="sf-chassis" maxlength="60" /></label>
        <label class="sa-field" id="sf-reg-wrap" hidden><span>Vehicle reg no</span><input type="text" id="sf-reg" maxlength="30" /></label>
      </div>
      <div class="sa-lines-head"><strong>Items</strong><button type="button" class="btn-ghost-sm" id="sf-add-line">+ Add item</button></div>
      <div id="sf-lines" class="sa-lines"></div>
      <div class="sa-grid">
        <label class="sa-field"><span>Discount</span><input type="number" id="sf-discount" min="0" step="0.01" value="0" /></label>
        <label class="sa-field"><span>VAT % (on discounted amount)</span><input type="number" id="sf-vat" min="0" max="100" step="0.01" value="0" /></label>
      </div>
      <div id="sf-emi-box" hidden>
        <div class="sa-grid sa-grid-3">
          <label class="sa-field"><span>Payment</span>
            <select id="sf-mode"><option value="full">Full payment</option><option value="emi">EMI</option></select>
          </label>
        </div>
        <div class="sa-grid sa-grid-3" id="sf-emi-fields" hidden>
          <label class="sa-field"><span>Down payment</span><input type="number" id="sf-down" min="0" step="0.01" value="0" /></label>
          <label class="sa-field"><span>Months</span><input type="number" id="sf-months" min="1" max="120" step="1" value="12" /></label>
          <label class="sa-field"><span>Monthly EMI</span><input type="number" id="sf-emi" min="0" step="0.01" value="0" /></label>
          <label class="sa-field"><span>First EMI due</span><input type="date" id="sf-first" /></label>
        </div>
      </div>
      <label class="sa-field"><span>Notes</span><input type="text" id="sf-notes" /></label>
      <dl class="sa-totals" id="sf-totals"></dl>
      <p class="sa-error" id="sf-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-form">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="sf-save">Save draft</button>
      </div>
    </form>
  </dialog>

  <!-- Payment -->
  <dialog class="sa-dialog" id="dlg-pay">
    <form method="dialog" class="sa-dialog-inner" id="form-pay">
      <h2 class="sa-dialog-title">Record payment</h2>
      <p class="sa-sub" id="py-sub"></p>
      <div class="sa-grid">
        <label class="sa-field"><span>Amount *</span><input type="number" id="py-amount" required min="0.01" step="0.01" /></label>
        <label class="sa-field"><span>Method *</span>
          <select id="py-method">
            <option value="cash">Cash</option><option value="bank">Bank</option>
            <option value="online">Online</option><option value="cheque">Cheque</option>
          </select>
        </label>
        <label class="sa-field"><span>Paid on</span><input type="date" id="py-date" /></label>
        <label class="sa-field"><span>Reference</span><input type="text" id="py-ref" maxlength="100" /></label>
      </div>
      <p class="sa-error" id="py-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-pay">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="py-save">Save payment</button>
      </div>
    </form>
  </dialog>

  <!-- Return -->
  <dialog class="sa-dialog sa-wide" id="dlg-return">
    <form method="dialog" class="sa-dialog-inner" id="form-return">
      <h2 class="sa-dialog-title">Return goods</h2>
      <p class="sa-sub" id="rt-sub"></p>
      <div id="rt-lines" class="sa-lines"></div>
      <label class="sa-field"><span>Reason *</span><input type="text" id="rt-reason" required /></label>
      <label class="sa-field" id="rt-refund-wrap" hidden><span>Walk-in: refund the money now by</span>
        <select id="rt-refund">
          <option value="cash">Cash</option><option value="bank">Bank</option>
          <option value="online">Online</option><option value="cheque">Cheque</option>
        </select>
      </label>
      <p class="sa-error" id="rt-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-return">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="rt-save">Return goods</button>
      </div>
    </form>
  </dialog>

  <!-- Reason (cancel / void / skip) -->
  <dialog class="sa-dialog" id="dlg-reason">
    <form method="dialog" class="sa-dialog-inner" id="form-reason">
      <h2 class="sa-dialog-title" id="rs-title">Reason</h2>
      <p class="sa-sub" id="rs-sub"></p>
      <label class="sa-field"><span>Reason *</span><input type="text" id="rs-text" required /></label>
      <p class="sa-error" id="rs-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-reason">Back</button>
        <button type="submit" class="btn-primary-sm is-danger" id="rs-save">Confirm</button>
      </div>
    </form>
  </dialog>

  <!-- Use credit -->
  <dialog class="sa-dialog sa-wide" id="dlg-credit">
    <form method="dialog" class="sa-dialog-inner" id="form-credit">
      <h2 class="sa-dialog-title">Use customer credit</h2>
      <div class="sa-grid">
        <label class="sa-field"><span>Customer *</span><select id="cr-customer" required></select></label>
        <label class="sa-field"><span>What happens *</span>
          <select id="cr-kind">
            <option value="refund">Refund (cash goes back)</option>
            <option value="adjustment">Set against another sale</option>
            <option value="replacement">Replacement goods</option>
          </select>
        </label>
        <label class="sa-field"><span>Credit amount *</span><input type="number" id="cr-amount" required min="0.01" step="0.01" /></label>
        <label class="sa-field" id="cr-method-wrap"><span>Method</span>
          <select id="cr-method">
            <option value="cash">Cash</option><option value="bank">Bank</option>
            <option value="online">Online</option><option value="cheque">Cheque</option>
          </select>
        </label>
        <label class="sa-field" id="cr-sale-wrap" hidden><span>Sale</span><select id="cr-sale"></select></label>
      </div>
      <div id="cr-items-wrap" hidden>
        <div class="sa-lines-head"><strong>Replacement goods</strong><button type="button" class="btn-ghost-sm" id="cr-add-line">+ Add item</button></div>
        <div id="cr-lines" class="sa-lines"></div>
      </div>
      <label class="sa-field"><span>Note</span><input type="text" id="cr-notes" /></label>
      <p class="sa-error" id="cr-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-credit">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="cr-save">Save</button>
      </div>
    </form>
  </dialog>

  <!-- Follow-up done -->
  <dialog class="sa-dialog" id="dlg-done">
    <form method="dialog" class="sa-dialog-inner" id="form-done">
      <h2 class="sa-dialog-title">Mark follow-up done</h2>
      <p class="sa-sub" id="dn-sub"></p>
      <label class="sa-field"><span>Note</span><input type="text" id="dn-note" maxlength="300" /></label>
      <label class="sa-check" id="dn-issue-wrap"><input type="checkbox" id="dn-issue" /> Customer reported a problem</label>
      <label class="sa-field" id="dn-next-wrap"><span>Book the next follow-up on (optional)</span><input type="date" id="dn-next" /></label>
      <p class="sa-error" id="dn-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-done">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="dn-save">Mark done</button>
      </div>
    </form>
  </dialog>

  <!-- Register bike -->
  <dialog class="sa-dialog" id="dlg-bike">
    <form method="dialog" class="sa-dialog-inner" id="form-bike">
      <h2 class="sa-dialog-title">Register bike</h2>
      <div class="sa-grid">
        <label class="sa-field"><span>Model (catalog product) *</span><select id="bk-product" required></select></label>
        <label class="sa-field"><span>Colour</span><input type="text" id="bk-color" /></label>
        <label class="sa-field"><span>Chassis no *</span><input type="text" id="bk-chassis" required /></label>
        <label class="sa-field"><span>Engine no *</span><input type="text" id="bk-engine" required /></label>
      </div>
      <p class="sa-error" id="bk-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-bike">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="bk-save">Register</button>
      </div>
    </form>
  </dialog>

  <!-- Local product -->
  <dialog class="sa-dialog" id="dlg-local">
    <form method="dialog" class="sa-dialog-inner" id="form-local">
      <h2 class="sa-dialog-title">Add local product</h2>
      <div class="sa-grid">
        <label class="sa-field"><span>Name *</span><input type="text" id="lp-name" required /></label>
        <label class="sa-field"><span>Unit</span><input type="text" id="lp-unit" value="pcs" maxlength="20" /></label>
        <label class="sa-field"><span>Sale price</span><input type="number" id="lp-sale" min="0" step="0.01" value="0" /></label>
        <label class="sa-field"><span>Cost price</span><input type="number" id="lp-cost" min="0" step="0.01" value="0" /></label>
      </div>
      <p class="sa-error" id="lp-error" hidden></p>
      <div class="sa-actions">
        <button type="button" class="btn-ghost-sm" data-close="dlg-local">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="lp-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import { getSession } from '../../lib/auth';
  import { ApiError } from '../../lib/api';
  import { listCustomers, type Customer } from '../../lib/customers';
  import { listStock, type StockItem } from '../../lib/inventory';
  import {
    listSales, getSale, createSale, updateSale, confirmSale, cancelSale,
    addPayment, voidPayment,
    listReturns, createReturn, voidReturn,
    listCredits, useCredit, deliverReplacement, voidCredit,
    listFollowups, markFollowupDone, skipFollowup,
    listBikes, registerBike, listLocalProducts, createLocalProduct,
    previewTotals, previewFinance, summarize, formatNpr, formatQty,
    STATUS_LABEL, TYPE_LABEL, PAYMENT_LABEL, METHOD_LABEL, CREDIT_LABEL, FOLLOWUP_LABEL,
    type Sale, type SaleType, type SaleReturn, type SaleCredit, type Followup, type BikeUnit,
    type LocalProduct, type CreditKind, type PayMethod, type SaleLineInput,
  } from '../../lib/sales';

  if (!getSession()) window.location.replace('/');

  let sales: Sale[] = [];
  let customers: Customer[] = [];
  let products: StockItem[] = [];
  let bikesInStock: BikeUnit[] = [];
  let localProducts: LocalProduct[] = [];
  let selected: Sale | null = null;
  let canWrite = true;
  let activeTab = 'list';
  let loaded: Record<string, boolean> = {};

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const val = (id: string) => $<HTMLInputElement>(id)?.value ?? '';
  const today = () => new Date().toLocaleDateString('en-CA');
  const dlg = (id: string) => $<HTMLDialogElement>(id)!;

  function esc(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  const FIELD_LABELS: Record<string, string> = {
    customer: 'Customer', sale_date: 'Date', discount_amount: 'Discount', vat_rate: 'VAT',
    down_payment: 'Down payment', emi_months: 'Months', emi_amount: 'EMI', first_emi_due: 'First EMI due',
    due_date: 'Due date', amount: 'Amount', method: 'Method', reason: 'Reason', paid_on: 'Paid on',
    chassis_no: 'Chassis no', engine_no: 'Engine no', name: 'Name', sale: 'Sale', note: 'Note',
    refund_method: 'Refund method',
  };

  function flatten(value: unknown): string {
    if (typeof value === 'string') return value;
    if (Array.isArray(value)) return value.map(flatten).filter(Boolean).join(' ');
    if (value && typeof value === 'object') return Object.values(value).map(flatten).filter(Boolean).join(' ');
    return '';
  }

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    const entries = Object.entries(error.fields);
    if (entries.length > 0 && error.status === 400) {
      return entries
        .map(([k, v]) => (FIELD_LABELS[k] ? `${FIELD_LABELS[k]}: ${flatten(v)}` : flatten(v)))
        .join(' ');
    }
    return error.message;
  }

  function showError(id: string, message: string | null): void {
    const el = $(id);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  function notice(message: string | null, error = false): void {
    const el = $('sa-notice');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
    el.classList.toggle('is-error', error);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((b) =>
    b.addEventListener('click', () => dlg(b.dataset.close!).close()),
  );

  async function submit(btnId: string, errId: string, dialogId: string, work: () => Promise<void>): Promise<void> {
    const btn = $<HTMLButtonElement>(btnId)!;
    btn.disabled = true;
    showError(errId, null);
    try {
      await work();
      dlg(dialogId).close();
    } catch (error) {
      showError(errId, describe(error));
    } finally {
      btn.disabled = false;
    }
  }

  const badge = (cls: string, text: string) => `<span class="sa-badge sa-badge-${cls}">${esc(text)}</span>`;
  const customerLabel = (s: Sale) => esc(s.customerId ? s.customerName : s.walkInName || 'Walk-in');

  // ---- Sales list ----------------------------------------------------

  function filters() {
    return {
      search: val('f-search').trim(),
      status: val('f-status') as Sale['status'] | '',
      saleType: val('f-type') as SaleType | '',
      paymentStatus: val('f-pay') as Sale['paymentStatus'] | '',
      dateFrom: val('f-from'),
      dateTo: val('f-to'),
    };
  }

  function renderKpis(): void {
    const s = summarize(sales);
    $('kpi-count')!.textContent = String(s.count);
    $('kpi-drafts')!.textContent = String(s.drafts);
    $('kpi-value')!.textContent = formatNpr(s.totalValue);
    $('kpi-receive')!.textContent = formatNpr(s.toReceive);
  }

  function renderList(): void {
    const tbody = $('sa-tbody')!;
    tbody.innerHTML = sales.length === 0
      ? `<tr><td colspan="9" class="sa-empty">No sales found.</td></tr>`
      : sales.map((s) => `<tr class="sa-row ${selected?.id === s.id ? 'is-selected' : ''}" data-id="${s.id}">
          <td class="mono">${esc(s.invoiceNo || s.saleNo)}</td>
          <td>${esc(s.saleDate)}</td>
          <td>${customerLabel(s)}</td>
          <td>${esc(TYPE_LABEL[s.saleType])}${s.paymentMode === 'emi' ? ' · EMI' : ''}</td>
          <td>${badge(s.status, STATUS_LABEL[s.status])}</td>
          <td class="num">${formatNpr(s.netTotal)}</td>
          <td class="num">${formatNpr(s.paid)}</td>
          <td class="num">${s.status === 'cancelled' ? '—' : formatNpr(s.remaining)}</td>
          <td>${s.status === 'cancelled' ? '—' : badge('pay-' + s.paymentStatus, PAYMENT_LABEL[s.paymentStatus])}</td>
        </tr>`).join('');
    $('sa-count')!.textContent = `${sales.length} sale${sales.length === 1 ? '' : 's'}`;
    tbody.querySelectorAll<HTMLTableRowElement>('.sa-row').forEach((row) =>
      row.addEventListener('click', () => void openDetail(Number(row.dataset.id))),
    );
  }

  async function loadList(): Promise<void> {
    try {
      sales = await listSales(filters());
      notice(canWrite ? null : 'Read-only: you are viewing this branch from Head Office.');
    } catch (error) {
      sales = [];
      notice(describe(error), true);
    }
    renderKpis();
    renderList();
  }

  // ---- Detail --------------------------------------------------------

  async function openDetail(id: number): Promise<void> {
    try {
      selected = await getSale(id);
    } catch (error) {
      notice(describe(error), true);
      return;
    }
    renderList();
    renderDetail();
  }

  function renderDetail(): void {
    const el = $('sa-detail')!;
    const s = selected;
    if (!s) {
      el.innerHTML = `<p class="sa-empty-detail">Select a sale to see its lines, payments and instalments.</p>`;
      return;
    }
    const acts: string[] = [];
    if (canWrite) {
      if (s.status === 'draft') {
        acts.push(`<button class="btn-primary-sm" data-act="confirm">Confirm sale</button>`);
        acts.push(`<button class="btn-ghost-sm" data-act="edit">Edit</button>`);
      }
      if (s.status !== 'cancelled' && s.remaining > 0) acts.push(`<button class="btn-ghost-sm" data-act="pay">Record payment</button>`);
      if (s.status === 'confirmed' && s.lines.some((l) => l.returnableQuantity > 0)) acts.push(`<button class="btn-ghost-sm" data-act="return">Return goods</button>`);
      if (s.status === 'draft') acts.push(`<button class="btn-ghost-sm is-danger" data-act="cancel">Cancel</button>`);
    }

    el.innerHTML = `
      <div class="sa-detail-head">
        <p class="mono muted">${esc(s.invoiceNo || s.saleNo)}${s.invoiceNo ? ` <span class="muted">(${esc(s.saleNo)})</span>` : ''}</p>
        <h3>${customerLabel(s)}</h3>
        <p>${badge(s.status, STATUS_LABEL[s.status])} ${s.status === 'cancelled' ? '' : badge('pay-' + s.paymentStatus, PAYMENT_LABEL[s.paymentStatus])} <span class="muted small">${esc(TYPE_LABEL[s.saleType])}${s.paymentMode === 'emi' ? ' · EMI' : ''}</span></p>
      </div>
      <div class="sa-detail-actions">${acts.join('')}</div>
      <p class="muted small">Date ${esc(s.saleDate)}${s.dueDate ? ` · Pay by ${esc(s.dueDate)}` : ''}${s.vehicleChassisNo ? ` · Chassis ${esc(s.vehicleChassisNo)}` : ''}${s.vehicleRegNo ? ` · Reg ${esc(s.vehicleRegNo)}` : ''}${s.notes ? ` · ${esc(s.notes)}` : ''}</p>
      ${s.status === 'cancelled' && s.cancelReason ? `<p class="small">Cancelled: ${esc(s.cancelReason)}</p>` : ''}

      <table class="sa-table sa-mini">
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Price</th><th class="num">Total</th></tr></thead>
        <tbody>
          ${s.lines.map((l) => `<tr>
            <td>${esc(l.name)}${l.chassisNo ? `<br /><span class="muted mono">${esc(l.chassisNo)} / ${esc(l.engineNo)}</span>` : l.stockNo ? `<br /><span class="muted mono">${esc(l.stockNo)}</span>` : ''}</td>
            <td class="num">${formatQty(l.quantity)}${l.returnedQuantity > 0 ? `<br /><span class="muted">returned ${formatQty(l.returnedQuantity)}</span>` : ''}</td>
            <td class="num">${formatNpr(l.unitPrice)}</td>
            <td class="num">${formatNpr(l.lineTotal)}</td>
          </tr>`).join('')}
        </tbody>
      </table>

      <dl class="sa-totals">
        <div><dt>Subtotal</dt><dd>${formatNpr(s.subtotal)}</dd></div>
        <div><dt>Discount</dt><dd>− ${formatNpr(s.discount)}</dd></div>
        <div><dt>VAT ${formatQty(s.vatRate)}%</dt><dd>${formatNpr(s.vatAmount)}</dd></div>
        <div class="strong"><dt>Net total</dt><dd>${formatNpr(s.netTotal)}</dd></div>
        ${s.paymentMode === 'emi' ? `<div><dt>Finance charge</dt><dd>${formatNpr(s.financeCharge)}</dd></div>
        <div class="strong"><dt>Amount due (with finance)</dt><dd>${formatNpr(s.amountDue)}</dd></div>` : ''}
        ${s.returnedAmount > 0 ? `<div><dt>Returned goods</dt><dd>− ${formatNpr(s.returnedAmount)}</dd></div>` : ''}
        ${s.creditApplied > 0 ? `<div><dt>Credit applied</dt><dd>− ${formatNpr(s.creditApplied)}</dd></div>` : ''}
        <div><dt>Paid</dt><dd>${formatNpr(s.paid)}</dd></div>
        <div class="strong"><dt>Still to receive</dt><dd>${formatNpr(s.remaining)}</dd></div>
      </dl>

      ${s.paymentMode === 'emi' ? `
      <h4>EMI · down payment ${formatNpr(s.downPayment)}, ${s.emiMonths} × ${formatNpr(s.emiAmount)}</h4>
      ${s.installments.length === 0 ? `<p class="muted small">Instalments are created when the sale is confirmed.</p>` : `
      <table class="sa-table sa-mini">
        <thead><tr><th>#</th><th>Due</th><th class="num">Amount</th><th class="num">Paid</th><th>Status</th></tr></thead>
        <tbody>${s.installments.map((i) => `<tr>
          <td>${i.number}</td><td>${esc(i.dueDate)}</td><td class="num">${formatNpr(i.amount)}</td>
          <td class="num">${formatNpr(i.paidAmount)}</td><td>${badge('inst-' + i.status, i.status)}</td></tr>`).join('')}
        </tbody>
      </table>`}` : ''}

      <h4>Payments</h4>
      ${s.payments.length === 0 ? `<p class="muted small">No payments yet.</p>` : `
      <ul class="sa-list">
        ${s.payments.map((x) => `<li class="${x.status === 'void' ? 'is-void' : ''}">
          <span>${esc(x.paidOn)} · ${esc(METHOD_LABEL[x.method])}${x.reference ? ` · ${esc(x.reference)}` : ''}</span>
          <strong>${formatNpr(x.amount)}</strong>
          ${x.status === 'void'
            ? `<em class="muted">void: ${esc(x.voidReason)}</em>`
            : canWrite ? `<button class="btn-link" data-void-pay="${x.id}">Void</button>` : ''}
        </li>`).join('')}
      </ul>`}
    `;

    el.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) =>
      b.addEventListener('click', () => {
        const act = b.dataset.act;
        if (act === 'edit') openForm(s);
        else if (act === 'pay') openPay(s);
        else if (act === 'return') openReturn(s);
        else if (act === 'confirm') void doConfirm(s);
        else if (act === 'cancel') openReason(`Cancel ${s.saleNo}`, 'A cancelled draft has no effect on stock.', async (reason) => {
          await cancelSale(s.id, reason);
        }, s.id);
      }),
    );
    el.querySelectorAll<HTMLButtonElement>('[data-void-pay]').forEach((b) =>
      b.addEventListener('click', () =>
        openReason('Void payment', 'The amount goes back onto the sale.', async (reason) => {
          await voidPayment(Number(b.dataset.voidPay), reason);
        }, s.id),
      ),
    );
  }

  async function doConfirm(s: Sale): Promise<void> {
    if (!confirm(`Confirm ${s.saleNo}? Stock goes down and an invoice number is given. It cannot be edited afterwards.`)) return;
    try {
      await confirmSale(s.id);
      await refreshAfterChange(s.id);
    } catch (error) {
      notice(describe(error), true);
    }
  }

  async function refreshAfterChange(id?: number): Promise<void> {
    await loadList();
    if (id) {
      try { selected = await getSale(id); } catch { selected = null; }
      renderList();
      renderDetail();
    }
    loaded = {};
    void loadTab(activeTab);
    void Promise.all([listStock(), listBikes('in_stock')]).then(([p, b]) => { products = p; bikesInStock = b; }).catch(() => {});
  }

  // ---- Reason dialog -------------------------------------------------

  let reasonHandler: ((reason: string) => Promise<void>) | null = null;
  let reasonAfter: number | undefined;

  function openReason(title: string, sub: string, handler: (reason: string) => Promise<void>, afterId?: number): void {
    $('rs-title')!.textContent = title;
    $('rs-sub')!.textContent = sub;
    $<HTMLInputElement>('rs-text')!.value = '';
    showError('rs-error', null);
    reasonHandler = handler;
    reasonAfter = afterId;
    dlg('dlg-reason').showModal();
  }

  $('form-reason')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const reason = val('rs-text').trim();
    if (!reason || !reasonHandler) return;
    void submit('rs-save', 'rs-error', 'dlg-reason', async () => {
      await reasonHandler!(reason);
      await refreshAfterChange(reasonAfter);
    });
  });

  // ---- Line editor ---------------------------------------------------

  type Kind = 'product' | 'local' | 'service' | 'bike';
  const KIND_LABEL: Record<Kind, string> = { product: 'Product', local: 'Local product', service: 'Service charge', bike: 'Bike' };

  function kindsFor(type: SaleType): Kind[] {
    if (type === 'bike') return ['bike'];
    if (type === 'maintenance') return ['product', 'local', 'service'];
    return ['product', 'local'];
  }

  function itemOptions(kind: Kind, selectedId?: number): string {
    const pick = (id: number) => (id === selectedId ? 'selected' : '');
    if (kind === 'product') {
      return `<option value="">Choose product…</option>` + products
        .map((p) => `<option value="${p.productId}" ${pick(p.productId)}>${esc(p.stockNo)} · ${esc(p.name)} (${formatQty(p.quantity)} in stock)</option>`).join('');
    }
    if (kind === 'local') {
      return `<option value="">Choose local product…</option>` + localProducts.filter((p) => p.isActive)
        .map((p) => `<option value="${p.id}" ${pick(p.id)}>${esc(p.name)}</option>`).join('');
    }
    return `<option value="">Choose bike…</option>` + bikesInStock
      .map((b) => `<option value="${b.id}" ${pick(b.id)}>${esc(b.productName)} · ${esc(b.chassisNo)}${b.color ? ` · ${esc(b.color)}` : ''}</option>`).join('');
  }

  function defaultPrice(kind: Kind, id: number): number {
    if (kind === 'product') return products.find((p) => p.productId === id)?.salePrice ?? 0;
    if (kind === 'local') return localProducts.find((p) => p.id === id)?.salePrice ?? 0;
    if (kind === 'bike') {
      const bike = bikesInStock.find((b) => b.id === id);
      return bike ? products.find((p) => p.productId === bike.productId)?.salePrice ?? 0 : 0;
    }
    return 0;
  }

  function addSaleLine(container: HTMLElement, type: SaleType, preset: { kind?: Kind; id?: number; description?: string; quantity?: number; unitPrice?: number } = {}, onChange?: () => void): void {
    const kinds = kindsFor(type);
    const kind = preset.kind && kinds.includes(preset.kind) ? preset.kind : kinds[0];
    const row = document.createElement('div');
    row.className = 'sa-line sa-line-sale';
    row.dataset.kind = kind;
    row.innerHTML = `
      <select class="ln-kind" aria-label="Kind" ${kinds.length === 1 ? 'hidden' : ''}>
        ${kinds.map((k) => `<option value="${k}" ${k === kind ? 'selected' : ''}>${KIND_LABEL[k]}</option>`).join('')}
      </select>
      <span class="ln-item-wrap"></span>
      <input class="ln-qty" type="number" min="0.001" step="0.001" value="${preset.quantity ?? 1}" aria-label="Quantity" />
      <input class="ln-price" type="number" min="0" step="0.01" value="${preset.unitPrice ?? 0}" aria-label="Unit price" />
      <button type="button" class="btn-link is-danger ln-remove" aria-label="Remove">✕</button>`;
    container.appendChild(row);

    const renderItem = (k: Kind, id?: number, description?: string) => {
      row.dataset.kind = k;
      const wrap = row.querySelector<HTMLElement>('.ln-item-wrap')!;
      wrap.innerHTML = k === 'service'
        ? `<input class="ln-desc" type="text" maxlength="200" placeholder="Service charge, e.g. Labour" value="${esc(description ?? '')}" />`
        : `<select class="ln-item" aria-label="Item">${itemOptions(k, id)}</select>`;
      row.querySelector<HTMLInputElement>('.ln-qty')!.hidden = k === 'bike';
      wrap.querySelector('.ln-item')?.addEventListener('change', (ev) => {
        const v = Number((ev.target as HTMLSelectElement).value);
        if (v) row.querySelector<HTMLInputElement>('.ln-price')!.value = String(defaultPrice(k, v));
        onChange?.();
      });
      wrap.querySelector('.ln-desc')?.addEventListener('input', () => onChange?.());
    };
    renderItem(kind, preset.id, preset.description);

    row.querySelector('.ln-kind')!.addEventListener('change', (ev) => {
      renderItem((ev.target as HTMLSelectElement).value as Kind);
      onChange?.();
    });
    row.querySelectorAll('input').forEach((i) => i.addEventListener('input', () => onChange?.()));
    row.querySelector('.ln-remove')!.addEventListener('click', () => { row.remove(); onChange?.(); });
  }

  function readSaleLines(container: HTMLElement): SaleLineInput[] {
    const out: SaleLineInput[] = [];
    container.querySelectorAll<HTMLElement>('.sa-line').forEach((row) => {
      const kind = row.dataset.kind as Kind;
      const id = Number(row.querySelector<HTMLSelectElement>('.ln-item')?.value) || 0;
      const quantity = Number(row.querySelector<HTMLInputElement>('.ln-qty')!.value);
      const unitPrice = Number(row.querySelector<HTMLInputElement>('.ln-price')!.value);
      if (kind === 'service') {
        const description = row.querySelector<HTMLInputElement>('.ln-desc')!.value.trim();
        if (description) out.push({ description, quantity, unitPrice });
      } else if (id) {
        if (kind === 'bike') out.push({ bikeUnitId: id, unitPrice });
        else if (kind === 'local') out.push({ localProductId: id, quantity, unitPrice });
        else out.push({ productId: id, quantity, unitPrice });
      }
    });
    return out;
  }

  // ---- Sale form -----------------------------------------------------

  const formType = () => val('sf-type') as SaleType;

  function updateTotals(): void {
    const lines = readSaleLines($('sf-lines')!).map((l) => ({ quantity: l.quantity ?? 1, unitPrice: l.unitPrice ?? 0 }));
    const t = previewTotals(lines, Number(val('sf-discount')) || 0, Number(val('sf-vat')) || 0);
    let html = `
      <div><dt>Subtotal</dt><dd>${formatNpr(t.subtotal)}</dd></div>
      <div><dt>VAT</dt><dd>${formatNpr(t.vat)}</dd></div>
      <div class="strong"><dt>Net total (preview)</dt><dd>${formatNpr(t.net)}</dd></div>`;
    if (formType() === 'bike' && val('sf-mode') === 'emi') {
      const fc = previewFinance(t.net, Number(val('sf-down')) || 0, Number(val('sf-months')) || 0, Number(val('sf-emi')) || 0);
      html += `<div><dt>Finance charge (preview)</dt><dd>${formatNpr(fc)}</dd></div>
               <div class="strong"><dt>Amount due (preview)</dt><dd>${formatNpr(t.net + fc)}</dd></div>`;
    }
    $('sf-totals')!.innerHTML = html;
  }

  function syncFormType(resetLines: boolean): void {
    const type = formType();
    $('sf-due-wrap')!.hidden = type === 'bike';
    $('sf-chassis-wrap')!.hidden = type !== 'maintenance';
    $('sf-reg-wrap')!.hidden = type !== 'maintenance';
    $('sf-emi-box')!.hidden = type !== 'bike';
    $('sf-add-line')!.hidden = type === 'bike';
    $('sf-emi-fields')!.hidden = !(type === 'bike' && val('sf-mode') === 'emi');
    if (resetLines) {
      const box = $('sf-lines')!;
      box.innerHTML = '';
      addSaleLine(box, type, {}, updateTotals);
    }
    updateTotals();
  }

  function syncWalkIn(): void {
    $('sf-walkin-wrap')!.hidden = Boolean(val('sf-customer'));
  }

  function openForm(s?: Sale): void {
    $('sf-title')!.textContent = s ? `Edit ${s.saleNo}` : 'New sale';
    $<HTMLInputElement>('sf-id')!.value = s ? String(s.id) : '';
    $<HTMLSelectElement>('sf-type')!.value = s?.saleType ?? 'stock';
    $<HTMLSelectElement>('sf-type')!.disabled = Boolean(s);
    $<HTMLInputElement>('sf-date')!.value = s?.saleDate ?? today();
    $<HTMLSelectElement>('sf-customer')!.innerHTML =
      `<option value="">Walk-in customer</option>` +
      customers.filter((c) => c.isActive || c.id === s?.customerId).map((c) => `<option value="${c.id}">${esc(c.name)}${c.phone ? ` · ${esc(c.phone)}` : ''}</option>`).join('');
    $<HTMLSelectElement>('sf-customer')!.value = s?.customerId ? String(s.customerId) : '';
    $<HTMLInputElement>('sf-walkin')!.value = s?.walkInName ?? '';
    $<HTMLInputElement>('sf-due')!.value = s?.dueDate ?? '';
    $<HTMLInputElement>('sf-chassis')!.value = s?.vehicleChassisNo ?? '';
    $<HTMLInputElement>('sf-reg')!.value = s?.vehicleRegNo ?? '';
    $<HTMLInputElement>('sf-discount')!.value = String(s?.discount ?? 0);
    $<HTMLInputElement>('sf-vat')!.value = String(s?.vatRate ?? 0);
    $<HTMLSelectElement>('sf-mode')!.value = s?.paymentMode ?? 'full';
    $<HTMLInputElement>('sf-down')!.value = String(s?.downPayment ?? 0);
    $<HTMLInputElement>('sf-months')!.value = String(s?.emiMonths || 12);
    $<HTMLInputElement>('sf-emi')!.value = String(s?.emiAmount ?? 0);
    $<HTMLInputElement>('sf-first')!.value = s?.firstEmiDue ?? '';
    $<HTMLInputElement>('sf-notes')!.value = s?.notes ?? '';

    const box = $('sf-lines')!;
    box.innerHTML = '';
    if (s) {
      s.lines.forEach((l) => {
        const kind: Kind = l.bikeUnitId ? 'bike' : l.localProductId ? 'local' : l.productId ? 'product' : 'service';
        addSaleLine(box, s.saleType, { kind, id: l.bikeUnitId ?? l.localProductId ?? l.productId ?? undefined, description: kind === 'service' ? l.name : '', quantity: l.quantity, unitPrice: l.unitPrice }, updateTotals);
      });
    }
    syncFormType(!s);
    syncWalkIn();
    showError('sf-error', null);
    dlg('dlg-form').showModal();
  }

  $('sa-new')?.addEventListener('click', () => openForm());
  $('sf-type')?.addEventListener('change', () => syncFormType(true));
  $('sf-mode')?.addEventListener('change', () => syncFormType(false));
  $('sf-customer')?.addEventListener('change', syncWalkIn);
  $('sf-add-line')?.addEventListener('click', () => addSaleLine($('sf-lines')!, formType(), {}, updateTotals));
  for (const id of ['sf-discount', 'sf-vat', 'sf-down', 'sf-months', 'sf-emi']) $(id)?.addEventListener('input', updateTotals);

  $('form-sale')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const lines = readSaleLines($('sf-lines')!);
    if (lines.length === 0) {
      showError('sf-error', 'Add at least one item.');
      return;
    }
    const id = Number(val('sf-id')) || 0;
    const type = formType();
    const customerId = Number(val('sf-customer')) || null;
    const input = {
      saleType: type,
      customerId,
      walkInName: customerId ? '' : val('sf-walkin'),
      saleDate: val('sf-date'),
      discount: Number(val('sf-discount')) || 0,
      vatRate: Number(val('sf-vat')) || 0,
      paymentMode: (val('sf-mode') || 'full') as 'full' | 'emi',
      downPayment: Number(val('sf-down')) || 0,
      emiMonths: Number(val('sf-months')) || undefined,
      emiAmount: Number(val('sf-emi')) || 0,
      firstEmiDue: val('sf-first'),
      dueDate: val('sf-due'),
      vehicleChassisNo: val('sf-chassis'),
      vehicleRegNo: val('sf-reg'),
      notes: val('sf-notes'),
      lines,
    };
    void submit('sf-save', 'sf-error', 'dlg-form', async () => {
      const saved = id ? await updateSale(id, input) : await createSale(input);
      await refreshAfterChange(saved.id);
    });
  });

  // ---- Payment -------------------------------------------------------

  function openPay(s: Sale): void {
    $('py-sub')!.textContent = `${s.invoiceNo || s.saleNo} · ${customerLabel(s)} · still to receive ${formatNpr(s.remaining)}${s.status === 'draft' ? ' (advance on a draft)' : ''}`;
    $<HTMLInputElement>('py-amount')!.value = String(s.remaining);
    $<HTMLSelectElement>('py-method')!.value = 'cash';
    $<HTMLInputElement>('py-date')!.value = today();
    $<HTMLInputElement>('py-ref')!.value = '';
    showError('py-error', null);
    $('form-pay')!.dataset.id = String(s.id);
    dlg('dlg-pay').showModal();
  }

  $('form-pay')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = Number($('form-pay')!.dataset.id);
    void submit('py-save', 'py-error', 'dlg-pay', async () => {
      await addPayment({ saleId: id, amount: Number(val('py-amount')), method: val('py-method') as PayMethod, paidOn: val('py-date'), reference: val('py-ref') });
      await refreshAfterChange(id);
    });
  });

  // ---- Return --------------------------------------------------------

  function openReturn(s: Sale): void {
    $('rt-sub')!.textContent = `${s.invoiceNo} · ${customerLabel(s)}. Goods go back into good stock.`;
    $('rt-lines')!.innerHTML = s.lines
      .filter((l) => l.returnableQuantity > 0)
      .map((l) => `<div class="sa-line sa-line-rt" data-line="${l.id}">
          <span>${esc(l.name)} <span class="muted">(can return ${formatQty(l.returnableQuantity)})</span></span>
          <input type="number" class="rt-qty" min="0" max="${l.returnableQuantity}" step="0.001" value="0" />
        </div>`).join('');
    $<HTMLInputElement>('rt-reason')!.value = '';
    $('rt-refund-wrap')!.hidden = Boolean(s.customerId);
    showError('rt-error', null);
    $('form-return')!.dataset.id = String(s.id);
    $('form-return')!.dataset.walkin = s.customerId ? '' : '1';
    dlg('dlg-return').showModal();
  }

  $('form-return')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = $('form-return')!;
    const id = Number(form.dataset.id);
    const lines = Array.from(document.querySelectorAll<HTMLElement>('#rt-lines .sa-line-rt'))
      .map((r) => ({ lineId: Number(r.dataset.line), quantity: Number(r.querySelector<HTMLInputElement>('.rt-qty')!.value) || 0 }))
      .filter((l) => l.quantity > 0);
    if (lines.length === 0) {
      showError('rt-error', 'Enter a quantity to return.');
      return;
    }
    void submit('rt-save', 'rt-error', 'dlg-return', async () => {
      await createReturn({ saleId: id, reason: val('rt-reason'), lines, refundMethod: form.dataset.walkin ? (val('rt-refund') as PayMethod) : undefined });
      await refreshAfterChange(id);
    });
  });

  // ---- Returns tab ---------------------------------------------------

  async function loadReturns(): Promise<void> {
    const tbody = $('ret-tbody')!;
    let rows: SaleReturn[];
    try {
      rows = await listReturns();
      loaded.returns = true;
    } catch (error) {
      tbody.innerHTML = `<tr><td colspan="10" class="sa-empty">${esc(describe(error))}</td></tr>`;
      return;
    }
    tbody.innerHTML = rows.length === 0
      ? `<tr><td colspan="10" class="sa-empty">No returns yet.</td></tr>`
      : rows.map((r) => `<tr>
          <td class="mono">${esc(r.returnNo)}</td><td>${esc(r.returnDate)}</td><td class="mono">${esc(r.invoiceNo)}</td>
          <td>${esc(r.customerName)}</td>
          <td>${r.items.map((i) => `${esc(i.productName)} ×${formatQty(i.quantity)}`).join(', ')}</td>
          <td>${esc(r.reason)}</td>
          <td class="num">${formatNpr(r.goodsValue)}</td><td class="num">${formatNpr(r.creditAmount)}</td>
          <td>${r.status === 'void' ? badge('cancelled', 'Void') : badge('confirmed', 'Active')}</td>
          <td>${r.status === 'active' && canWrite ? `<button class="btn-link is-danger" data-void-ret="${r.id}">Void</button>` : ''}</td>
        </tr>`).join('');
    tbody.querySelectorAll<HTMLButtonElement>('[data-void-ret]').forEach((b) =>
      b.addEventListener('click', () =>
        openReason('Void return', 'The goods go out of stock again and the effect on the sale and credit is removed.', async (reason) => {
          await voidReturn(Number(b.dataset.voidRet), reason);
        }, selected?.id),
      ),
    );
  }

  // ---- Credit tab ----------------------------------------------------

  async function loadCredits(): Promise<void> {
    const tbody = $('cr-tbody')!;
    let rows: SaleCredit[];
    try {
      rows = await listCredits();
      loaded.credits = true;
    } catch (error) {
      tbody.innerHTML = `<tr><td colspan="7" class="sa-empty">${esc(describe(error))}</td></tr>`;
      return;
    }
    tbody.innerHTML = rows.length === 0
      ? `<tr><td colspan="7" class="sa-empty">No credit used yet.</td></tr>`
      : rows.map((c) => {
          const detail = c.kind === 'refund'
            ? esc(METHOD_LABEL[c.method as PayMethod] ?? c.method)
            : c.kind === 'adjustment'
              ? `Against ${esc(c.saleNo)}`
              : `${c.items.map((i) => `${esc(i.productName)} ×${formatQty(i.quantity)}`).join(', ')} · ${esc(c.deliveryStatus)}`;
          const acts: string[] = [];
          if (canWrite && c.status === 'active') {
            if (c.kind === 'replacement' && c.deliveryStatus === 'pending') acts.push(`<button class="btn-link" data-deliver="${c.id}">Goods handed over</button>`);
            if (!(c.kind === 'replacement' && c.deliveryStatus === 'delivered')) acts.push(`<button class="btn-link is-danger" data-void-cr="${c.id}">Void</button>`);
          }
          return `<tr><td>${esc(c.settledOn)}</td><td>${esc(c.customerName)}</td><td>${esc(CREDIT_LABEL[c.kind])}</td><td>${detail}</td>
            <td class="num">${formatNpr(c.amount)}</td><td>${c.status === 'void' ? badge('cancelled', 'Void') : badge('confirmed', 'Active')}</td>
            <td class="actions">${acts.join(' ')}</td></tr>`;
        }).join('');
    tbody.querySelectorAll<HTMLButtonElement>('[data-deliver]').forEach((b) =>
      b.addEventListener('click', async () => {
        try {
          await deliverReplacement(Number(b.dataset.deliver));
          await refreshAfterChange(selected?.id);
        } catch (error) {
          notice(describe(error), true);
        }
      }),
    );
    tbody.querySelectorAll<HTMLButtonElement>('[data-void-cr]').forEach((b) =>
      b.addEventListener('click', () =>
        openReason('Void credit use', 'The credit goes back to the customer balance.', async (reason) => {
          await voidCredit(Number(b.dataset.voidCr), reason);
        }, selected?.id),
      ),
    );
  }

  function syncCreditKind(): void {
    const kind = val('cr-kind') as CreditKind;
    $('cr-method-wrap')!.hidden = kind !== 'refund';
    $('cr-sale-wrap')!.hidden = kind !== 'adjustment';
    $('cr-items-wrap')!.hidden = kind !== 'replacement';
    if (kind === 'replacement' && $('cr-lines')!.children.length === 0) {
      addCreditLine();
    }
    if (kind === 'adjustment') {
      const cid = Number(val('cr-customer'));
      const open = sales.filter((s) => s.customerId === cid && s.status === 'confirmed' && s.remaining > 0 && s.paymentMode !== 'emi');
      $('cr-sale')!.innerHTML = open.length
        ? open.map((s) => `<option value="${s.id}">${esc(s.invoiceNo)} · owes ${esc(formatNpr(s.remaining))}</option>`).join('')
        : `<option value="">No unpaid sale for this customer</option>`;
    }
  }

  function addCreditLine(): void {
    const row = document.createElement('div');
    row.className = 'sa-line sa-line-cr';
    row.innerHTML = `
      <select class="ln-item">${itemOptions('product')}</select>
      <input class="ln-qty" type="number" min="0.001" step="0.001" value="1" />
      <button type="button" class="btn-link is-danger ln-remove">✕</button>`;
    $('cr-lines')!.appendChild(row);
    row.querySelector('.ln-remove')!.addEventListener('click', () => row.remove());
  }

  $('cr-new')?.addEventListener('click', () => {
    $('cr-customer')!.innerHTML = `<option value="">Choose customer…</option>` + customers.map((c) => `<option value="${c.id}">${esc(c.name)}${c.creditToPay > 0 ? ` (you owe ${esc(formatNpr(c.creditToPay))})` : ''}</option>`).join('');
    $<HTMLSelectElement>('cr-kind')!.value = 'refund';
    $<HTMLInputElement>('cr-amount')!.value = '';
    $<HTMLInputElement>('cr-notes')!.value = '';
    $('cr-lines')!.innerHTML = '';
    syncCreditKind();
    showError('cr-error', null);
    dlg('dlg-credit').showModal();
  });
  $('cr-kind')?.addEventListener('change', syncCreditKind);
  $('cr-customer')?.addEventListener('change', syncCreditKind);
  $('cr-add-line')?.addEventListener('click', addCreditLine);

  $('form-credit')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const kind = val('cr-kind') as CreditKind;
    const items = Array.from($('cr-lines')!.querySelectorAll<HTMLElement>('.sa-line-cr'))
      .map((r) => ({ productId: Number(r.querySelector<HTMLSelectElement>('.ln-item')!.value), quantity: Number(r.querySelector<HTMLInputElement>('.ln-qty')!.value) }))
      .filter((i) => i.productId);
    if (kind === 'replacement' && items.length === 0) { showError('cr-error', 'Add the replacement goods.'); return; }
    if (kind === 'adjustment' && !Number(val('cr-sale'))) { showError('cr-error', 'Choose a sale.'); return; }
    void submit('cr-save', 'cr-error', 'dlg-credit', async () => {
      await useCredit({
        customerId: Number(val('cr-customer')), kind, amount: Number(val('cr-amount')),
        method: val('cr-method') as PayMethod, saleId: Number(val('cr-sale')) || undefined, items, notes: val('cr-notes'),
      });
      await refreshAfterChange(selected?.id);
    });
  });

  // ---- Follow-ups tab ------------------------------------------------

  async function loadFollowups(): Promise<void> {
    const tbody = $('fu-tbody')!;
    let rows: Followup[];
    try {
      rows = await listFollowups({
        status: val('fu-status') as Followup['status'] | '',
        kind: val('fu-kind') as Followup['kind'] | '',
        overdue: $<HTMLInputElement>('fu-overdue')!.checked,
      });
      loaded.followups = true;
    } catch (error) {
      tbody.innerHTML = `<tr><td colspan="8" class="sa-empty">${esc(describe(error))}</td></tr>`;
      return;
    }
    tbody.innerHTML = rows.length === 0
      ? `<tr><td colspan="8" class="sa-empty">Nothing to follow up.</td></tr>`
      : rows.map((f) => {
          const maint = f.kind === 'maintenance_post' || f.kind === 'maintenance_due';
          const prev = f.previous ? `<br /><span class="muted small">3-day check: ${esc(f.previous.status)}${f.previous.hasIssue ? ' · had an issue' : ''}${f.previous.note ? ` · ${esc(f.previous.note)}` : ''}</span>` : '';
          const acts: string[] = [];
          if (canWrite && f.status === 'pending') {
            if (maint) acts.push(`<button class="btn-link" data-done="${f.id}">Done</button> <button class="btn-link is-danger" data-skip="${f.id}">Skip</button>`);
            else acts.push(`<button class="btn-link" data-open-sale="${f.saleId}">Open sale</button>`);
          }
          return `<tr>
            <td class="${f.isOverdue ? 'is-overdue' : ''}">${esc(f.dueDate)}${f.isOverdue ? ' · overdue' : ''}</td>
            <td>${esc(FOLLOWUP_LABEL[f.kind])}${f.installmentNumber ? ` #${f.installmentNumber}` : ''}${prev}</td>
            <td>${esc(f.customerName)}${f.customerPhone ? `<br /><span class="muted small">${esc(f.customerPhone)}</span>` : ''}</td>
            <td class="mono">${esc(f.invoiceNo || f.saleNo)}</td>
            <td>${esc([f.vehicleRegNo, f.vehicleChassisNo].filter(Boolean).join(' / ') || '—')}</td>
            <td class="num">${f.amount > 0 ? formatNpr(f.amount) : '—'}</td>
            <td>${badge(f.status === 'pending' ? 'draft' : f.status === 'done' ? 'confirmed' : 'cancelled', f.status)}${f.hasIssue ? ' ⚠' : ''}${f.note ? `<br /><span class="muted small">${esc(f.note)}</span>` : ''}</td>
            <td class="actions">${acts.join('')}</td></tr>`;
        }).join('');

    tbody.querySelectorAll<HTMLButtonElement>('[data-done]').forEach((b) => b.addEventListener('click', () => {
      const f = rows.find((x) => x.id === Number(b.dataset.done))!;
      $('dn-sub')!.textContent = `${FOLLOWUP_LABEL[f.kind]} · ${f.customerName}`;
      $<HTMLInputElement>('dn-note')!.value = '';
      $<HTMLInputElement>('dn-issue')!.checked = false;
      $<HTMLInputElement>('dn-next')!.value = '';
      showError('dn-error', null);
      $('form-done')!.dataset.id = String(f.id);
      dlg('dlg-done').showModal();
    }));
    tbody.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((b) => b.addEventListener('click', () =>
      openReason('Skip follow-up', 'Say why it is being skipped.', async (reason) => {
        await skipFollowup(Number(b.dataset.skip), reason);
      }),
    ));
    tbody.querySelectorAll<HTMLButtonElement>('[data-open-sale]').forEach((b) => b.addEventListener('click', () => {
      activateTab('list');
      void openDetail(Number(b.dataset.openSale));
    }));
  }

  $('form-done')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = Number($('form-done')!.dataset.id);
    void submit('dn-save', 'dn-error', 'dlg-done', async () => {
      await markFollowupDone(id, { note: val('dn-note'), hasIssue: $<HTMLInputElement>('dn-issue')!.checked, nextDueDate: val('dn-next') });
      loaded.followups = false;
      await loadFollowups();
    });
  });
  for (const id of ['fu-status', 'fu-kind', 'fu-overdue']) $(id)?.addEventListener('change', () => void loadFollowups());

  // ---- Bikes and local products tab ----------------------------------

  async function loadBikes(): Promise<void> {
    try {
      const all = await listBikes();
      const lps = await listLocalProducts();
      localProducts = lps;
      loaded.bikes = true;
      $('bk-tbody')!.innerHTML = all.length === 0
        ? `<tr><td colspan="5" class="sa-empty">No bikes registered.</td></tr>`
        : all.map((b) => `<tr><td class="mono">${esc(b.chassisNo)}</td><td class="mono">${esc(b.engineNo)}</td><td>${esc(b.productName)}</td><td>${esc(b.color || '—')}</td>
            <td>${badge(b.status === 'sold' ? 'cancelled' : 'confirmed', b.status === 'sold' ? 'Sold' : 'In stock')}</td></tr>`).join('');
      $('lp-tbody')!.innerHTML = lps.length === 0
        ? `<tr><td colspan="3" class="sa-empty">No local products.</td></tr>`
        : lps.map((p) => `<tr><td>${esc(p.name)}${p.isActive ? '' : ' <span class="muted">(inactive)</span>'}</td><td>${esc(p.unit)}</td><td class="num">${formatNpr(p.salePrice)}</td></tr>`).join('');
    } catch (error) {
      $('bk-tbody')!.innerHTML = `<tr><td colspan="5" class="sa-empty">${esc(describe(error))}</td></tr>`;
    }
  }

  $('bk-new')?.addEventListener('click', () => {
    $('bk-product')!.innerHTML = `<option value="">Choose model…</option>` + products.map((p) => `<option value="${p.productId}">${esc(p.stockNo)} · ${esc(p.name)}</option>`).join('');
    for (const id of ['bk-color', 'bk-chassis', 'bk-engine']) $<HTMLInputElement>(id)!.value = '';
    showError('bk-error', null);
    dlg('dlg-bike').showModal();
  });
  $('form-bike')?.addEventListener('submit', (e) => {
    e.preventDefault();
    void submit('bk-save', 'bk-error', 'dlg-bike', async () => {
      await registerBike({ productId: Number(val('bk-product')), chassisNo: val('bk-chassis'), engineNo: val('bk-engine'), color: val('bk-color') });
      loaded.bikes = false;
      bikesInStock = await listBikes('in_stock');
      await loadBikes();
    });
  });
  $('lp-new')?.addEventListener('click', () => {
    $<HTMLInputElement>('lp-name')!.value = '';
    $<HTMLInputElement>('lp-unit')!.value = 'pcs';
    $<HTMLInputElement>('lp-sale')!.value = '0';
    $<HTMLInputElement>('lp-cost')!.value = '0';
    showError('lp-error', null);
    dlg('dlg-local').showModal();
  });
  $('form-local')?.addEventListener('submit', (e) => {
    e.preventDefault();
    void submit('lp-save', 'lp-error', 'dlg-local', async () => {
      await createLocalProduct({ name: val('lp-name'), unit: val('lp-unit'), salePrice: Number(val('lp-sale')) || 0, purchasePrice: Number(val('lp-cost')) || 0 });
      localProducts = await listLocalProducts();
      await loadBikes();
    });
  });

  // ---- Tabs, filters, load -------------------------------------------

  function loadTab(tab: string): Promise<void> | void {
    if (loaded[tab]) return;
    if (tab === 'returns') return loadReturns();
    if (tab === 'credits') return loadCredits();
    if (tab === 'followups') return loadFollowups();
    if (tab === 'bikes') return loadBikes();
  }

  function activateTab(tab: string): void {
    activeTab = tab;
    document.querySelectorAll('[data-tab]').forEach((b) => b.classList.toggle('is-active', (b as HTMLElement).dataset.tab === tab));
    document.querySelectorAll('[data-panel]').forEach((p) => p.classList.toggle('is-active', (p as HTMLElement).dataset.panel === tab));
    void loadTab(tab);
  }
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) => btn.addEventListener('click', () => activateTab(btn.dataset.tab!)));

  let timer: number | undefined;
  $('f-search')?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => void loadList(), 300);
  });
  for (const id of ['f-status', 'f-type', 'f-pay', 'f-from', 'f-to']) $(id)?.addEventListener('change', () => void loadList());
  $('sa-refresh')?.addEventListener('click', () => void init());
  document.getElementById('branch-select')?.addEventListener('change', () => setTimeout(() => void init(), 300));

  async function init(): Promise<void> {
    const s = getSession();
    if (s) $('sa-scope')!.textContent = `${s.activeBranchName} (${s.activeBranchCode})`;
    canWrite = s?.accessMode !== 'read_only';
    for (const id of ['sa-new', 'cr-new', 'bk-new', 'lp-new']) $(id)!.hidden = !canWrite;
    selected = null;
    renderDetail();
    loaded = {};

    try {
      [customers, products, bikesInStock, localProducts] = await Promise.all([listCustomers(), listStock(), listBikes('in_stock'), listLocalProducts()]);
    } catch (error) {
      notice(describe(error), true);
    }
    await loadList();
    void loadTab(activeTab);
  }

  void init();
</script>

<style is:global>
  .sa-page { display: flex; flex-direction: column; gap: 14px; }
  .sa-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .sa-toolbar-right { display: flex; gap: 8px; }
  .sa-scope { margin: 0 0 6px; font-size: 0.78rem; color: var(--text-muted); }
  .sa-tabs { display: flex; gap: 4px; padding: 3px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .sa-tab {
    border: none; background: transparent; padding: 6px 12px; border-radius: 7px; font-family: inherit;
    font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); cursor: pointer;
  }
  .sa-tab.is-active { background: var(--panel-bg); color: var(--text-primary); box-shadow: 0 1px 2px rgba(0,0,0,0.06); }

  .btn-primary-sm, .btn-ghost-sm {
    height: 34px; padding: 0 12px; border-radius: 8px; font-family: inherit; font-size: 0.8rem; font-weight: 650; cursor: pointer;
  }
  .btn-primary-sm { border: none; background: var(--accent); color: #fff; }
  .btn-primary-sm.is-danger { background: #ef334e; }
  .btn-primary-sm:disabled { opacity: 0.6; cursor: default; }
  .btn-ghost-sm { border: 1px solid var(--border); background: transparent; color: var(--text-secondary); }
  .btn-ghost-sm:hover { background: var(--surface-hover); color: var(--text-primary); }
  .btn-ghost-sm.is-danger { color: #ef334e; border-color: color-mix(in srgb, #ef334e 35%, var(--border)); }
  .btn-link { border: none; background: transparent; color: var(--accent); font-family: inherit; font-size: 0.78rem; font-weight: 650; cursor: pointer; padding: 0; }
  .btn-link.is-danger { color: #ef334e; }

  .sa-notice {
    margin: 0; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px;
    background: var(--surface); color: var(--text-secondary); font-size: 0.8rem;
  }
  .sa-notice.is-error { color: #ef334e; border-color: rgba(239, 51, 78, 0.4); }

  .sa-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 700px) { .sa-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sa-kpi { padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); }
  .sa-kpi span { display: block; font-size: 0.68rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px; }
  .sa-kpi strong { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; }
  .sa-kpi.is-danger strong { color: #ef334e; }

  .sa-panel { display: none; }
  .sa-panel.is-active { display: block; }
  .sa-layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr); gap: 12px; align-items: start; }
  @media (max-width: 1000px) { .sa-layout { grid-template-columns: 1fr; } }
  .sa-card { border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); padding: 12px; }
  .sa-credit-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }

  .sa-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .sa-filters input, .sa-filters select {
    height: 34px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.8rem;
  }
  .sa-filters input[type='search'] { flex: 1; min-width: 160px; }

  .sa-table-wrap { overflow-x: auto; }
  .sa-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .sa-table th, .sa-table td { padding: 8px 9px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  .sa-table th { font-size: 0.66rem; font-weight: 650; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap; }
  .sa-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sa-table .mono, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.74rem; }
  .sa-table .actions { white-space: nowrap; }
  .sa-row { cursor: pointer; }
  .sa-row:hover td { background: var(--surface-hover); }
  .sa-row.is-selected td { background: var(--accent-soft); }
  .sa-empty { text-align: center !important; color: var(--text-muted); padding: 24px !important; }
  .sa-foot { margin: 8px 0 0; font-size: 0.72rem; color: var(--text-muted); }
  .sa-mini { margin-top: 10px; }
  .muted { color: var(--text-muted); }
  .small { font-size: 0.75rem; }

  .sa-badge { display: inline-flex; padding: 2px 8px; border-radius: 999px; font-size: 0.66rem; font-weight: 650; white-space: nowrap; }
  .sa-badge-draft { background: rgba(148, 163, 184, 0.18); color: #64748b; }
  .sa-badge-partial, .sa-badge-pay-partial { background: rgba(217, 119, 6, 0.12); color: #d97706; }
  .sa-badge-received, .sa-badge-pay-paid { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
  .sa-badge-cancelled, .sa-badge-pay-unpaid { background: rgba(239, 51, 78, 0.12); color: #ef334e; }

  .sa-empty-detail { margin: 0; padding: 24px 8px; text-align: center; font-size: 0.8rem; color: var(--text-muted); }
  .sa-detail-head h3 { margin: 2px 0 6px; font-size: 1rem; font-weight: 650; }
  .sa-detail-head p { margin: 0; }
  .sa-detail-actions { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  #sa-detail h4 { margin: 14px 0 6px; font-size: 0.78rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-muted); }
  .sa-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem; }
  .sa-list li { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border); }
  .sa-list li.is-void span, .sa-list li.is-void strong { text-decoration: line-through; color: var(--text-muted); }

  .sa-totals { margin: 12px 0 0; display: grid; gap: 4px; font-size: 0.8rem; }
  .sa-totals div { display: flex; justify-content: space-between; gap: 10px; }
  .sa-totals dt { color: var(--text-secondary); }
  .sa-totals dd { margin: 0; font-variant-numeric: tabular-nums; }
  .sa-totals .strong dt, .sa-totals .strong dd { font-weight: 700; color: var(--text-primary); }

  .sa-dialog {
    border: none; border-radius: 14px; padding: 0; background: var(--panel-bg); color: var(--text-primary);
    box-shadow: 0 24px 60px rgba(0,0,0,0.28); max-width: 440px; width: calc(100% - 32px);
  }
  .sa-dialog.sa-wide { max-width: 680px; }
  .sa-dialog::backdrop { background: rgba(8,15,29,0.55); backdrop-filter: blur(4px); }
  .sa-dialog-inner { padding: 20px; max-height: 88vh; overflow-y: auto; }
