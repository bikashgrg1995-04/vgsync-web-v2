---
import AppLayout from '../../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../../lib/navigation';
import { PAGE_META } from '../../lib/page-meta';
import type { UserRole } from '../../lib/auth';

const meta = PAGE_META.suppliers;
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="sup-page" id="sup-page">
    <div class="sup-toolbar">
      <div>
        <p class="sup-scope" id="sup-scope">Branch suppliers</p>
        <h2 class="sup-heading">Supplier directory</h2>
      </div>
      <button type="button" class="btn-primary-sm" id="sup-add">+ New supplier</button>
    </div>

    <p class="sup-form-error" id="sup-load-error" role="alert" hidden></p>

    <div class="sup-kpis">
      <article class="sup-kpi">
        <span class="sup-kpi-label">Total</span>
        <strong id="kpi-total">—</strong>
      </article>
      <article class="sup-kpi">
        <span class="sup-kpi-label">Active</span>
        <strong id="kpi-active">—</strong>
      </article>
      <article class="sup-kpi">
        <span class="sup-kpi-label">Payable</span>
        <strong id="kpi-payable">—</strong>
      </article>
      <article class="sup-kpi">
        <span class="sup-kpi-label">Inactive</span>
        <strong id="kpi-inactive">—</strong>
      </article>
    </div>

    <div class="sup-layout">
      <section class="sup-list-panel">
        <div class="sup-filters">
          <div class="sup-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" id="sup-search" placeholder="Search name, phone, code…" autocomplete="off" />
          </div>
          <select id="sup-status-filter">
            <option value="">All status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>

        <div class="sup-table-wrap">
          <table class="sup-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Contact</th>
                <th>Phone</th>
                <th class="num">Payable</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="sup-tbody">
              <tr><td colspan="5">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="sup-footnote" id="sup-count"></p>
      </section>

      <aside class="sup-detail" id="sup-detail">
        <div class="sup-detail-empty" id="sup-detail-empty">
          <p>Select a supplier to view details</p>
          <p class="muted">Used in Purchase orders and payables</p>
        </div>

        <div class="sup-detail-body" id="sup-detail-body" hidden>
          <header class="sup-detail-head">
            <div>
              <p class="sup-detail-code" id="d-code">—</p>
              <h3 id="d-name">—</h3>
              <span class="sup-badge" id="d-status">—</span>
            </div>
            <div class="sup-detail-actions">
              <button type="button" class="btn-ghost-sm" id="sup-edit">Edit</button>
              <button type="button" class="btn-ghost-sm is-danger" id="sup-toggle">Deactivate</button>
            </div>
          </header>

          <dl class="sup-dl">
            <div><dt>Contact</dt><dd id="d-contact">—</dd></div>
            <div><dt>Phone</dt><dd id="d-phone">—</dd></div>
            <div><dt>Email</dt><dd id="d-email">—</dd></div>
            <div><dt>PAN</dt><dd id="d-pan">—</dd></div>
            <div class="span2"><dt>Address</dt><dd id="d-address">—</dd></div>
            <div><dt>You owe (total)</dt><dd id="d-credit-to-pay">—</dd></div>
            <div><dt>Received, unpaid</dt><dd id="d-outstanding">—</dd></div>
            <div><dt>On order, unpaid</dt><dd id="d-on-order">—</dd></div>
            <div><dt>Advance paid</dt><dd id="d-advance">—</dd></div>
            <div><dt>Supplier owes you</dt><dd id="d-credit-to-receive">—</dd></div>
            <div><dt>Total purchased</dt><dd id="d-total">—</dd></div>
            <div><dt>Replacement stock due</dt><dd id="d-stock-due">—</dd></div>
            <div><dt>Still to arrive</dt><dd id="d-stock-pending">—</dd></div>
            <div class="span2"><dt>Notes</dt><dd id="d-notes">—</dd></div>
          </dl>

          <p class="sup-detail-meta" id="d-meta"></p>

          <div class="sup-detail-links">
            <span class="chip">Purchase orders</span>
            <span class="chip">Bills</span>
            <span class="chip">Payments</span>
          </div>
          <p class="sup-hint">Suppliers are never deleted: deactivate one to hide it from new purchases.</p>
        </div>
      </aside>
    </div>
  </div>

  <dialog class="sup-dialog" id="sup-dialog">
    <form class="sup-dialog-inner" id="sup-form">
      <h2 class="sup-dialog-title" id="sup-form-title">New supplier</h2>
      <input type="hidden" id="f-id" />

      <div class="sup-form-grid">
        <label class="sup-field span2">
          <span>Name *</span>
          <input type="text" id="f-name" required placeholder="Company name" />
        </label>
        <label class="sup-field">
          <span>Status</span>
          <select id="f-status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </label>
        <label class="sup-field">
          <span>Contact person</span>
          <input type="text" id="f-contact" />
        </label>
        <label class="sup-field">
          <span>Phone</span>
          <input type="tel" id="f-phone" />
        </label>
        <label class="sup-field">
          <span>Email</span>
          <input type="email" id="f-email" />
        </label>
        <label class="sup-field span2">
          <span>Address</span>
          <input type="text" id="f-address" />
        </label>
        <label class="sup-field">
          <span>PAN / VAT number</span>
          <input type="text" id="f-pan" />
        </label>
        <label class="sup-field span2">
          <span>Notes</span>
          <input type="text" id="f-notes" />
        </label>
      </div>

      <p class="sup-form-error" id="f-error" hidden></p>

      <div class="sup-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="f-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="f-save">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import { getSession, refreshProfile } from '../../lib/auth';
  import { ApiError } from '../../lib/api';
  import {
    listSuppliers,
    createSupplier,
    updateSupplier,
    setSupplierActive,
    getSupplierSummary,
    formatNpr,
    type Supplier,
    type SupplierInput,
  } from '../../lib/suppliers';

  if (!getSession()) window.location.replace('/');

  let suppliers: Supplier[] = [];
  let selectedId: number | null = null;
  let canWrite = true;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  const FIELD_LABELS: Record<string, string> = {
    name: 'Name',
    contact_person: 'Contact person',
    phone: 'Phone',
    email: 'Email',
    address: 'Address',
    pan_number: 'PAN',
    notes: 'Notes',
    is_active: 'Status',
  };

  function describe(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Something went wrong. Please try again.';
    const entries = Object.entries(error.fields);
    if (entries.length > 0 && error.status === 400) {
      return entries.map(([key, msg]) => `${FIELD_LABELS[key] ?? key}: ${msg}`).join(' ');
    }
    return error.message;
  }

  function showLoadError(message: string | null): void {
    const el = $('sup-load-error');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  }

  function filtered(): Supplier[] {
    const q = ($<HTMLInputElement>('sup-search')?.value ?? '').trim().toLowerCase();
    const st = $<HTMLSelectElement>('sup-status-filter')?.value ?? '';
    return suppliers.filter((s) => {
      if (st === 'active' && !s.isActive) return false;
      if (st === 'inactive' && s.isActive) return false;
      if (!q) return true;
      return (
        s.name.toLowerCase().includes(q) ||
        s.phone.includes(q) ||
        s.pan.toLowerCase().includes(q) ||
        s.contactPerson.toLowerCase().includes(q)
      );
    });
  }

  function setText(id: string, value: string): void {
    const el = $(id);
    if (el) el.textContent = value || '—';
  }

  function renderKpis(): void {
    const s = getSupplierSummary(suppliers);
    setText('kpi-total', String(s.total));
    setText('kpi-active', String(s.active));
    setText('kpi-payable', formatNpr(s.payable));
    setText('kpi-inactive', String(s.inactive));
  }

  function renderTable(): void {
    const tbody = $('sup-tbody');
    const count = $('sup-count');
    if (!tbody) return;
    const rows = filtered();
    if (rows.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="sup-empty">No suppliers found.</td></tr>`;
      if (count) count.textContent = '0 suppliers';
      return;
    }
    tbody.innerHTML = rows
      .map((s) => {
        const active = s.id === selectedId ? ' is-selected' : '';
        const badge = s.isActive ? 'active' : 'inactive';
        return `<tr class="sup-row${active}" data-id="${s.id}">
          <td><strong>${esc(s.name)}</strong></td>
          <td>${esc(s.contactPerson) || '—'}</td>
          <td>${esc(s.phone) || '—'}</td>
          <td class="num">${formatNpr(s.creditToPay)}</td>
          <td><span class="sup-badge sup-badge-${badge}">${s.isActive ? 'Active' : 'Inactive'}</span></td>
        </tr>`;
      })
      .join('');
    if (count) count.textContent = `${rows.length} supplier${rows.length === 1 ? '' : 's'} · active branch only`;

    tbody.querySelectorAll<HTMLTableRowElement>('.sup-row').forEach((row) => {
      row.addEventListener('click', () => {
        selectedId = Number(row.dataset.id) || null;
        renderTable();
        renderDetail();
      });
    });
  }

  function selected(): Supplier | null {
    return suppliers.find((s) => s.id === selectedId) ?? null;
  }

  function renderDetail(): void {
    const empty = $('sup-detail-empty');
    const body = $('sup-detail-body');
    const s = selected();
    if (!s) {
      selectedId = null;
      empty?.removeAttribute('hidden');
      body?.setAttribute('hidden', '');
      return;
    }
    empty?.setAttribute('hidden', '');
    body?.removeAttribute('hidden');

    setText('d-code', `Supplier #${s.id}`);
    setText('d-name', s.name);
    setText('d-contact', s.contactPerson);
    setText('d-phone', s.phone);
    setText('d-email', s.email);
    setText('d-address', s.address);
    setText('d-pan', s.pan);
    setText('d-credit-to-pay', formatNpr(s.creditToPay));
    setText('d-outstanding', formatNpr(s.outstanding));
    setText('d-on-order', formatNpr(s.toPayOnOrder));
    setText('d-advance', formatNpr(s.advancePaid));
    setText('d-credit-to-receive', formatNpr(s.creditToReceive));
    setText('d-total', formatNpr(s.totalPurchased));
    setText('d-stock-due', String(s.stockToReceive));
    setText('d-stock-pending', String(s.stockPendingDelivery));
    setText('d-notes', s.notes);
    setText(
      'd-meta',
      `Created ${new Date(s.createdAt).toLocaleDateString()} · Updated ${new Date(s.updatedAt).toLocaleDateString()}`,
    );

    const st = $('d-status');
    if (st) {
      st.textContent = s.isActive ? 'Active' : 'Inactive';
      st.className = `sup-badge sup-badge-${s.isActive ? 'active' : 'inactive'}`;
    }

    const toggle = $('sup-toggle');
    if (toggle) toggle.textContent = s.isActive ? 'Deactivate' : 'Reactivate';
  }

  function applyWriteAccess(): void {
    const session = getSession();
    // A company owner has read-only access inside a branch.
    canWrite = session?.accessMode !== 'read_only';
    for (const id of ['sup-add', 'sup-edit', 'sup-toggle']) {
      const el = $(id);
      if (el) el.hidden = !canWrite;
    }
  }

  async function reload(): Promise<void> {
    const sess = getSession();
    const scope = $('sup-scope');
    if (scope && sess) scope.textContent = `${sess.activeBranchName} (${sess.activeBranchCode})`;
    applyWriteAccess();

    try {
      suppliers = await listSuppliers();
      showLoadError(canWrite ? null : 'Read-only: you are viewing this branch from Head Office.');
    } catch (error) {
      suppliers = [];
      showLoadError(describe(error));
    }

    if (selectedId && !selected()) selectedId = null;
    renderKpis();
    renderTable();
    renderDetail();
  }

  const dialog = $<HTMLDialogElement>('sup-dialog');
  const form = $<HTMLFormElement>('sup-form');

  const input = (id: string) => $<HTMLInputElement>(id)!;

  function openForm(edit?: Supplier): void {
    setText('sup-form-title', edit ? 'Edit supplier' : 'New supplier');
    input('f-id').value = edit ? String(edit.id) : '';
    input('f-name').value = edit?.name ?? '';
    $<HTMLSelectElement>('f-status')!.value = edit && !edit.isActive ? 'inactive' : 'active';
    input('f-contact').value = edit?.contactPerson ?? '';
    input('f-phone').value = edit?.phone ?? '';
    input('f-email').value = edit?.email ?? '';
    input('f-address').value = edit?.address ?? '';
    input('f-pan').value = edit?.pan ?? '';
    input('f-notes').value = edit?.notes ?? '';
    const err = $('f-error');
    if (err) err.hidden = true;
    dialog?.showModal();
  }

  $('sup-add')?.addEventListener('click', () => openForm());
  $('sup-edit')?.addEventListener('click', () => {
    const s = selected();
    if (s) openForm(s);
  });

  $('sup-toggle')?.addEventListener('click', async () => {
    const s = selected();
    if (!s) return;
    const next = !s.isActive;
    if (!next && !confirm(`Deactivate ${s.name}? It will no longer be offered on new purchases.`)) return;

    const button = $<HTMLButtonElement>('sup-toggle')!;
    button.disabled = true;
    try {
      await setSupplierActive(s.id, next);
      await reload();
    } catch (error) {
      alert(describe(error));
    } finally {
      button.disabled = false;
    }
  });

  $('f-cancel')?.addEventListener('click', () => dialog?.close());

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('f-error');
    const save = $<HTMLButtonElement>('f-save');
    if (err) err.hidden = true;

    const id = Number(input('f-id').value) || null;
    const payload: SupplierInput = {
      name: input('f-name').value,
      isActive: $<HTMLSelectElement>('f-status')!.value === 'active',
      contactPerson: input('f-contact').value,
      phone: input('f-phone').value,
      email: input('f-email').value,
      address: input('f-address').value,
      pan: input('f-pan').value,
      notes: input('f-notes').value,
    };

    if (!payload.name.trim()) {
      if (err) {
        err.hidden = false;
        err.textContent = 'Name is required.';
      }
      return;
    }

    if (save) save.disabled = true;
    try {
      const saved = id ? await updateSupplier(id, payload) : await createSupplier(payload);
      selectedId = saved.id;
      dialog?.close();
      await reload();
    } catch (error) {
      if (err) {
        err.hidden = false;
        err.textContent = describe(error);
      }
    } finally {
      if (save) save.disabled = false;
    }
  });

  $('sup-search')?.addEventListener('input', () => renderTable());
  $('sup-status-filter')?.addEventListener('change', () => renderTable());

  void reload();
  // Fresh role/branch access from the server, then re-apply it.
  refreshProfile().then(applyWriteAccess).catch(() => {});
</script>

<style>
  .sup-page { display: flex; flex-direction: column; gap: 14px; }
  .sup-toolbar {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .sup-scope { margin: 0 0 2px; font-size: 0.75rem; color: var(--text-muted); }
  .sup-heading { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.02em; }

  .btn-primary-sm, .btn-ghost-sm {
    height: 34px; padding: 0 12px; border-radius: 8px;
    font-family: inherit; font-size: 0.8rem; font-weight: 650; cursor: pointer;
  }
  .btn-primary-sm { border: none; background: var(--accent); color: #fff; }
  .btn-ghost-sm { border: 1px solid var(--border); background: transparent; color: var(--text-secondary); }
  .btn-ghost-sm:hover { background: var(--surface-hover); color: var(--text-primary); }
  .btn-ghost-sm.is-danger { color: #ef334e; border-color: color-mix(in srgb, #ef334e 35%, var(--border)); }

  .sup-kpis {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
  }
  @media (max-width: 700px) { .sup-kpis { grid-template-columns: repeat(2, 1fr); } }

  .sup-kpi {
    padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg);
  }
  .sup-kpi-label {
    display: block; font-size: 0.68rem; font-weight: 600; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px;
  }
  .sup-kpi strong { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; }
  .sup-kpi.is-danger strong { color: #ef334e; }

  .sup-layout {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.9fr);
    gap: 12px; align-items: start;
  }
  @media (max-width: 900px) { .sup-layout { grid-template-columns: 1fr; } }

  .sup-list-panel, .sup-detail {
    border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); padding: 12px;
  }

  .sup-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .sup-search {
    display: flex; align-items: center; gap: 8px; flex: 1; min-width: 160px;
    height: 34px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-muted);
  }
  .sup-search input {
    flex: 1; min-width: 0; border: none; outline: none; background: transparent;
    color: var(--text-primary); font-family: inherit; font-size: 0.82rem;
  }
  .sup-filters select {
    height: 34px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.8rem;
  }

  .sup-table-wrap { overflow-x: auto; }
  .sup-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .sup-table th, .sup-table td {
    padding: 9px 10px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap;
  }
  .sup-table th {
    font-size: 0.68rem; font-weight: 650; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em;
  }
  .sup-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .sup-table .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.74rem; }
  .sup-row { cursor: pointer; }
  .sup-row:hover td { background: var(--surface-hover); }
  .sup-row.is-selected td { background: var(--accent-soft); }
  .sup-empty { text-align: center !important; color: var(--text-muted); padding: 24px !important; }
  .sup-footnote { margin: 8px 0 0; font-size: 0.72rem; color: var(--text-muted); }

  .sup-badge {
    display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 999px;
    font-size: 0.68rem; font-weight: 650;
  }
  .sup-badge-active { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
  .sup-badge-inactive { background: rgba(148, 163, 184, 0.15); color: #64748b; }
  .sup-badge-blocked { background: rgba(239, 51, 78, 0.12); color: #ef334e; }

  .sup-detail-empty {
    min-height: 220px; display: grid; place-content: center; text-align: center; gap: 4px;
    color: var(--text-secondary); font-size: 0.88rem;
  }
  .sup-detail-empty .muted { font-size: 0.75rem; color: var(--text-muted); }

  .sup-detail-head {
    display: flex; justify-content: space-between; gap: 10px; margin-bottom: 14px;
  }
  .sup-detail-code { margin: 0; font-size: 0.72rem; color: var(--text-muted); font-family: ui-monospace, monospace; }
  .sup-detail-head h3 { margin: 2px 0 6px; font-size: 1rem; font-weight: 650; }
  .sup-detail-actions { display: flex; gap: 6px; flex-shrink: 0; }

  .sup-dl { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; margin: 0; }
  .sup-dl .span2 { grid-column: 1 / -1; }
  .sup-dl dt {
    font-size: 0.65rem; font-weight: 650; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 2px;
  }
  .sup-dl dd { margin: 0; font-size: 0.84rem; color: var(--text-primary); word-break: break-word; }

  .sup-detail-meta { margin: 12px 0 0; font-size: 0.7rem; color: var(--text-muted); }
  .sup-detail-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .chip {
    padding: 4px 8px; border-radius: 999px; font-size: 0.68rem; font-weight: 600;
    background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
  }
  .sup-hint { margin: 8px 0 0; font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; }

  .sup-dialog {
    border: none; border-radius: 14px; padding: 0; background: var(--panel-bg);
    color: var(--text-primary); box-shadow: 0 24px 60px rgba(0,0,0,0.28);
    max-width: 520px; width: calc(100% - 32px);
  }
  .sup-dialog::backdrop { background: rgba(8,15,29,0.55); backdrop-filter: blur(4px); }
  .sup-dialog-inner { padding: 20px; }
  .sup-dialog-title { margin: 0 0 14px; font-size: 1rem; font-weight: 650; }

  .sup-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; }
  .sup-field {
    display: flex; flex-direction: column; gap: 4px;
    font-size: 0.72rem; font-weight: 600; color: var(--text-secondary);
  }
  .sup-field.span2 { grid-column: 1 / -1; }
