
---
import AppLayout from "../../layouts/AppLayout.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../lib/navigation";
import { PAGE_META } from "../../lib/page-meta";
import type { UserRole } from "../../lib/auth";
import "../../styles/app/inventory-page.css";

const meta = PAGE_META.inventory;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page" id="inv-page">
    <p class="inv-scope" id="inv-scope" hidden>Stock</p>

    <header class="inv-hero">
      <div class="inv-hero-text">
        <div class="inv-hero-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73Z"></path>
            <path d="m3.3 7 8.7 5 8.7-5"></path>
            <path d="M12 22V12"></path>
          </svg>
        </div>

        <div>
          <h2 class="inv-hero-title">Inventory</h2>
          <p class="inv-hero-sub">
            Stock details, product availability and inventory overview.
          </p>
        </div>
      </div>

      <div class="inv-hero-actions">
        <button type="button" class="btn-primary-sm" id="inv-add" hidden>+ Add Stock</button>
        <button type="button" class="btn-ghost-sm" id="inv-import" title="Coming soon" disabled>Import</button>
        <button type="button" class="btn-ghost-sm" id="inv-mrp" title="Coming soon" disabled>Update MRP</button>
        <button type="button" class="btn-ghost-sm" id="inv-export" title="Coming soon" disabled>Export</button>
        <button type="button" class="btn-warn-sm" id="inv-low-filter">Low Stocks</button>
      </div>
    </header>

    <p class="inv-notice" id="inv-notice" hidden></p>

    <!-- INVENTORY SUMMARY -->
    <div class="inv-kpis" id="inv-kpis">
      <article class="inv-kpi">
        <span class="inv-kpi-label">Products</span>
        <strong class="inv-kpi-value" id="kpi-skus">—</strong>
      </article>
      <article class="inv-kpi">
        <span class="inv-kpi-label">Units on hand</span>
        <strong class="inv-kpi-value" id="kpi-units">—</strong>
      </article>
      <article class="inv-kpi">
        <span class="inv-kpi-label">Stock value</span>
        <strong class="inv-kpi-value" id="kpi-value">—</strong>
      </article>
      <article class="inv-kpi is-warn">
        <span class="inv-kpi-label">Low stock</span>
        <strong class="inv-kpi-value" id="kpi-low">—</strong>
      </article>
      <article class="inv-kpi is-danger">
        <span class="inv-kpi-label">Out of stock</span>
        <strong class="inv-kpi-value" id="kpi-out">—</strong>
      </article>
    </div>

    <!-- STOCK LIST -->
    <section class="inv-panel is-active" data-inv-panel="stock">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Stock List</h3>

          <div class="inv-filters">
            <div class="inv-search">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <input type="search" id="inv-search" placeholder="Search stock…" autocomplete="off" />
            </div>

            <select id="inv-category" aria-label="Category">
              <option value="">All Categories</option>
            </select>

            <select id="inv-status" aria-label="Status">
              <option value="">All Status</option>
              <option value="in_stock">In Stock</option>
              <option value="low">Low Stock</option>
              <option value="out">Out of Stock</option>
            </select>
          </div>
        </div>

        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Stock ID</th>
                <th>Stock Name</th>
                <th class="num">Current Stock</th>
                <th class="num hide-sm">Selling Price</th>
                <th>Status</th>
                <th class="actions">Actions</th>
              </tr>
            </thead>
            <tbody id="inv-tbody">
              <tr>
                <td colspan="6" class="inv-empty">Loading…</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="inv-footnote" id="inv-count"></p>
      </div>

      <!-- CATEGORY + RECENT ACTIVITY -->
      <div class="inv-bottom-grid">
        <!-- STOCK BY CATEGORY -->
        <div class="inv-card inv-cat-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Stock by Category</h3>
          </div>

          <div class="inv-cat-body" id="inv-cat-body">
            <div class="inv-donut-wrap">
              <svg class="inv-donut" viewBox="0 0 42 42" aria-hidden="true" id="inv-donut"></svg>
              <div class="inv-donut-center">
                <strong id="inv-cat-total">0</strong>
                <span>Total Stock</span>
              </div>
            </div>

            <ul class="inv-cat-legend" id="inv-cat-legend"></ul>
          </div>

          <div class="inv-pager inv-mini-pager" id="inv-cat-pager" hidden>
            <span id="inv-cat-page-info">Page 1</span>
            <div class="inv-page-actions">
              <button type="button" class="inv-page-btn" id="inv-cat-prev" disabled>Previous</button>
              <button type="button" class="inv-page-btn" id="inv-cat-next">Next</button>
            </div>
          </div>
        </div>

        <!-- RECENT STOCK ACTIVITIES -->
        <div class="inv-card inv-act-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Recent Stock Activities</h3>
            <button type="button" class="btn-link" id="inv-view-moves">View All →</button>
          </div>

          <ul class="inv-activity" id="inv-activity">
            <li class="inv-activity-empty">No recent movements</li>
          </ul>

          <div class="inv-pager inv-mini-pager" id="inv-act-pager" hidden>
            <span id="inv-act-page-info">Page 1</span>
            <div class="inv-page-actions">
              <button type="button" class="inv-page-btn" id="inv-act-prev" disabled>Previous</button>
              <button type="button" class="inv-page-btn" id="inv-act-next">Next</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MOVEMENT HISTORY -->
    <section class="inv-panel" data-inv-panel="moves">
      <button type="button" class="btn-link inv-back-stock" id="inv-back-stock">
        ← Back to stock list
      </button>

      <div class="inv-card">
        <div class="inv-filters inv-filters-moves">
          <div class="inv-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="search" id="mv-search" placeholder="Search product, reference or note…" autocomplete="off" />
          </div>

          <select id="mv-type" aria-label="Movement type">
            <option value="">All types</option>
          </select>
          <input type="date" id="mv-from" aria-label="From date" />
          <input type="date" id="mv-to" aria-label="To date" />
        </div>

        <div class="inv-table-wrap">
          <table class="inv-table inv-table-moves">
            <thead>
              <tr>
                <th>When</th>
                <th>Stock no</th>
                <th>Product</th>
                <th>Type</th>
                <th class="hide-sm">Stock</th>
                <th class="num">Qty</th>
                <th class="num hide-sm">Balance</th>
                <th class="hide-md">Reference</th>
                <th class="hide-md">By</th>
              </tr>
            </thead>
            <tbody id="moves-tbody">
              <tr>
                <td colspan="9" class="inv-empty">Loading…</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="inv-pager">
          <span class="inv-footnote" id="mv-count"></span>
          <div>
            <button type="button" class="btn-ghost-sm" id="mv-prev">Previous</button>
            <button type="button" class="btn-ghost-sm" id="mv-next">Next</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- STOCK ADJUSTMENT DIALOG -->
  <dialog class="inv-dialog" id="inv-adjust-dialog">
    <form method="dialog" class="inv-dialog-inner" id="inv-adjust-form">
      <h2 class="inv-dialog-title">Adjust stock</h2>
      <p class="inv-dialog-sub" id="adj-product">—</p>
      <input type="hidden" id="adj-id" />

      <label class="inv-field">
        <span>Adjustment type</span>
        <select id="adj-type" required>
          <option value="increase">Increase good stock</option>
          <option value="decrease">Decrease good stock</option>
          <option value="mark_damaged">Mark as damaged</option>
          <option value="remove_damaged">Remove damaged stock</option>
        </select>
      </label>

      <label class="inv-field">
        <span>Reason</span>
        <select id="adj-reason" required></select>
      </label>

      <label class="inv-field">
        <span>Quantity</span>
        <input type="number" id="adj-qty" required min="0.001" step="0.001" value="1" />
      </label>

      <label class="inv-field">
        <span>Reference (optional)</span>
        <input type="text" id="adj-ref" maxlength="100" placeholder="e.g. Count sheet 12" />
      </label>

      <label class="inv-field">
        <span>Note (optional)</span>
        <input type="text" id="adj-note" placeholder="Additional information" />
      </label>

      <p class="inv-dialog-error" id="adj-error" hidden></p>

      <div class="inv-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="adj-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="adj-submit">Apply</button>
      </div>
    </form>
  </dialog>

  <!-- PRODUCT DIALOG -->
  <dialog class="inv-dialog inv-dialog-wide" id="inv-product-dialog">
    <form method="dialog" class="inv-dialog-inner" id="inv-product-form">
      <h2 class="inv-dialog-title" id="prd-title">Add product</h2>

      <p class="inv-dialog-sub">
        Products are shared by Head Office and every branch. Each branch keeps
        its own stock.
      </p>

      <input type="hidden" id="prd-id" />

      <div class="inv-grid">
        <label class="inv-field">
          <span>Stock no *</span>
          <input type="text" id="prd-stock-no" required maxlength="100" />
        </label>

        <label class="inv-field">
          <span>Name *</span>
          <input type="text" id="prd-name" required maxlength="200" />
        </label>

        <label class="inv-field">
          <span>Brand</span>
          <input type="text" id="prd-brand" maxlength="100" />
        </label>

        <label class="inv-field">
          <span>Model</span>
          <input type="text" id="prd-model" maxlength="100" />
        </label>

        <label class="inv-field">
          <span>Category</span>
          <input type="text" id="prd-category" maxlength="100" list="prd-category-list" />
          <datalist id="prd-category-list"></datalist>
        </label>

        <label class="inv-field">
          <span>Group</span>
          <input type="text" id="prd-group" maxlength="100" />
        </label>

        <label class="inv-field">
          <span>Unit</span>
          <input type="text" id="prd-unit" maxlength="20" value="pcs" />
        </label>

        <label class="inv-field">
          <span>Reorder at (0 = no alert)</span>
          <input type="number" id="prd-reorder" min="0" step="0.001" value="0" />
        </label>

        <label class="inv-field">
          <span>Purchase price</span>
          <input type="number" id="prd-cost" min="0" step="0.01" value="0" />
        </label>

        <label class="inv-field">
          <span>Sale price</span>
          <input type="number" id="prd-sale" min="0" step="0.01" value="0" />
        </label>

        <label class="inv-field">
          <span>MRP</span>
          <input type="number" id="prd-mrp" min="0" step="0.01" value="0" />
        </label>
      </div>

      <p class="inv-dialog-error" id="prd-error" hidden></p>

      <div class="inv-dialog-actions">
        <button type="button" class="btn-ghost-sm" id="prd-cancel">Cancel</button>
        <button type="submit" class="btn-primary-sm" id="prd-submit">Save</button>
      </div>
    </form>
  </dialog>
</AppLayout>

<script>
  import "../../scripts/inventory-page.ts";
</script>
