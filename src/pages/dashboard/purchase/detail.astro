---
import AppLayout from "../../../layouts/AppLayout.astro";
import PurchaseDialogs from "../../../components/purchase/PurchaseDialogs.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../../lib/navigation";
import { PAGE_META } from "../../../lib/page-meta";
import type { UserRole } from "../../../lib/auth";
import "../../../styles/app/inventory-page.css";
import "../../../styles/app/inventory-detail.css";
import "../../../styles/app/purchase-shared.css";
import "../../../styles/app/purchase-page.css";
import "../../../styles/app/purchase-detail.css";

const meta = PAGE_META.purchase;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Purchase Detail"
  pageTitle={meta.title}
  breadcrumb="Purchase / Detail"
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page invd-page pud-page" id="pud-page">
    <a class="invd-back" href="/dashboard/purchase">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
      Back to Purchase
    </a>

    <p class="inv-notice" id="pud-notice" hidden></p>

    <!-- PURCHASE HEADER -->
    <section class="inv-card invd-header pud-header" id="pud-header">
      <div class="invd-photo">
        <span class="inv-prod-icon" id="pud-initial">?</span>
      </div>

      <div class="invd-head-main">
        <div class="invd-title-row">
          <h2 class="invd-title" id="pud-no">Loading…</h2>
          <span id="pud-status"></span>
          <span id="pud-pay"></span>
        </div>
        <div class="invd-chips">
          <span class="invd-chip" id="pud-supplier">—</span>
          <span class="invd-chip" id="pud-bill" hidden></span>
        </div>
        <p class="invd-desc" id="pud-notes"></p>
        <div class="invd-chips">
          <span class="invd-tag" id="pud-date"></span>
          <span class="invd-tag is-neutral" id="pud-items"></span>
        </div>
      </div>

      <div class="invd-stats">
        <div class="invd-stat"><strong id="pud-stat-net">—</strong><span>Net Total</span></div>
        <div class="invd-stat"><strong id="pud-stat-paid">—</strong><span>Paid</span></div>
        <div class="invd-stat"><strong id="pud-stat-due">—</strong><span>Due</span></div>
      </div>

      <div class="pud-actionbar" id="pud-actionbar" hidden>
        <button type="button" class="btn-primary-sm" data-act="receive" hidden>Receive goods</button>
        <button type="button" class="btn-ghost-sm" data-act="pay" hidden>Record payment</button>
        <button type="button" class="btn-ghost-sm" data-act="return" hidden>Return goods</button>
        <button type="button" class="btn-ghost-sm" data-act="edit" hidden>Edit</button>
        <button type="button" class="btn-ghost-sm is-danger" data-act="cancel" hidden>Cancel purchase</button>
      </div>
    </section>

    <!-- TABS -->
    <div class="invd-tabs" role="tablist">
      <button type="button" class="invd-tab is-active" role="tab" data-tab="details">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"></path></svg>
        Purchase Details
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="payments">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
        Payments
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="deliveries">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 17h4V5H2v12h3"></path><path d="M14 8h4l4 4v5h-3"></path><circle cx="7.5" cy="17.5" r="2"></circle><circle cx="17.5" cy="17.5" r="2"></circle></svg>
        Deliveries
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="activities">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        Activities
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="related">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        Related Info
      </button>
    </div>

    <!-- TAB: PURCHASE DETAILS -->
    <section class="invd-panel is-active" data-panel="details">
      <div class="invd-grid-top">
        <div class="inv-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Purchase Information</h3>
          </div>
          <div class="invd-info">
            <dl class="invd-dl">
              <div><dt>PO Number</dt><dd id="inf-no">—</dd></div>
              <div><dt>Supplier</dt><dd id="inf-supplier">—</dd></div>
              <div><dt>Bill No</dt><dd id="inf-bill">—</dd></div>
              <div><dt>Purchase Date</dt><dd id="inf-date">—</dd></div>
              <div><dt>Payment</dt><dd id="inf-pay">—</dd></div>
            </dl>
            <dl class="invd-dl">
              <div><dt>Subtotal</dt><dd id="inf-subtotal">—</dd></div>
              <div><dt>Discount</dt><dd id="inf-discount">—</dd></div>
              <div><dt id="inf-vat-label">VAT</dt><dd id="inf-vat">—</dd></div>
              <div><dt>Freight</dt><dd id="inf-freight">—</dd></div>
              <div><dt>Net Total</dt><dd class="is-big" id="inf-net">—</dd></div>
            </dl>
          </div>
        </div>

        <div class="inv-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Payment &amp; Delivery</h3>
          </div>
          <div class="pud-progress">
            <div class="pud-prog">
              <div class="pud-prog-head">
                <span>Paid</span>
                <strong id="pg-pay-text">—</strong>
              </div>
              <div class="pud-bar"><i class="is-pay" id="pg-pay-bar" style="width:0"></i></div>
              <small id="pg-pay-note"></small>
            </div>

            <div class="pud-prog">
              <div class="pud-prog-head">
                <span>Delivered</span>
                <strong id="pg-del-text">—</strong>
              </div>
              <div class="pud-bar"><i class="is-del" id="pg-del-bar" style="width:0"></i></div>
              <small id="pg-del-note"></small>
            </div>

            <div class="invd-values pud-values">
              <div>
                <span>Amount Due</span>
                <strong id="pg-due">—</strong>
                <small id="pg-due-note"></small>
              </div>
              <div>
                <span>Credit Applied</span>
                <strong id="pg-credit">—</strong>
                <small>From returned goods</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Items</h3>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table pud-items">
            <thead>
              <tr>
                <th>Item</th>
                <th class="num">Qty</th>
                <th class="num">Unit Price</th>
                <th class="num">Total</th>
                <th class="num">Received</th>
                <th class="num hide-sm">Returned</th>
              </tr>
            </thead>
            <tbody id="pud-lines"><tr><td colspan="6" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: PAYMENTS -->
    <section class="invd-panel" data-panel="payments">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Payments</h3>
          <button type="button" class="btn-link" id="pud-pay-btn" hidden>+ Record payment</button>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Method</th>
                <th class="hide-sm">Reference</th>
                <th class="num">Amount</th>
                <th>Status</th>
                <th class="actions"></th>
              </tr>
            </thead>
            <tbody id="pud-payments"><tr><td colspan="6" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: DELIVERIES -->
    <section class="invd-panel" data-panel="deliveries">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Deliveries</h3>
          <button type="button" class="btn-link" id="pud-receive-btn" hidden>+ Receive goods</button>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Received on</th>
                <th>Goods</th>
                <th class="hide-sm">Notes</th>
              </tr>
            </thead>
            <tbody id="pud-deliveries"><tr><td colspan="3" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: ACTIVITIES -->
    <section class="invd-panel" data-panel="activities">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Activities</h3>
        </div>
        <ul class="inv-activity" id="pud-activity">
          <li class="inv-activity-empty">Loading…</li>
        </ul>
      </div>
    </section>

    <!-- TAB: RELATED INFO -->
    <section class="invd-panel" data-panel="related">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Supplier &amp; Notes</h3>
        </div>
        <dl class="invd-related" id="pud-related"></dl>
      </div>

      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Returns on this purchase</h3>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Return</th>
                <th>Date</th>
                <th>Goods</th>
                <th class="hide-sm">Reason</th>
                <th class="num">Credit</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="pud-returns"><tr><td colspan="6" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <PurchaseDialogs />
</AppLayout>

<script>
  import "../../../scripts/purchase-detail.ts";
</script>
