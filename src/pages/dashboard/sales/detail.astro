---
import AppLayout from "../../../layouts/AppLayout.astro";
import SalesDialogs from "../../../components/sales/SalesDialogs.astro";
import { getNavItemsForRole, BOTTOM_NAV } from "../../../lib/navigation";
import { PAGE_META } from "../../../lib/page-meta";
import type { UserRole } from "../../../lib/auth";
import "../../../styles/app/inventory-page.css";
import "../../../styles/app/inventory-detail.css";
import "../../../styles/app/sales-shared.css";
import "../../../styles/app/purchase-page.css";
import "../../../styles/app/purchase-detail.css";
import "../../../styles/app/sales-detail.css";

const meta = PAGE_META.sales;
const defaultRole: UserRole = "owner";
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title="VGSync | Sale Detail"
  pageTitle={meta.title}
  breadcrumb="Sales / Detail"
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="inv-page invd-page pud-page sad-page" id="sad-page">
    <a class="invd-back" href="/dashboard/sales">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
      Back to Sales
    </a>

    <p class="inv-notice" id="sad-notice" hidden></p>

    <!-- SALE HEADER -->
    <section class="inv-card invd-header pud-header" id="sad-header">
      <div class="invd-photo">
        <span class="inv-prod-icon" id="sad-initial">?</span>
      </div>

      <div class="invd-head-main">
        <div class="invd-title-row">
          <h2 class="invd-title" id="sad-no">Loading…</h2>
          <span id="sad-status"></span>
          <span id="sad-pay"></span>
        </div>
        <div class="invd-chips">
          <span class="invd-chip" id="sad-customer">—</span>
          <span class="invd-chip" id="sad-kind" hidden></span>
          <span class="invd-chip" id="sad-vehicle" hidden></span>
        </div>
        <p class="invd-desc" id="sad-notes"></p>
        <div class="invd-chips">
          <span class="invd-tag" id="sad-date"></span>
          <span class="invd-tag is-neutral" id="sad-items"></span>
        </div>
      </div>

      <div class="invd-stats">
        <div class="invd-stat"><strong id="sad-stat-net">—</strong><span>Net Total</span></div>
        <div class="invd-stat"><strong id="sad-stat-paid">—</strong><span>Paid</span></div>
        <div class="invd-stat"><strong id="sad-stat-due">—</strong><span>Due</span></div>
      </div>

      <div class="pud-actionbar" id="sad-actionbar" hidden>
        <button type="button" class="btn-primary-sm" data-act="confirm" hidden>Confirm sale</button>
        <button type="button" class="btn-ghost-sm" data-act="pay" hidden>Record payment</button>
        <button type="button" class="btn-ghost-sm" data-act="return" hidden>Return goods</button>
        <button type="button" class="btn-ghost-sm" data-act="edit" hidden>Edit</button>
        <button type="button" class="btn-ghost-sm is-danger" data-act="cancel" hidden>Cancel sale</button>
      </div>
    </section>

    <!-- TABS -->
    <div class="invd-tabs" role="tablist">
      <button type="button" class="invd-tab is-active" role="tab" data-tab="details">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6"></path><path d="M9 17h6"></path></svg>
        Sale Details
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="payments">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
        Payments
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="emi" id="sad-emi-tab" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
        EMI Schedule
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="activities">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        Activities
      </button>
      <button type="button" class="invd-tab" role="tab" data-tab="related">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        Related Info
      </button>
    </div>

    <!-- TAB: SALE DETAILS -->
    <section class="invd-panel is-active" data-panel="details">
      <div class="invd-grid-top">
        <div class="inv-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Sale Information</h3>
          </div>
          <div class="invd-info">
            <dl class="invd-dl">
              <div><dt>Invoice No</dt><dd id="inf-invoice">—</dd></div>
              <div><dt>Sale No</dt><dd id="inf-no">—</dd></div>
              <div><dt>Customer</dt><dd id="inf-customer">—</dd></div>
              <div><dt>Sale Date</dt><dd id="inf-date">—</dd></div>
              <div><dt>Kind</dt><dd id="inf-kind">—</dd></div>
              <div><dt id="inf-due-label">Pay By</dt><dd id="inf-due">—</dd></div>
            </dl>
            <dl class="invd-dl">
              <div><dt>Subtotal</dt><dd id="inf-subtotal">—</dd></div>
              <div><dt>Discount</dt><dd id="inf-discount">—</dd></div>
              <div><dt id="inf-vat-label">VAT</dt><dd id="inf-vat">—</dd></div>
              <div><dt>Net Total</dt><dd class="is-big" id="inf-net">—</dd></div>
              <div id="inf-rate-row" hidden><dt>Interest (yearly)</dt><dd id="inf-rate">—</dd></div>
              <div id="inf-finance-row" hidden><dt>Finance Charge</dt><dd id="inf-finance">—</dd></div>
              <div id="inf-monthly-row" hidden><dt id="inf-monthly-label">Monthly Installment</dt><dd id="inf-monthly">—</dd></div>
              <div id="inf-amountdue-row" hidden><dt>Amount Due (with finance)</dt><dd id="inf-amountdue">—</dd></div>
            </dl>
          </div>
        </div>

        <div class="inv-card">
          <div class="inv-card-head">
            <h3 class="inv-card-title">Payment Progress</h3>
          </div>
          <div class="pud-progress">
            <div class="pud-prog">
              <div class="pud-prog-head">
                <span>Paid</span>
                <strong id="pg-pay-text">—</strong>
              </div>
              <div class="pud-bar"><i class="is-pay" id="pg-pay-bar" style="width:0"></i></div>
              <small id="pg-pay-note"></small>
            </div>

            <div class="pud-prog" id="pg-emi-wrap" hidden>
              <div class="pud-prog-head">
                <span>Instalments paid</span>
                <strong id="pg-emi-text">—</strong>
              </div>
              <div class="pud-bar"><i class="is-del" id="pg-emi-bar" style="width:0"></i></div>
              <small id="pg-emi-note"></small>
            </div>

            <div class="invd-values pud-values">
              <div>
                <span>Still to Receive</span>
                <strong id="pg-due">—</strong>
                <small id="pg-due-note"></small>
              </div>
              <div>
                <span>Returned &amp; Credit</span>
                <strong id="pg-credit">—</strong>
                <small id="pg-credit-note">Goods returned or credit used</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Items</h3>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table pud-items">
            <thead>
              <tr>
                <th>Item</th>
                <th class="num">Qty</th>
                <th class="num">Unit Price</th>
                <th class="num">Total</th>
                <th class="num hide-sm">Returned</th>
              </tr>
            </thead>
            <tbody id="sad-lines"><tr><td colspan="5" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: PAYMENTS -->
    <section class="invd-panel" data-panel="payments">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Payments</h3>
          <button type="button" class="btn-link" id="sad-pay-btn" hidden>+ Record payment</button>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Method</th>
                <th class="hide-sm">Reference</th>
                <th class="num">Amount</th>
                <th>Status</th>
                <th class="actions"></th>
              </tr>
            </thead>
            <tbody id="sad-payments"><tr><td colspan="6" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: EMI -->
    <section class="invd-panel" data-panel="emi">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">EMI Schedule</h3>
        </div>
        <p class="sad-emi-sum" id="sad-emi-sum"></p>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Due</th>
                <th class="num">Amount</th>
                <th class="num">Paid</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="sad-emi"><tr><td colspan="5" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB: ACTIVITIES -->
    <section class="invd-panel" data-panel="activities">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Activities</h3>
        </div>
        <ul class="inv-activity" id="sad-activity">
          <li class="inv-activity-empty">Loading…</li>
        </ul>
      </div>
    </section>

    <!-- TAB: RELATED INFO -->
    <section class="invd-panel" data-panel="related">
      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Customer &amp; Notes</h3>
        </div>
        <dl class="invd-related" id="sad-related"></dl>
      </div>

      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Returns on this sale</h3>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Return</th>
                <th>Date</th>
                <th>Goods</th>
                <th class="hide-sm">Reason</th>
                <th class="num">Value</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="sad-returns"><tr><td colspan="6" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="inv-card">
        <div class="inv-card-head">
          <h3 class="inv-card-title">Follow-ups</h3>
        </div>
        <div class="inv-table-wrap">
          <table class="inv-table">
            <thead>
              <tr>
                <th>Due</th>
                <th>Kind</th>
                <th class="num">Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="sad-followups"><tr><td colspan="4" class="inv-empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <SalesDialogs />
</AppLayout>

<script>
  import "../../../scripts/sales-detail.ts";
</script>
