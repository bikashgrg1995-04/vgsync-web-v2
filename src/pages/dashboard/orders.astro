  .or-field input { height: 36px; padding: 0 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.85rem; }
  .or-lines-head { display: flex; justify-content: space-between; align-items: center; margin: 10px 0 6px; font-size: 0.85rem; }
  .or-lines { display: flex; flex-direction: column; gap: 8px; }
  .or-line { display: grid; grid-template-columns: minmax(0, 2fr) 100px auto; gap: 6px; align-items: center; }
  .or-line select, .or-line input { height: 34px; padding: 0 8px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; min-width: 0; }
  .or-qrow { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); font-size: 0.8rem; }
  .or-qrow > span { flex: 1 1 200px; }
  .or-qrow label { display: flex; flex-direction: column; gap: 2px; font-size: 0.66rem; font-weight: 600; color: var(--text-muted); }
  .or-qrow input { width: 96px; height: 32px; padding: 0 8px; border: 1px solid var(--border); border-radius: 8px; background: var(--panel-bg); color: var(--text-primary); font-family: inherit; font-size: 0.8rem; }
  .or-error { margin: 8px 0 0; font-size: 0.8rem; color: #ef334e; }
  .or-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
  /* ---------- Orders (mockup layout) ---------- */
  .pd-kpi-icon.is-red { background: rgba(239, 51, 78, 0.12); color: #ef334e; }
  .or-page .pd-kpi.is-danger strong { color: #d97706; }
  .or-page .or-scope { margin: 2px 0 0; }
  .or-page .or-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 900px) { .or-page .or-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .or-search { display: flex; align-items: center; gap: 8px; flex: 1 1 220px; min-width: 0; height: 36px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text-muted); }
  .or-filters .or-search input[type='search'] { flex: 1; min-width: 0; height: auto; padding: 0; border: none; outline: none; background: transparent; font-size: 0.84rem; }
  .or-filters select { height: 36px; border-radius: 10px; }
  .or-table-wrap { border: 1px solid var(--border); border-radius: 12px; position: relative; }
  .or-card .or-table th { background: var(--surface); }
  .or-table td { vertical-align: middle; }
  .or-table tr:last-child td { border-bottom: none; }
  .or-th-act, .or-act { text-align: center !important; }
  .or-who { display: inline-flex; align-items: center; gap: 8px; }
  .or-who-lg { display: flex; padding: 8px 0; }
  .or-who-lg strong { display: block; font-size: 0.9rem; }
  .or-ava { display: grid; place-items: center; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 0.66rem; font-weight: 700; }
  .or-who-lg .or-ava { width: 40px; height: 40px; font-size: 0.8rem; }
