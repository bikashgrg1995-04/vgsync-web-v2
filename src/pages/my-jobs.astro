---
import AppLayout from '../layouts/AppLayout.astro';
import { getNavItemsForRole, BOTTOM_NAV } from '../lib/navigation';
import { PAGE_META } from '../lib/page-meta';
import type { UserRole } from '../lib/auth';
import '../styles/widgets/purchase-shared.css';
import '../styles/widgets/purchase-page.css';

const meta = PAGE_META['my-jobs'];
const defaultRole: UserRole = 'owner';
const navItems = getNavItemsForRole(defaultRole);
---

<AppLayout
  title={`VGSync | ${meta.title}`}
  pageTitle={meta.title}
  breadcrumb={meta.breadcrumb}
  activeId={meta.id}
  navItems={navItems}
  bottomItems={BOTTOM_NAV}
  displayName="User"
  roleLabel="Role"
  branchName="Branch"
  showBranchSwitcher={true}
>
  <div class="pu-page pd-page">
    <header class="pd-hero">
      <div class="pd-hero-text">
        <div>
          <h2 class="pd-hero-title">My jobs</h2>
          <p class="pd-hero-sub">Workshop jobs given to you. Start a job, then mark it done with a note on how the bike runs.</p>
        </div>
      </div>
      <div class="pd-hero-actions">
        <button type="button" class="btn-ghost-sm" id="mj-refresh">Refresh</button>
      </div>
    </header>

    <p class="pu-error" id="mj-error" role="alert" hidden></p>
    <p class="pu-empty" id="mj-none" hidden>No job is given to you right now.</p>
    <div id="mj-list" style="display:grid;gap:14px"></div>

    <dialog class="pu-dialog" id="mj-dlg" style="padding:18px;max-width:420px;width:92vw">
      <form method="dialog" id="mj-form" style="display:grid;gap:10px">
        <strong id="mj-dlg-title">Ask for a part</strong>
        <label id="mj-part-wrap" style="display:grid;gap:4px"><span>Part</span><select id="mj-part"></select></label>
        <label id="mj-work-wrap" style="display:grid;gap:4px" hidden><span>What work was done</span><input id="mj-work" maxlength="200" /></label>
        <label style="display:grid;gap:4px"><span>Quantity</span><input id="mj-qty" type="number" min="0.001" step="any" value="1" /></label>
        <label style="display:grid;gap:4px"><span>Note (optional)</span><input id="mj-note" maxlength="300" /></label>
        <p class="pu-error" id="mj-dlg-error" role="alert" hidden></p>
        <div style="display:flex;gap:8px;justify-content:flex-end">
          <button type="button" class="btn-ghost-sm" id="mj-cancel">Cancel</button>
          <button type="submit" class="btn-primary-sm">Send to office</button>
        </div>
      </form>
    </dialog>
  </div>
</AppLayout>

<script>
  import '../scripts/pages/my-jobs.ts';
</script>
