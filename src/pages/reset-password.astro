---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import LoginShowcase from '../components/login/LoginShowcase.astro';
import AuthFormShell from '../components/login/AuthFormShell.astro';

import '../styles/login/login.css';
---

<Layout title="Reset password | VG Automobiles">
    <main class="login-page">
        <ThemeToggle />

        <div class="login-shell">
            <LoginShowcase />

            <AuthFormShell heading="Choose a new password" subtitle="Use the link from your email. It works once.">
                <form class="login-form" id="reset-form" aria-describedby="auth-description" novalidate>
                    <div class="form-group">
                        <label class="form-label visually-hidden" for="new-password">New password</label>
                        <div class="input-wrapper">
                            <input
                                class="form-input password-input"
                                type="password"
                                id="new-password"
                                name="new_password"
                                placeholder="New password"
                                autocomplete="new-password"
                                required
                            />
                            <button
                                class="password-toggle"
                                type="button"
                                data-toggle-password="new-password"
                                aria-label="Show password"
                                aria-pressed="false"
                            >
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label visually-hidden" for="confirm-password">Confirm new password</label>
                        <div class="input-wrapper">
                            <input
                                class="form-input"
                                type="password"
                                id="confirm-password"
                                name="confirm_password"
                                placeholder="Confirm new password"
                                autocomplete="new-password"
                                required
                            />
                        </div>
                    </div>

                    <div class="form-message" id="form-message" role="status" aria-live="polite" aria-atomic="true"></div>

                    <button class="login-button" type="submit" id="reset-submit">
                        <span>Reset password</span>
                    </button>
                </form>
            </AuthFormShell>
        </div>
    </main>
</Layout>

<script>
    import { resetPassword, ApiError } from '../lib/auth';
    import { showMessage, clearMessage, setBusy } from '../scripts/auth-common';

    const form = document.getElementById('reset-form') as HTMLFormElement;
    const button = document.getElementById('reset-submit') as HTMLButtonElement;
    const next = document.getElementById('new-password') as HTMLInputElement;
    const confirm = document.getElementById('confirm-password') as HTMLInputElement;

    const params = new URLSearchParams(window.location.search);
    const uid = params.get('uid') ?? '';
    const token = params.get('token') ?? '';

    // Keep the one-time token out of the address bar, history and referrers.
    window.history.replaceState(null, '', window.location.pathname);

    if (!uid || !token) {
        showMessage('This reset link is incomplete. Request a new one from the sign-in page.', 'error');
        button.disabled = true;
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearMessage();

        if (next.value !== confirm.value) {
            showMessage('Passwords do not match.', 'error');
            return;
        }
        if (!next.value) {
            showMessage('Please enter a new password.', 'error');
            return;
        }

        setBusy(button, true, 'Saving…', 'Reset password');
        try {
            await resetPassword({ uid, token, newPassword: next.value, confirmPassword: confirm.value });
            window.location.replace('/?notice=password-reset');
        } catch (error) {
            showMessage(error instanceof ApiError ? error.message : 'Something went wrong. Please try again.', 'error');
            setBusy(button, false, '', 'Reset password');
        }
    });

    form.querySelectorAll('input').forEach((input) => input.addEventListener('input', clearMessage));
</script>

<script>
    import '../scripts/auth-common';
</script>
