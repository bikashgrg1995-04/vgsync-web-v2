# Base URL of the VGSync API (must be allowed by CORS_ALLOWED_ORIGINS on the backend).
PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional: link to a live chat (WhatsApp, Messenger, a chat widget page...).
# The Live Chat card on the Help & Support page is hidden while this is empty.
PUBLIC_LIVE_CHAT_URL=
